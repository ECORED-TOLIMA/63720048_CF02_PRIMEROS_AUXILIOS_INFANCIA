ne","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":741.03515625,"ty":5451}}},"id":"8747a88c-e3cb-454a-b73f-0bb310328964","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-945,"ty":-6249},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":672},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":89,"x":0}],[{"y":39,"from":89,"to":179,"x":0}],[{"y":63,"from":179,"to":268,"x":0}],[{"y":87,"from":268,"to":344,"x":0}]]}],"rawText":"La movilización y el traslado comprenden las acciones utilizadas para desplazar de forma segura a una persona lesionada. En la primera infancia, estas intervenciones requieren de especial cuidado, debido a que un movimiento inadecuado puede agravar la lesión, afectar otras zonas del cuerpo o generar complicaciones durante la atención inicial."}},{"type":"shape","name":"Trazado 608977","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":288.9189453125,"ty":6080}}},"id":"db6f5a24-9fb9-4c75-849e-ddc2956c4d75","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1397.1162109375,"ty":-5620},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 1020.0810546875 0 L 1020.0810546875 100 L 0 100 L 0 0 Z"}},{"type":"shape","name":"Rectángulo 401461","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.2080078125,"ty":6080}}},"id":"b52a1bc2-e1f1-444d-9a6c-f3e8f36e62bc","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1396.827