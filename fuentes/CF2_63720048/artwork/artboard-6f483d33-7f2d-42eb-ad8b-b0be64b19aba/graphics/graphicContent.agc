},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1050.6298828125,"ty":1028.0498046875}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":18},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":35,"x":-141.88604736328125}],[{"y":41,"from":35,"to":46,"x":-45.23378372192383}]]}],"rawText":"Torceduras durante las actividades recreativas"}},{"type":"text","name":"Far far away, behind","id":"09bbddfd-b859-40e2-9b3a-e78ae1ee22da","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1458.4052734375,"ty":-10615.3388671875},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":227.6298828125,"ty":1084.6611328125}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":45,"x":0}],[{"y":39,"from":45,"to":87,"x":0}],[{"y":63,"from":87,"to":130,"x":0}],[{"y":87,"from":130,"to":139,"x":0}]]}],"rawText":"Pueden ocurrir en el parque o en el patio de un hogar comunitario y ocasionar heridas, golpes o lesiones que requieren valoración inicial. "}},{"type":"text","name":"Far far away, behind","id":"7a8ef043-c22f-4dc5-b52c-e97ec8ae4855","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1046.4052734375,"ty":-10615.3388671875},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":639.6298828125,"ty":1084.6611328125}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":41,"x":0}],[{"y":39,"from":41,"to":81,"x":0}],[{"y":63,"from":81,"to":125,"x":0}]]}],"rawText":"Puede producir quemaduras en la cocina u otros espacios del hogar y requiere una actuación inmediata para disminuir el daño. "}},{"type":"text","name":"Far far away, behind","id":"bc7f0769-f894-4df1-9f20-e3d2e65d66d6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-635.4052734375,"ty":-10605.3388671875},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1050.6298828125,"ty":1094.6611328125}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":46,"x":0}],[{"y":39,"from":46,"to":87,"x":0}],[{"y":63,"from":87,"to":131,"x":0}]]}],"rawText":"Pueden afectar las articulaciones y exigir la inmovilización de la zona lesionada y un traslado seguro para evitar complicaciones. "}},{"type":"shape","name":"Rectángulo 456482","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601,"ty":2674}}},"id":"67d17ac9-6462-4cae-9b02-718f376a3b9d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1085.03515625,"ty":-9026},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":160,"r":[10,10,10,10]}},{"type":"text","name":"La intervención del primer respondiente debe centrarse en la identificación de signos de gravedad, la limitación del movimiento, la protección de la zona afectada y la preparación para un traslado seguro, evitando maniobras que puedan generar daño adiciona","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":743,"ty":2697}}},"id":"8e3f692c-664a-4e33-bbfb-00c631c04646","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-943.03515625,"ty":-9003},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":645},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":89,"x":0}],[{"y":39,"from":89,"to":180,"x":0}],[{"y":63,"from":180,"to":262,"x":0}],[{"y":87,"from":262,"to":348,"x":0}],[{"y":111,"from":348,"to":364,"x":0}]]}],"rawText":"La intervención del primer respondiente debe centrarse en la identificación de signos de gravedad, la limitación del movimiento, la protección de la zona afectada y la preparación para un traslado seguro, evitando maniobras que puedan generar daño adicional. La actuación oportuna permite disminuir complicaciones y favorecer la recuperación de la niña o del niño."}},{"type":"text","name":"La aplicación adecuada de estas recomendaciones ayuda a prevenir complicaciones y protege a la niña o al niño mientras recibe atención especializada. No se deben enderezar extremidades, recolocar articulaciones ni efectuar traslados innecesarios.\n\nDespués ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289,"ty":3930}}},"id":"6699f010-26f7-4cc6-9f0f-cc0486f36207","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1397.03515625,"ty":-7770},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1019.6298828125},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":135,"x":0}],[{"y":39,"from":135,"to":246,"x":0}]]},{"lines":[[{"y":63,"from":247,"to":247,"x":0}]]},{"lines":[[{"y":87,"from":248,"to":384,"x":0}],[{"y":111,"from":384,"to":501,"x":0}]]}],"rawText":"La aplicación adecuada de estas recomendaciones ayuda a prevenir complicaciones y protege a la niña o al niño mientras recibe atención especializada. No se deben enderezar extremidades, recolocar articulaciones ni efectuar traslados innecesarios.\n\nDespués de reconocer el manejo inicial de las lesiones osteomusculares, es necesario comprender cómo actuar ante otros traumatismos que pueden comprometer diferentes partes del cuerpo. En el siguiente apartado, se presentan las medidas correspondientes."}},{"type":"text","name":"El reconocimiento de estos traumatismos permite identificar oportunamente los signos de alarma y aplicar medidas iniciales que reduzcan el riesgo de agravar la lesión. Sin embargo, cuando sea indispensable desplazar a la niña o al niño, se deben emplear té","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":184.6298828125,"ty":5117}}},"id":"c12f2340-5091-4c99-9517-8abe1d5b22c6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1501.4052734375,"ty":-6583},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228.3701171875},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":172,"x":0}],[{"y":39,"from":172,"to":340,"x":0}],[{"y":63,"from":340,"to":378,"x":0}]]}],"rawText":"El reconocimiento de estos traumatismos permite identificar oportunamente los signos de alarma y aplicar medidas iniciales que reduzcan el riesgo de agravar la lesión. Sin embargo, cuando sea indispensable desplazar a la niña o al niño, se deben emplear técnicas seguras que protejan las zonas afectadas y mantengan la estabilidad corporal durante la movilización y el traslado."}},{"type":"shape","name":"Trazado 1003455","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":288.7109375,"ty":4779}}},"id":"9af74225-56aa-47a7-8e58-888d8a1eb3fa","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1397.32421875,"ty":-6921},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 1020.2890625 0 L 1020.2890625 150 L 0 150 L 0 0 Z"}},{"type":"shape","name":"Trazado 1008639","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":288.7109375,"ty":5717}}},"id":"a02a0839-3074-4b19-8e01-edcec84cfd28","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1397.32421875,"ty":-5983},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"