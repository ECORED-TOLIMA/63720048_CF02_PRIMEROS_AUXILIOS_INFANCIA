 no intentar corregir deformidades. \n\nInmovilizar l","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":19,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":668,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":336.32421875,"ty":3603}}},"id":"ffbba38f-d61c-4b5e-adc9-3849bd294cd8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1349.7109375,"ty":-8097},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":939},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":19,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":19,"to":116}]]},{"lines":[[{"y":39,"from":117,"to":117,"x":0}]]},{"lines":[[{"y":63,"from":118,"to":241,"x":0}]]},{"lines":[[{"y":87,"from":242,"to":242,"x":0}]]},{"lines":[[{"y":111,"from":243,"to":370,"x":0}],[{"y":135,"from":370,"to":383,"x":0}]]},{"lines":[[{"y":159,"from":384,"to":384,"x":0}]]},{"lines":[[{"y":183,"from":385,"to":515,"x":0}],[{"y":207,"from":515,"to":555,"x":0}]]},{"lines":[[{"y":231,"from":556,"to":556,"x":0}]]},{"lines":[[{"y":255,"from":557,"to":687,"x":0}]]}],"rawText":"Conservar la calma: brindar seguridad a la niña o al niño y explicarle, con palabras sencillas, que recibirá ayuda. \n\nEvitar movimientos innecesarios: mantener la zona lesionada en la posición encontrada y no intentar corregir deformidades. \n\nInmovilizar la lesión: utilizar elementos adecuados para limitar el movimiento, sin ejercer una presión excesiva ni afectar la circulación. \n\nObservar las señales de alarma: identificar dolor intenso, deformidad, pérdida de conciencia, vómito persistente, dificultad para respirar o alteraciones del movimiento. \n\nSolicitar atención especializada: activar el sistema de emergencias mediante la línea 123 cuando se presenten signos de gravedad. "}},{"type":"group","name":"Grupo 1184217","meta":{"ux":{"nameL10N":"SHAPE_GROUP","aspectLock":{"width":84,"height":84},"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":-74.74609375,"ty":-3588}}},"id":"5cacf897-76ba-4c9a-9db3-00b4016b9ab4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1760.78125,"ty":-15288},"group":{"children":[{"type":"shape","name":"Elipse 13609","meta":{"ux":{"nameL10N":"SHAPE_ELLIPSE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"49e2941a-3f36-4097-95cf-f112097dc49e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":383.74609375,"ty":8400},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":194,"b":250}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"cx":42,"cy":42,"type":"circle","r":42}},{"type":"group","name":"Grupo 1185149","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"dad18a8b-556b-4ac8-8fbc-1dd90cb98c74","transform":{"a":1,"b":0,"c":0,"d":1,"tx":395.74609375,"ty":8412},"group":{"children":[{"type":"shape","name":"Trazado 1011094","meta":{"ux":{"nameL10N":"SHAPE_PATH"}},"id":"05d622e7-a930-41e3-8341-1375b18f8ae4","style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":88,"g":78,"b":100}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 33.04380035400391 25.