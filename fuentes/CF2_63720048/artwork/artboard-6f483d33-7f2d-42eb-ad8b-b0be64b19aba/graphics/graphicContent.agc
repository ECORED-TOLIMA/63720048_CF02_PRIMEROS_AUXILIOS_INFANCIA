"ty":1654}}},"id":"c68597c8-b921-4516-bb4f-1098c2b3e1ad","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1396,"ty":-10046},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":190,"r":[20,20,20,20]}},{"type":"shape","name":"Rectángulo 457129","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290.03515625,"ty":8257}}},"id":"4a397099-9f02-4bc1-b925-a243f8426b58","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1396,"ty":-3443},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":190,"r":[20,20,20,20]}},{"type":"text","name":"Son lesiones que afectan la piel o los tejidos y pueden producir cortes, raspaduras, dolor o sangrado. Por ejemplo, una niña puede rasparse la rodilla al caer en el parque. Se debe limpiar la zona con agua, cubrirla con una gasa o material limpio y evitar ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":314.03515625,"ty":1744}}},"id":"413c2b8f-e9a1-4e16-8cf8-3dd1f63978e7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1372,"ty":-9956},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":969},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":131,"x":0}],[{"y":39,"from":131,"to":259,"x":0}],[{"y":63,"from":259,"to":386,"x":0}]]}],"rawText":"Son lesiones que afectan la piel o los tejidos y pueden producir cortes, raspaduras, dolor o sangrado. Por ejemplo, una niña puede rasparse la rodilla al caer en el parque. Se debe limpiar la zona con agua, cubrirla con una gasa o material limpio y evitar su manipulación. Si la herida es profunda, contiene un objeto incrustado o continúa sangrando, se debe solicitar atención médica. "}},{"type":"text","name":"Se emplea cuando existe una amenaza inmediata que impide permanecer en el lugar. Por ejemplo, si durante una inundación el agua comienza a ingresar rápidamente a la vivienda, la niña o el niño debe ser llevado a una zona segura. El desplazamiento se realiz","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":314.03515625,"ty":8347}}},"id":"38ceb549-4770-4b40-b243-36f9621f1650","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1372,"ty":-3353},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":969},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":128,"x":0}],[{"y":39,"from":128,"to":258,"x":0}],[{"y":63,"from":258,"to":343,"x":0}]]}],"rawText":"Se emplea cuando existe una amenaza inmediata que impide permanecer en el lugar. Por ejemplo, si durante una inundación el agua comienza a ingresar rápidamente a la vivienda, la niña o el niño debe ser llevado a una zona segura. El desplazamiento se realiza solamente hasta eliminar la exposición al peligro y facilitar la atención requerida. "}},{"type":"text","name":"What do you mean by","id":"cbdf99b9-9eb9-4f9d-bf17-05259dba5291","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1368.74609375,"ty":-9993.2109375},"meta":{"ux":{"hasCustomName":true,"customConstraints":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":40,"linkId":"","fontFamily":"Roboto","fontStyle":"Black","postscriptName":"Roboto-Black","fontSize":20,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":317.2890625,"ty":1706.7890625}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Black","family":"Roboto","style":"Black","size":20},"textAttributes":{"lineHeight":27}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":7,"x":0}]]}],"rawText":"Heridas"}},{"type":"text","name":"What do you mean by","id":"b1a16bd7-a88f-42b5-bbfe-78cc23a13c05","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1368.74609375,"ty":-3390.2109375},"meta":{"ux":{"hasCustomName":true,"customConstraints":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":40,"linkId":"","fontFamily":"Roboto","fontStyle":"Black","postscriptName":"Roboto-Black","fontSize":20,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":317.2890625,"ty":8309.7890625}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63