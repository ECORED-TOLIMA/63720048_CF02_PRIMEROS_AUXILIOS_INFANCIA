e,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":494,"ty":6422}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}}},"shape":{"type":"rect","x":0,"y":0,"width":919,"height":257.111328125}},{"type":"group","name":"Enmascarar grupo 1119279","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"BG","id":"986a4ed2-94c7-4209-a4d3-105f5126267f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":-9.094947017729282e-13},"meta":{"ux":{"hasCustomName":true}},"style":{"opacity":0.9490196108818054,"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":232,"g":232,"b":232}}}},"shape":{"type":"rect","x":0,"y":0,"width":613.9999389648438,"height":257.11083984375}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":6422}}},"id":"49b09b38-85c2-4ea5-b8d6-20e019d31871","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1501.03515625,"ty":-5278},"group":{"children":[{"type":"shape","name":"Imagen 129","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":993,"height":786}}},"id":"2c3557e1-53b7-429b-bce1-9def52da9b21","transform":{"a":1,"b":0,"c":0,"d":1,"tx":0.03515625,"ty":-32},"style":{"fill":{"type":"pattern","pattern":{"width":993,"height":786,"meta":{"ux":{"scaleBehavior":"fill","uid":"9768fc1a6071393a9975544ea0b0b68a","hrefLastModifiedDate":1785502400}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":615,"height":487}}]}},{"type":"group","name":"Right","id":"9fee3582-d240-4e6d-a22a-bf0c7dae8f05","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1002,"ty":-5233},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":684.03515625,"ty":6467}}},"group":{"children":[{"type":"shape","name":"BG","id":"69c10661-df9b-4bf0-b15e-7a8e45691ec1","meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"style":{"opacity":0.9490196108818054,"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}}}},"shape":{"type":"rect","x":0,"y":0,"width":684.900390625,"height":167.712890625}}]}},{"type":"text","name":"La movilización segura se fundamenta en principios orientados a proteger a la niña o al niño lesionado durante un desplazamiento indispensable. Su aplicación permite reducir el riesgo de agravar las lesiones, especialmente cuando existe una posible afectac","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":726.03515625,"ty":6504}}},"id":"d9fd8cd6-3b43-4207-8e5a-8afe0a687506","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-960,"ty":-5196},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"area","width":600,"height":93.69921875},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":83,"x":0}],[{"y":39,"from":83,"to":166,"x":0}],[{"y":63,"from":166,"to":249,"x":0}],[{"y":87,"from":249,"to":325,"x":0}]]}],"rawText":"La movilización segura se fundamenta en principios orientados a proteger a la niña o al niño lesionado durante un desplazamiento indispensable. Su aplicación permite reducir el riesgo de agravar las lesiones, especialmente cuando existe una posible afectación en la cabeza, el cuello, la columna vertebral o las extremidades."}},{"type":"text","name":"Antes de iniciar cualquier movimiento, se deben valorar las condiciones del entorno, el estado general de la persona lesionada y la necesidad real de trasladarla. Asimismo, es fundamental actuar con calma, solicitar apoyo cuando sea necesario y mantener un","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":6710}}},"id":"a15ce6b1-55df-40ba-ba05-1bd522bcff73","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1501.03515625,"ty":-4990},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":173,"x":0}],[{"y":39,"from":173,"to":336,"x":0}],[{"y":63,"from":336,"to":373,"x":0}]]}],"rawText":"Antes de iniciar cualquier movimiento, se deben valorar las condiciones del entorno, el estado general de la persona lesionada y la necesidad real de trasladarla. Asimismo, es fundamental actuar con calma, solicitar apoyo cuando sea necesario y mantener una comunicación clara entre quienes participan. Para orientar esta actuación, se consideran los siguientes principios:"}},{"type":"text","name":"La movilización debe responder a una necesidad concreta de protección o atención. Para tomar una decisión adecuada, se deben diferenciar las situaciones que exigen retirar inmediatamente a la niña o al niño de aquellas que permiten preparar el desplazamien","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":7917}}},"id":"3a47a4d4-5c23-4dbb-9034-5f3085c419e9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1501.03515625,"ty":-3783},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":106,"x":0}],[{"y":39,"from":106,"to":219,"x":0}],[{"y":63,"from":219,"to":316,"x":0}]]}],"rawText":"La movilización debe responder a una necesidad concreta de protección o atención. Para tomar una decisión adecuada, se deben diferenciar las situaciones que exigen retirar inmediatamente a la niña o al niño de aquellas que permiten preparar el desplazamiento con mayor precaución y disponer de los apoyos necesarios."}},{"type":"text","name":"Cada tipo de movilización presenta características particulares relacionadas con la urgencia y los recursos disponibles. Esta clasificación facilita la identificación de la alternativa más apropiada para cada situación:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":8184}}},"id":"2477dceb-71e3-4f68-a85c-445148695aa6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1501.03515625,"ty":-3516},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":108,"x":0}],[{"y":39,"from":108,"to":219,"x":0}]]}],"rawText":"Cada tipo de movilización presenta características particulares relacionadas con la urgencia y los recursos disponibles. Esta clasificación facilita la identificación de la alternativa más apropiada para cada situación:"}},{"type":"text","name":"La clasificación presentada permite comprender que no todos los desplazamientos responden a las mismas circunstancias. Una vez identificado el tipo de movilización requerido, se seleccionan las técnicas de traslado acordes con el estado de la persona lesio","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":491,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185,"ty":8687}}},"id":"77639e74-1e4b-4bbb-8bee-537f02bc7917","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1501.03515625,"ty":-3013},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":164,"x":0}],[{"y":39,"from":164,"to":298,"x":0}]]}],"rawText":"La clasificación presentada permite comprender que no todos los desplazamientos responden a las mismas circunstancias. Una vez identificado el tipo de movilización requerido, se seleccionan las técnicas de traslado acordes con el estado de la persona lesionada, el lugar y los recursos disponibles."}},{"type":"group","name":"Enmascarar grupo 1119230","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 456177","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","rotation":180}},"id":"7c2010b5-955f-428a-812d-7936af03acba","transform":{"a":-1,"b":0,"c":0,"d":-1,"tx":-17645,"ty":-13695},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":163,"g":221,"b":242}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1328,"height":561}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":19109.03515625,"ty":21063}}},"id":"63e869dc-b366-4b1c-934c-2151b8863727","transform":{"a":1,"b":0,"c":0,"d":1,"tx":17423,"ty":9363},"group":{"children":[{"type":"shape","name":"Rectángulo 456113","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","rotation":180}},"id":"5fde2939-bfac-4f94-a666-dd3459375daa","transform":{"a":-1,"b":0,"c":0,"d":-1,"tx":-17645,"ty":-13509},"style":{"fill":{"type":"gradient","gradient":{"meta":{"ux":{"gradientResources":{"type":"linear","stops":[{"offset":0,"color":{"mode":"RGB","value":{"r":227,"g":215,"b":255}}},{"offset":0.4569556415081024,"color":{"mode":"RGB","value":{"r":151,"g":203,"b":255}}},{"offset":1,"color":{"mode":"RGB","value":{"r":151,"g":203,"b":255}}}]}}},"x1":0.47519177198410034,"y1":0.9499787092208862,"x2":-0.04006112366914749,"y2":0,"units":"objectBoundingBox"}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":163,"g":2