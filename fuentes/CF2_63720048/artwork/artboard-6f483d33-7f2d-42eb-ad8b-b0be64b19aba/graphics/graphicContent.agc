straintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.03515625,"ty":5596}}},"id":"88d5cb5b-1aef-4178-a3a3-67dc57aff07b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1085,"ty":-6104},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":120,"x":0}],[{"y":39,"from":120,"to":225,"x":0}],[{"y":63,"from":225,"to":334,"x":0}],[{"y":87,"from":334,"to":407,"x":0}]]}],"rawText":"Antes de movilizar a la niña o al niño, se debe valorar la seguridad del entorno, el tipo de lesión y la necesidad real del desplazamiento. Cuando el lugar no representa un peligro, se recomienda mantener a la persona en una posición estable, evitar movimientos innecesarios y esperar la llegada del personal especializado. Según las condiciones identificadas, pueden presentarse las siguientes situaciones:"}},{"type":"text","name":"La identificación adecuada de cada situación permite evitar desplazamientos innecesarios y seleccionar una actuación acorde con el riesgo presente. En los hogares colombianos, mantener despejadas las rutas de salida, conservar la calma y solicitar apoyo es","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.03515625,"ty":6007}}},"id":"f1fff5df-92cc-40f4-851e-2a46ae5a3eb0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1501,"ty":-5693},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":163,"x":0}],[{"y":39,"from":163,"to":333,"x":0}]]}],"rawText":"La identificación adecuada de cada situación permite evitar desplazamientos innecesarios y seleccionar una actuación acorde con el riesgo presente. En los hogares colombianos, mantener despejadas las rutas de salida, conservar la calma y solicitar apoyo especializado contribuye a proteger a la niña o al niño durante una emergencia."}},{"type":"group","name":"Grupo 1184220","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":9.32421875,"ty":5018}}},"id":"7c7ae8e9-3dc9-4c63-a33f-5779ef9d3d18","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-1676.7109375,"ty":-6682},"group":{"children":[{"type":"shape","name":"Rectángulo 456463","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true}},"id":"bf73118f-1e05-49a3-8740-72cd43134acf","transform":{"a":1,"b":0,"c":0,"d":1,"tx":621.7109375,"ty":436},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84,"r":[10,10,10,10]}},{"type":"group","name":"Grupo 1185155","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"2afb5e06-5