nt":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":1361,"from":1117,"to":1162,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":1385,"from":1162,"to":1173,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":1409,"from":1174,"to":1174,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":1433,"from":1175,"to":1175,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":1457,"from":1176,"to":1176,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":1481,"from":1177,"to":1177,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":1505,"from":1178,"to":1178,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":1529,"from":1179,"to":1179,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":1553,"from":1180,"to":1180,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":1577,"from":1181,"to":1211,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":1601,"from":1212,"to":1253,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":1625,"from":1253,"to":1296,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":1649,"from":1296,"to":1335,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":1673,"from":1335,"to":1375,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":1697,"from":1375,"to":1384,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Enfermedades respiratorias\nSon una de las principales causas de consulta y hospitalización en la primera infancia; incluyen resfriado común, bronquiolitis y neumonía, causa importante de mortalidad infantil mundial.\n\n\n\n\n\n\n\nEnfermedades gastrointestinales\nLas enfermedades diarreicas agudas son frecuentes en la infancia y se asocian a infecciones virales, bacterianas o parasitarias; su riesgo principal es la deshidratación por pérdida de líquidos y electrolitos.\n\n\n\n\n\n\n\nAlteraciones nutricionales\nLa desnutrición y la anemia constituyen un problema de salud pública en la primera infancia; la desnutrición afecta el crecimiento y el desarrollo cognitivo, y la anemia afecta el aprendizaje.\n\n\n\n\n\n\n\nEnfermedades parasitarias\nLas parasitosis intestinales son frecuentes donde existen deficiencias en saneamiento básico e higiene; generan síntomas como dolor abdominal, diarrea, pérdida de peso y alteraciones nutricionales en la infancia.\n\n\n\n\n\n\n\nEnfermedades dermatológicas\nLas afecciones de la piel en la primera infancia incluyen dermatitis e infecciones bacterianas o micóticas, asociadas a condiciones de higiene, humedad o irritación, frecuentes en jardines infantiles.\n\n\n\n\n\n\n\nEnfermedades inmunoprevenibles\nEnfermedades como sarampión, tosferina y varicela siguen representando un riesgo en poblaciones infantiles con esquemas de inmunización incompletos o atrasados en Colombia."}},{"type":"group","name":"Enmascarar grupo 1119310","meta":{"ux":{"nameL10N":"SHAPE_MASK","clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 457387","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"4c27885c-b687-495e-8ea1-4c1c883ef821","transform":{"a":1,"b":0,"c":0,"d":1,"tx":3109.601806640625,"ty":-7948.3837890625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}}},"stroke":{"type":"solid","color":{"mode":"RGB","value