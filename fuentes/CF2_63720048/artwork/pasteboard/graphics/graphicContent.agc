e","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 191.6094970703125 171.3433227539062 L 186.6916961669922 171.3433227539062 L 186.6916961669922 166.4256591796875 C 186.6916961669922 165.6279296875 186.0427551269531 164.97900390625 185.2451782226562 164.97900390625 L 178.6329345703125 164.97900390625 C 177.8353576660156 164.97900390625 177.1864318847656 165.6279296875 177.1864318847656 166.4256591796875 L 177.1864318847656 171.3433227539062 L 172.2686309814453 171.3433227539062 C 171.4709167480469 171.3433227539062 170.8219757080078 171.9922485351562 170.8219757080078 172.7899627685547 L 170.8219757080078 179.4020690917969 C 170.8219757080078 180.1997833251953 171.4709167480469 180.8487243652344 172.2686309814453 180.8487243652344 L 177.1864318847656 180.8487243652344 L 177.1864318847656 185.7663879394531 C 177.1864318847656 186.5641021728516 177.8353576660156 187.2130432128906 178.6329345703125 187.2130432128906 L 185.2451782226562 187.2130432128906 C 186.0427551269531 187.2130432128906 186.6916961669922 186.5641021728516 186.6916961669922 185.7663879394531 L 186.6916961669922 180.8487243652344 L 191.6094970703125 180.8487243652344 C 192.4070739746094 180.8487243652344 193.0561370849609 180.1997833251953 193.0561370849609 179.4020690917969 L 193.0561370849609 172.7899627685547 C 193.0559997558594 171.9921264648438 192.4070739746094 171.3433227539062 191.6094970703125 171.3433227539062 Z M 191.03271484375 178.8253021240234 L 186.1149291992188 178.8253021240234 C 185.3173370361328 178.8253021240234 184.6682739257812 179.474365234375 184.6682739257812 180.2719421386719 L 184.6682739257812 185.1896209716797 L 179.209716796875 185.1896209716797 L 179.209716796875 180.2719421386719 C 179.209716796875 179.474365234375 178.5607757568359 178.8253021240234 177.7630615234375 178.8253021240234 L 172.8452606201172 178.8253021240234 L 172.8452606201172 173.3666076660156 L 177.7630615234375 173.3666076660156 C 178.5607757568359 173.3666076660156 179.209716796875 172.717529296875 179.209716796875 171.9199523925781 L 179.209716796875 167.0022888183594 L 184.6682739257812 167.0022888183594 L 184.6682739257812 171.9199523925781 C 184.6682739257812 172.717529296875 185.3173370361328 173.3666076660156 186.1149291992188 173.3666076660156 L 191.03271484375 173.3666076660156 L 191.03271484375 178.8253021240234 Z"}}]}}]}}]}},{"type":"text","name":"•\tRespiratorias: comprenden dificultad para respirar, respiración rápida, lenta o ausente, ruidos anormales y coloración azulada. Estas manifestaciones pueden indicar una alteración de la oxigenación. Por ejemplo, si un alimento obstruye la vía aérea, se d","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":0,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":131,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"94dca7c2-b84f-4771-9a07-810024109774","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-8867.7109375,"ty":-2522.93359375},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":484},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":54,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":54,"to":121,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":121,"to":188,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":188,"to":255,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":255,"to":321,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":321,"to":372,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":161,"from":373,"to":373,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":185,"from":374,"to":436,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":209,"from":436,"to":505,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":233,"from":505,"to":571,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":257,"from":571,"to":634,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":281,"from":634,"to":700,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":305,"from":700,"to":709,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":329,"from":710,"to":710,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":353,"from":711,"to":765,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":377,"from":765,"to":826,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":401,"from":826,"to":893,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":425,"from":893,"to":960,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":449,"from":960,"to":1029,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":473,"from":1029,"to":1057,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"•\tRespiratorias: comprenden dificultad para respirar, respiración rápida, lenta o ausente, ruidos anormales y coloración azulada. Estas manifestaciones pueden indicar una alteración de la oxigenación. Por ejemplo, si un alimento obstruye la vía aérea, se debe aplicar de inmediato la técnica correspondiente para atender la obstrucción de la vía aérea por cuerpo extraño. \n\n•\tTegumentarias: incluyen heridas, quemaduras, irritaciones y cambios en la coloración o la temperatura de la piel. Estas lesiones pueden afectar la protección del organismo. Por ejemplo, ante una quemadura extensa, se debe enfriar la zona con agua corriente, cubrirla con material limpio y evitar la aplicación de sustancias caseras. \n\n•\tMusculoesqueléticas: se manifiestan mediante dolor, inflamación, deformidad o limitación del movimiento y pueden afectar el soporte corporal. Por ejemplo, después de una caída que ocasione una posible fractura, se debe inmovilizar la zona, evitar movimientos innecesarios y realizar un traslado seguro, sin intentar acomodar el hueso afectado. "}},{"type":"text","name":"•\tRitmo respiratorio: indica si las respiraciones se producen de manera regular o irregular. Se debe observar si los intervalos entre cada respiración son semejantes o si se presentan pausas, cambios repentinos o movimientos desorganizados. \n\n•\tProfundidad","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"e48bd92e-e3f8-4abb-9f98-7c95b77804a8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6142,"ty":-9550},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"area","width":519,"height":494},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":65,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":65,"to":139,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":139,"to":211,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":211,"to":241,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":113,"from":242,"to":242,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":137,"from":243,"to":311,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":311,"to":378,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":185,"from":378,"to":448,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":209,"from":448,"to":508,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":233,"from":509,"to":509,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":257,"from":510,"to":565,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":281,"from":565,"to":631,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":305,"from":631,"to":700,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":329,"from":700,"to":736,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":353,"from":737,"to":737,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":377,"from":738,"to":797,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":401,"from":797,"to":863,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":425,"from":863,"to":935,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":449,"from":935,"to":1001,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":473,"from":1001,"to":1021,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"•\tRitmo respiratorio: indica si las respiraciones se producen de manera regular o irregular. Se debe observar si los intervalos entre cada respiración son semejantes o si se presentan pausas, cambios repentinos o movimientos desorganizados. \n\n•\tProfundidad respiratoria: permite identificar la cantidad de aire movilizada durante cada respiración. Puede reconocerse mediante la amplitud de los movimientos del tórax y el abdomen, los cuales pueden ser normales, superficiales o más profundos de lo habitual. \n\n•\tSonidos respiratorios: corresponden a los ruidos que acompañan la entrada y salida del aire. La presencia de silbidos, ronquidos, quejidos u otros sonidos inusuales puede relacionarse con una dificultad en el paso del aire. \n\n•\tEsfuerzo respiratorio: comprende las manifestaciones que evidencian dificultad para respirar. Entre ellas se encuentran el hundimiento de la piel entre las costillas, el movimiento exagerado del abdomen, la apertura de las fosas nasales y el uso marcado de los músculos del cuello."}},{"type":"text","name":"Alerta (Valoración oportuna)\n\n• Respiración rápida o irregular: cambio en la frecuencia o el ritmo respiratorio que requiere vigilancia. \n• Dolor intenso: molestia que causa llanto persistente, limita el movimiento o altera el comportamiento. \n• Fiebre per","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":574,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"dc1aaa07-1cfd-4c0b-9dd8-80baf4a40583","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6105,"ty":-5712},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":545},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":28,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":41,"from":29,"to":29,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":65,"from":30,"to":99,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":99,"to":137,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":113,"from":138,"to":217,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":217,"to":243,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":161,"from":244,"to":313,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":185,"from":313,"to":338,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":209,"from":339,"to":417,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":233,"from":417,"to":444,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":257,"from":445,"to":510,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":281,"from":510,"to":574,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"x":0,"y":305,"from":0,"to":0}]]}],"rawText":"Alerta (Valoración oportuna)\n\n• Respiración rápida o irregular: cambio en la frecuencia o el ritmo respiratorio que requiere vigilancia. \n• Dolor intenso: molestia que causa llanto persistente, limita el movimiento o altera el comportamiento. \n• Fiebre persistente: aumento de la temperatura que se mantiene o se acompaña de decaimiento. \n• Debilidad o decaimiento: disminución evidente de la energía, la actividad o la capacidad de respuesta. \n• Cambios importantes en el comportamiento: somnolencia inusual, irritabilidad intensa, confusión o dificultad para interactuar. \n"}},{"type":"text","name":"Grave (Atención inmediata)\n\n• Ausencia de respiración: falta de movimientos respiratorios y de entrada o salida de aire. \n• Dificultad respiratoria intensa: esfuerzo evidente para respirar, hundimiento del pecho, ruidos anormales o coloración azulada. \n• P","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":574,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"d11cf23c-6164-41da-aabf-a6749c50408b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-6105,"ty":-5337},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":545},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":26,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":41,"from":27,"to":27,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":65,"from":28,"to":105,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":105,"to":121,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":113,"from":122,"to":202,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":202,"to":252,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":161,"from":253,"to":332,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":185,"from":333,"to":403,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":209,"from":403,"to":430,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":233,"from":431,"to":499,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":257,"from":499,"to":516,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":281,"from":517,"to":593,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Grave (Atención inmediata)\n\n• Ausencia de respiración: falta de movimientos respiratorios y de entrada o salida de aire. \n• Dificultad respiratoria intensa: esfuerzo evidente para respirar, hundimiento del pecho, ruidos anormales o coloración azulada. \n• Pérdida de la conciencia: ausencia de respuesta ante la voz o los estímulos. \n• Convulsiones: movimientos involuntarios, rigidez corporal o pérdida repentina de la respuesta. \n• Sangrado abundante: pérdida de sangre que no se controla mediante presión directa. \n• Cianosis: coloración azulada o violácea en los labios, la piel o las uñas."}},{"type":"group","name":"Grupo 1184192","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true}},"id":"effc13a0-22e8-469d-b966-62a4da4e2351","transform":{"a":1,"b":0,"c":0,"d":1,"tx":18419,"ty":1618},"group":{"children":[{"type":"shape","name":"Rectángulo 454905","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"66e75019-ead7-4e11-985a-891fde5bce25","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-23947,"ty":-7331},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":584,"height":330}},{"type":"shape","name":"Rectángulo 454715","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"55b85d42-3f51-41b1-8e90-94cba29fbfc0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-23577,"ty":-7331},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":194,"b":250}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":214,"height":330}},{"type":"group","name":"Enmascarar grupo 1119137","meta":{"ux":{"nameL10N":"SHAPE_MAS