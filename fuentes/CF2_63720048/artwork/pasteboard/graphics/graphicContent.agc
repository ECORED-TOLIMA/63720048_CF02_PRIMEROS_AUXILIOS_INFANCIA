scriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":281,"from":669,"to":747,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":305,"from":747,"to":820,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":329,"from":820,"to":844,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"•\tHemorragias: corresponden a la pérdida de sangre ocasionada por la ruptura de uno o varios vasos sanguíneos. Por ejemplo, un niño puede presentar un sangrado abundante después de cortarse con un objeto afilado. Se debe ejercer presión directa sobre la herida con una gasa o tela limpia. Si existe un objeto incrustado, no debe retirarse; la presión se aplica alrededor de este. \n\n•\tQuemaduras: son lesiones causadas por el calor, las sustancias químicas, la electricidad o la radiación. Por ejemplo, un lactante puede quemarse al entrar en contacto con un líquido caliente. Se debe retirar la fuente que ocasionó la lesión y enfriar la zona con agua corriente fresca durante 20 minutos. No se deben aplicar hielo, cremas ni remedios caseros, ni romper las ampollas. Posteriormente, la zona se cubre suavemente con una gasa o material limpio. "}},{"type":"text","name":"Asegurar la alineación corporal: implica mantener la cabeza, el cuello y la columna en una posición estable durante el desplazamiento. Por ejemplo, si una niña cae de una cama y manifiesta dolor cervical, se deben evitar giros, flexiones o cambios de postu","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":32,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":294,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"6614f275-8ea4-4f29-8ce0-1ee890b427bd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-51,"ty":-4807},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":32,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}},{"y":17,"from":32,"to":76,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":76,"to":151,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":151,"to":228,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":228,"to":296,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":296,"to":326,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Asegurar la alineación corporal: implica mantener la cabeza, el cuello y la columna en una posición estable durante el desplazamiento. Por ejemplo, si una niña cae de una cama y manifiesta dolor cervical, se deben evitar giros, flexiones o cambios de postura que puedan aumentar el daño mientras llega la ayuda especializada. "}},{"type":"text","name":"Inmovilizar la zona lesionada: consiste en limitar el movimiento de la parte afectada antes de realizar un desplazamiento indispensable. Por ejemplo, si un niño se golpea el brazo al caer en el patio, puede sostenerse la extremidad con una prenda doblada, ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":31,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":286,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"a3c7d2ce-615c-4b93-8f05-38ed7c70a1c8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-51,"ty":-4447},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":31,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}},{"y":17,"from":31,"to":71,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":71,"to":141,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":141,"to":218,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":218,"to":292,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":292,"to":316,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Inmovilizar la zona lesionada: consiste en limitar el movimiento de la parte afectada antes de realizar un desplazamiento indispensable. Por ejemplo, si un niño se golpea el brazo al caer en el patio, puede sostenerse la extremidad con una prenda doblada, sin intentar enderezarla ni ejercer presión sobre la lesión."}},{"type":"text","name":"Realizar movimientos controlados: requiere desplazar a la persona lesionada de manera lenta, coordinada y sin movimientos bruscos. Por ejemplo, ante una fuga de gas en la vivienda, dos adultos pueden trasladar a la niña hacia un lugar seguro, manteniendo a","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":34,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":290,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"93c76942-a006-4f84-8cdb-8c13524389ef","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-51,"ty":-4087},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":34,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}},{"y":17,"from":34,"to":66,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":66,"to":135,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":135,"to":210,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":210,"to":286,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":286,"to":324,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Realizar movimientos controlados: requiere desplazar a la persona lesionada de manera lenta, coordinada y sin movimientos bruscos. Por ejemplo, ante una fuga de gas en la vivienda, dos adultos pueden trasladar a la niña hacia un lugar seguro, manteniendo alineados la cabeza, el cuello y el tronco durante todo el recorrido."}},{"type":"text","name":"Reevaluar el estado general: implica observar permanentemente la conciencia, la respiración, la coloración de la piel y otras manifestaciones durante el traslado. Por ejemplo, si el niño se torna somnoliento, respira con dificultad o presenta vómito, se de","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":29,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":334,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"e6d626c0-930b-4be8-b1a8-496354471d3c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-51,"ty":-3727},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":29,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}},{"y":17,"from":29,"to":65,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":65,"to":142,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":142,"to":221,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":221,"to":296,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":296,"to":363,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Reevaluar el estado general: implica observar permanentemente la conciencia, la respiración, la coloración de la piel y otras manifestaciones durante el traslado. Por ejemplo, si el niño se torna somnoliento, respira con dificultad o presenta vómito, se debe detener el desplazamiento, solicitar ayuda especializada y vigilar su estado hasta recibir orientación. "}},{"type":"group","name":"Grupo 1184224","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true}},"id":"e1d7ca0c-9098-4bd2-a5dc-0a71ae880257","transform":{"a":1,"b":0,"c":0,"d":1,"tx":24468,"ty":2523},"group":{"children":[{"type":"shape","name":"Rectángulo 454905","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"52e2e263-d5d0-486b-b8b8-896a8fcc08e8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-23947,"ty":-7331},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":584,"height":330}},{"type":"shape","name":"Rectángulo 454715","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constrain