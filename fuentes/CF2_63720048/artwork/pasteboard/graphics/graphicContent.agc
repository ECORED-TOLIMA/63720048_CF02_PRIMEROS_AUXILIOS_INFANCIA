ptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":371,"to":402,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":185,"from":403,"to":403,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":209,"from":404,"to":459,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":233,"from":459,"to":520,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":257,"from":520,"to":591,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":281,"from":591,"to":652,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":305,"from":652,"to":714,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":329,"from":714,"to":775,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":353,"from":775,"to":826,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"2.\tMovilización no urgente: corresponde al desplazamiento que puede planificarse porque las condiciones del lugar permanecen controladas. Por ejemplo, si un niño presenta una lesión después de caer en el jardín y requiere valoración médica, se conserva su posición mientras se organiza el traslado con orientación profesional, sin apresurarlo ni obligarlo a caminar para llegar al medio de transporte. \n\n3.\tMovilización asistida: se utiliza cuando la persona lesionada necesita ayuda para desplazarse debido a su estado físico o a las características del recorrido. Por ejemplo, si una niña se lesiona en una zona rural de difícil acceso, las personas capacitadas pueden emplear un recurso de traslado apropiado y distribuir responsabilidades para acompañarla hasta el punto donde será recibida por el personal especializado. "}},{"type":"shape","name":"Rectángulo 457150","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true}},"id":"36cd3bb1-9fc8-4487-b31d-810ae5638a23","transform":{"a":1,"b":0,"c":0,"d":1,"tx":3007,"ty":-9907},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}},"width":4,"align":"inside","cap":"round"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":204,"r":[10,10,10,10]}},{"type":"text","name":"This is a normal paragraph (p element). To add some length to it, let us mention that this page was primarily written for testing the effect ofuser style sheets. You can use it for various other purposes as well, like just checking how your browser display","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":504,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"048fb50b-5b63-48eb-804a-5e69c6502e14","transform":{"a":1,"b":0,"c":0,"d":1,"tx":3035,"ty":-9842},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":859},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":122,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":122,"to":241,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":241,"to":