h":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Black","postscriptName":"Roboto-Black","fontSize":32,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"bead44ac-b35b-4adb-bb45-74d3c9a8f1f4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2982,"ty":-7967},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Black","family":"Roboto","style":"Black","size":32},"textAttributes":{"lineHeight":35}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":16,"x":0,"style":{"font":{"postscriptName":"SegoeUIBlack","family":"Segoe UI","style":"Black"}}}]]}],"rawText":"PUNTOS CALIENTES"}},{"type":"text","name":"Alteraciones neurológicas: las convulsiones, la somnolencia excesiva, la irritabilidad persistente o la falta de respuesta pueden relacionarse con fiebre, infección, traumatismo u otra alteración grave. Se debe proteger a la niña o al niño de posibles golp","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":26,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":463,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"6e23c089-c9d5-45d3-ae08-50a793116532","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2965,"ty":-5443},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":26,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}},{"y":17,"from":26,"to":73,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":73,"to":147,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":147,"to":225,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":225,"to":304,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":304,"to":379,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":379,"to":448,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":448,"to":489,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Alteraciones neurológicas: las convulsiones, la somnolencia excesiva, la irritabilidad persistente o la falta de respuesta pueden relacionarse con fiebre, infección, traumatismo u otra alteración grave. Se debe proteger a la niña o al niño de posibles golpes, retirar los objetos cercanos y colocarlo de lado cuando sea posible. No se deben sujetar sus movimientos ni introducir elementos en la boca. También es necesario controlar la duración del episodio y solicitar atención inmediata. "}},{"type":"text","name":"•\tDeshidratación: el vómito persistente, la diarrea frecuente, el rechazo de líquidos, la boca seca, los ojos hundidos o la ausencia de lágrimas pueden indicar pérdida importante de líquidos. Si la niña o el niño está consciente y puede beber, se deben ofr","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":493,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"def2157a-f5de-4128-adcb-a256b96be0d7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2965,"ty":-5072},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":66,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":66,"to":136,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":136,"to":213,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":213,"to":284,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":284,"to":356,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":356,"to":430,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":430,"to":493,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"•\tDeshidratación: el vómito persistente, la diarrea frecuente, el rechazo de líquidos, la boca seca, los ojos hundidos o la ausencia de lágrimas pueden indicar pérdida importante de líquidos. Si la niña o el niño está consciente y puede beber, se deben ofrecer pequeñas cantidades de solución de rehidratación oral. No se deben administrar medicamentos ni preparaciones caseras sin orientación profesional. Si las manifestaciones persisten o empeoran, se requiere valoración médica inmediata. "}},{"type":"text","name":"•\tAlteraciones de la temperatura: la fiebre persistente, la temperatura corporal baja o el decaimiento general pueden indicar una infección u otra condición que requiere valoración. Se debe comprobar la temperatura, retirar el exceso de abrigo y mantener u","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":493,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"632be3e3-9b62-48c2-9efe-a807eaff0790","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2965,"ty":-4701},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":60,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":60,"to":130,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":130,"to":203,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":203,"to":278,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":278,"to":354,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":354,"to":432,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":432,"to":482,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"•\tAlteraciones de la temperatura: la fiebre persistente, la temperatura corporal baja o el decaimiento general pueden indicar una infección u otra condición que requiere valoración. Se debe comprobar la temperatura, retirar el exceso de abrigo y mantener un ambiente ventilado. No se recomienda aplicar alcohol, hielo ni baños con agua fría. Si aparecen convulsiones, somnolencia, dificultad respiratoria o deterioro progresivo, se debe solicitar atención profesional de inmediato. "}},{"type":"text","name":"•\tAlteraciones circulatorias: la palidez marcada, la piel fría, el pulso débil o la recuperación lenta del color de la piel pueden indicar una alteración de la circulación. La niña o el niño debe permanecer en reposo, abrigado y bajo vigilancia continua. N","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":493,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"8f852cc9-aaa2-451c-85ed-8612e1a05b34","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2965,"ty":-4330},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":73,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":73,"to":143,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":143,"to":218,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":218,"to":288,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":288,"to":350,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":350,"to":422,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":422,"to":464,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"•\tAlteraciones circulatorias: la palidez marcada, la piel fría, el pulso débil o la recuperación lenta del color de la piel pueden indicar una alteración de la circulación. La niña o el niño debe permanecer en reposo, abrigado y bajo vigilancia continua. No se deben ofrecer alimentos ni bebidas. Se debe activar el sistema de emergencias y observar permanentemente la respiración, el estado de conciencia y la coloración mientras llega el personal especializado. "}},{"type":"text","name":"•\tAlteraciones nutricionales: la pérdida de peso, la falta de crecimiento, la debilidad o el rechazo persistente de los alimentos pueden relacionarse con una alteración nutricional u otra enfermedad. Se debe observar cuánto tiempo lleva la dificultad, regi","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":493,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"85d6a211-2e55-4238-9470-77d0f8327c78","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2965,"ty":-3959},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":62,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":62,"to":137,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":137,"to":208,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":208,"to":280,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":280,"to":348,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":348,"to":422,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":422,"to":473,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"•\tAlteraciones nutricionales: la pérdida de peso, la falta de crecimiento, la debilidad o el rechazo persistente de los alimentos pueden relacionarse con una alteración nutricional u otra enfermedad. Se debe observar cuánto tiempo lleva la dificultad, registrar los cambios en el apetito e informar a la familia o al cuidador. No se debe forzar la alimentación. La valoración médica y nutricional permitirá identificar la causa y establecer el seguimiento correspondiente. "}},{"type":"text","name":"•\tCambios de comportamiento: el llanto inconsolable, la debilidad extrema, la irritabilidad o una conducta diferente de la habitual pueden indicar dolor o enfermedad. Se debe identificar cuándo comenzaron los cambios y observar si están acompañados de fieb","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":493,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"a22a4e6d-6e07-49fe-872b-6b0bd5f4be2b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":2965,"ty":-3588},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":66,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":66,"to":139,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":139,"to":209,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":209,"to":279,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":279,"to":352,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":352,"to":422,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":422,"to":476,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"•\tCambios de comportamiento: el llanto inconsolable, la debilidad extrema, la irritabilidad o una conducta diferente de la habitual pueden indicar dolor o enfermedad. Se debe identificar cuándo comenzaron los cambios y observar si están acompañados de fiebre, golpes, dificultad respiratoria u otras manifestaciones. No se deben atribuir únicamente al cansancio. Si persisten, empeoran o se acompañan de menor respuesta a los estímulos, se requiere atención médica inmediata. "}},{"type":"group","name":"Grupo 1184435","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constr