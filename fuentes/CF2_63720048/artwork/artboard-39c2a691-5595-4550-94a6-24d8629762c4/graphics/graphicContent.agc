a primera infancia","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1,"linkId":"","fontFamily":"Roboto","fontStyle":"Black","postscriptName":"Roboto-Black","fontSize":20,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":211.6669921875,"ty":143.6484375}}},"id":"8bfb95c5-fbf4-4f90-bb19-bfeb2a0162bb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-13832.3330078125,"ty":-8710.3515625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Black","family":"Roboto","style":"Black","size":20},"textAttributes":{"lineHeight":27}},"text":{"frame":{"type":"autoHeight","width":1112.7255859375},"paragraphs":[{"lines":[[{"y":19,"from":0,"to":49,"x":0}]]}],"rawText":"Primeros auxilios aplicados a la primera infancia"}},{"type":"text","name":"Síntesis: Técnicas de primeros auxilios en primera infancia","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":50,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":212,"ty":182.6484375}}},"id":"c6b200c0-8cef-470a-9c6c-237ea72327f2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-13832,"ty":-8671.3515625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1004},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":59,"x":0}]]}],"rawText":"Síntesis: Técnicas de primeros auxilios en primera infancia"}},{"type":"text","name":"El componente formativo desarrolla los fundamentos y procedimientos esenciales para la atención de emergencias en la primera infancia, integrando conocimientos de anatomía y fisiología básica, evaluación inicial del lesionado y aplicación del soporte vital","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":458,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":290}}},"id":"c4c69b34-f0a6-4832-9719-1bab50c2ac7f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-13858,"ty":-8564},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":163,"x":0}],[{"y":39,"from":163,"to":339,"x":0}],[{"y":63,"from":339,"to":436,"x":0}]]},{"lines":[[{"y":87,"from":437,"to":437,"x":0}]]},{"lines":[[{"y":111,"from":438,"to":597,"x":0}],[{"y":135,"from":597,"to":769,"x":0}],[{"y":159,"from":769,"to":931,"x":0}],[{"y":183,"from":931,"to":987,"x":0}]]}],"rawText":"El componente formativo desarrolla los fundamentos y procedimientos esenciales para la atención de emergencias en la primera infancia, integrando conocimientos de anatomía y fisiología básica, evaluación inicial del lesionado y aplicación del soporte vital básico. A partir de estos elementos, se fortalecen las capacidades para reconocer situaciones críticas, interpretar signos de alarma y ejecutar intervenciones oportunas y seguras.\n\nDe igual forma, se abordan las principales lesiones y situaciones específicas que pueden presentarse en esta etapa, así como la movilización del lesionado, la comunicación con el menor y la articulación con el sistema de emergencias. Todo ello con el propósito de garantizar una atención integral, segura y oportuna que proteja la vida y la salud de niñas y niños en las diferentes situaciones de emergencia. A continuación, el mapa conceptual organiza de manera visual los ejes temáticos del componente formativo y las relaciones que los articulan."}},{"type":"shape","name":"Trazado 873465","meta":{"ux":{"nameL10N":"SHAPE_PATH","rotation":90,"constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":0,"b":1,"c":-1,"d":0,"tx":1322.499755859375,"ty":664.0748901367188}}},"id":"5f31dfcd-73ba-45a3-9393-9eb30fb6bf24","transform":{"a":0,"b":1,"c":-1,"d":0,"tx":-12721.500244140625,"ty":-8189.925109863281},"style":{"fill":{"type":"none","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}},"uxdesign#type":"solid"},"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":68,"g":88,"b":102}},"width":3}},"shape":{"type":"path","path":"M 42.65234375 0 L 0 0 L 0 1044 L 45.849609375 1044"}},{"type":"shape","name":"Trazado 873466","meta":{"ux":{"nameL10N":"SHAPE_PATH","rotation":180,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":-1,"b":0,"c":0,"d":-1,"tx":800.5,"ty":664.0745239257812}}},"id":"e062e484-00a6-4b00-a217-ed56e9b3b77d","transform":{"a":-1,"b":0,"c":0,"d":-1,"tx":-13243.5,"ty":-8189.925476074219},"style":{"fill":{"type":"none","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}},"uxdesign#type":"solid"},"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":68,"g":88,"b":102}},"width":3}},"shape":{"type":"path","path":"M 0 0 L 0 66.36083984375"}},{"type":"shape","name":"Rectángulo 345699","meta