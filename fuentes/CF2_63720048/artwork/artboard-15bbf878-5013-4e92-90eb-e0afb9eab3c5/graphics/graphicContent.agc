[{"lines":[[{"y":15,"from":0,"to":121,"x":0}],[{"y":39,"from":121,"to":246,"x":0}],[{"y":63,"from":246,"to":372,"x":0}],[{"y":87,"from":372,"to":454,"x":0}]]}],"rawText":"Las técnicas de primeros auxilios en la primera infancia representan una herramienta esencial para proteger la vida y la integridad de un niño o una niña ante una situación de emergencia. Sin embargo, su aplicación efectiva no depende únicamente de conocer los procedimientos, sino de comprender el funcionamiento del cuerpo en esta etapa de la vida, reconocer los signos de alarma y actuar con calma y seguridad mientras llega la atención especializada."}},{"type":"group","name":"Grupo 159162","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":5,"ty":-160.91293334960938}}},"id":"2b16220c-e82a-4d37-a991-9f4691f2683c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-12268.6298828125,"ty":-11860.91293334961},"group":{"children":[{"type":"group","name":"Enmascarar grupo 64","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 45656","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"ff98ca1b-a865-494f-a50a-677b40808441","style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":255,"b":255}}},"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1228,"height":579.8878784179688,"r":[10,10,10,10]}}],"type":"clipPath"}}},"id":"8bd8e1f4-3f65-4b00-a765-693854b17518","transform":{"a":1,"b":0,"c":0,"d":1,"tx":180,"ty":902.9130859375},"group":{"children":[{"type":"shape","name":"Imagen 9","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":1950,"height":1300}}},"id":"1c2f2877-dade-403c-9e5b-2d7091d98d14","transform":{"a":1,"b":0,"