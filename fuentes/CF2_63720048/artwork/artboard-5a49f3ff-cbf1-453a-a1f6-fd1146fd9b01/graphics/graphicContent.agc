3a-373b3f94d49d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1673,"ty":-8781.5},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":939},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":22,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}},{"y":17,"from":22,"to":121,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":121,"to":183,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":65,"from":184,"to":184,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":89,"from":185,"to":315,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":315,"to":346,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":137,"from":347,"to":347,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":161,"from":348,"to":474,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":185,"from":474,"to":527,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":209,"from":528,"to":528,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":233,"from":529,"to":652,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":257,"from":652,"to":711,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":281,"from":712,"to":712,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":305,"from":713,"to":833,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":329,"from":833,"to":890,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":353,"from":891,"to":891,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":377,"from":892,"to":1025,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":401,"from":1025,"to":1064,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Temporadas de lluvia: durante las lluvias aumenta la exposición a humedad, aguas estancadas y vectores, lo cual favorece enfermedades respiratorias, gastrointestinales e infecciosas. \n\nCambios de temperatura: los cambios de temperatura pueden debilitar las defensas y favorecer tos, congestión, fiebre o dificultad respiratoria en niñas y niños. \n\nEspacios comunitarios: la permanencia en jardines, hogares comunitarios u otros espacios compartidos facilita el contacto con personas enfermas y agentes infecciosos circulantes. \n\nAgua o alimentos contaminados: el consumo de agua o alimentos contaminados puede causar diarrea, vómito, dolor abdominal y deshidratación, especialmente durante la primera infancia. \n\nVacunación incompleta: los esquemas de vacunación incompletos reducen la protección frente a enfermedades prevenibles y aumentan el riesgo de complicaciones graves posteriores. \n\nDificultades de acceso: las dificultades para acceder a controles médicos retrasan la detección de alteraciones y el inicio oportuno del tratamiento profesional requerido. "}},{"type":"shape","name":"Rectángulo 456431","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":498,"ty":3842}}},"id":"615c1c9c-c9b2-41b1-bc4a-a0f58f4092af","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1835,"ty":-7858},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":320}},{"type":"text","name":"Respiración: identificar dificultad, sonidos inusuales o cambios en el ritmo respiratorio. \n\nHidratación: observar sequedad en la boca, ausencia de lágrimas o disminución de la orina. \n\nTemperatura corporal: reconocer fiebre persistente, temperatura baja o","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":12,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":565,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":563,"ty":3869}}},"id":"b0e5455e-d272-46fc-8682-e5ada73930e5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1900,"ty":-7831},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":825},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":12,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}},{"y":17,"from":12,"to":91,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":41,"from":92,"to":92,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":65,"from":93,"to":184,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":89,"from":185,"to":185,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":113,"from":186,"to":281,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":137,"from":282,"to":282,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":161,"from":283,"to":371,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":185,"from":372,"to":372,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":209,"from":373,"to":467,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":233,"from":468,"to":468,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":257,"from":469,"to":577,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Respiración: identificar dificultad, sonidos inusuales o cambios en el ritmo respiratorio. \n\nHidratación: observar sequedad en la boca, ausencia de lágrimas o disminución de la orina. \n\nTemperatura corporal: reconocer fiebre persistente, temperatura baja o variaciones repentinas. \n\nPiel: verificar cambios de coloración, erupciones, inflamación o aparición de lesiones. \n\nAlimentación: prestar atención al rechazo de alimentos o líquidos y a la pérdida del apetito. \n\nComportamiento: reconocer somnolencia excesiva, irritabilidad, debilidad o menor respuesta a los estímulos. "}},{"type":"shape","name":"Rectángu