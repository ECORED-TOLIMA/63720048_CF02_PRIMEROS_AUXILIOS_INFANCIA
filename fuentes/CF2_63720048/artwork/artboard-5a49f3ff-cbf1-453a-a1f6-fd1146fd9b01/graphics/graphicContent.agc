b":0,"c":0,"d":1,"tx":1939.7109375,"ty":-11384},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":811},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":112,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":112,"to":222,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":222,"to":332,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":332,"to":417,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Durante la primera infancia pueden presentarse accidentes y alteraciones de salud que evolucionan rápidamente y requieren una respuesta oportuna. Entre estas situaciones se encuentran la presencia de cuerpos extraños, las picaduras, las mordeduras, las convulsiones y las intoxicaciones. También son frecuentes algunas enfermedades respiratorias, gastrointestinales, dermatológicas, nutricionales e inmunoprevenibles."}},{"type":"text","name":"En los hogares, jardines infantiles y demás espacios de cuidado pueden ocurrir situaciones cotidianas como las siguientes:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":630}}},"id":"bfeab7ed-5bdf-4b80-93dc-d6a050400498","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-11070},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1233},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":122,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"En los hogares, jardines infantiles y demás espacios de cuidado pueden ocurrir situaciones cotidianas como las siguientes:"}},{"type":"text","name":"Estas situaciones muestran la importancia de conservar la calma, proteger a la niña o al niño y evitar procedimientos improvisados. La intervención debe centrarse en reconocer los signos presentes, prevenir nuevos riesgos y solicitar ayuda profesional cuan","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":892}}},"id":"bf36ae72-f9f2-4b12-a773-8fbb8d7c75be","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-10808},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1233},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":166,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":166,"to":316,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Estas situaciones muestran la importancia de conservar la calma, proteger a la niña o al niño y evitar procedimientos improvisados. La intervención debe centrarse en reconocer los signos presentes, prevenir nuevos riesgos y solicitar ayuda profesional cuando la condición supere la capacidad de respuesta disponible."}},{"type":"text","name":"El reconocimiento inicial de estas condiciones facilita la selección de medidas acordes con cada evento. Por ello, el siguiente apartado presenta las situaciones específicas que requieren primeros auxilios y las acciones básicas que pueden aplicarse mientr","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":1170}}},"id":"11d724d6-2541-4304-a69a-f5343cb4f4d2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-10530},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1233},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":178,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":178,"to":293,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"El reconocimiento inicial de estas condiciones facilita la selección de medidas acordes con cada evento. Por ello, el siguiente apartado presenta las situaciones específicas que requieren primeros auxilios y las acciones básicas que pueden aplicarse mientras se obtiene atención especializada."}},{"type":"shape","name":"Rectángulo 456415","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.7109375,"ty":437}}},"id":"a0c0280c-4e92-470d-8461-b472cda5d3ce","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1938.7109375,"ty":-11263},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":160,"r":[10,10,10,10]}},{"type":"text","name":"Aunque estas situaciones tienen causas y manifestaciones diferentes, su atención inicial parte de una actuación común: observar el estado general de la niña o del niño, reconocer los cambios que indican gravedad y aplicar únicamente las medidas que corresp","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":637.7109375,"ty":460}}},"id":"25e4b51b-9838-4d6a-aae4-136ccd479f7e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1974.7109375,"ty":-11240},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":741},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":102,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":102,"to":203,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":203,"to":295,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":295,"to":398,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":398,"to":446,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Aunque estas situaciones tienen causas y manifestaciones diferentes, su atención inicial parte de una actuación común: observar el estado general de la niña o del niño, reconocer los cambios que indican gravedad y aplicar únicamente las medidas que correspondan al nivel de formación del primer respondiente. Esta valoración permite decidir si se requiere vigilancia, consulta médica prioritaria o activación inmediata del sistema de emergencias."}},{"type":"text","name":"La atención de situaciones específicas comprende las medidas iniciales aplicadas ante eventos que pueden afectar repentinamente la salud de una niña o un niño. Su propósito es proteger la vida, disminuir la exposición al peligro y evitar que la condición s","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":1455}}},"id":"04986da1-187a-473e-a2e2-1d57bf68fc0f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-10245},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":113,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":113,"to":245,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":245,"to":321,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"La atención de situaciones específicas comprende las medidas iniciales aplicadas ante eventos que pueden afectar repentinamente la salud de una niña o un niño. Su propósito es proteger la vida, disminuir la exposición al peligro y evitar que la condición se agrave mientras se solicita orientación o atención profesional."}},{"type":"text","name":"Las principales situaciones que requieren atención inicial son:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":1732}}},"id":"819be6e3-1b30-403a-a1b4-37c785a79221","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-9968},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":63,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Las principales situaciones que requieren atención inicial son:"}},{"type":"text","name":"El reconocimiento de estas situaciones permite aplicar medidas diferentes de acuerdo con el tipo de evento. En todos los casos, la observación continua resulta indispensable para detectar cambios en la respiración, la conciencia, la coloración de la piel o","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":2079}}},"id":"17003aba-a30c-4855-aec3-dd24090b8b97","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-9621},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":160,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":160,"to":275,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"El reconocimiento de estas situaciones permite aplicar medidas diferentes de acuerdo con el tipo de evento. En todos los casos, la observación continua resulta indispensable para detectar cambios en la respiración, la conciencia, la coloración de la piel o el comportamiento."}},{"type":"text","name":"Una vez atendido el evento inmediato, es necesario considerar otras alteraciones de salud que pueden manifestarse de manera progresiva. Entre ellas se encuentran las enfermedades prevalentes, cuyo reconocimiento favorece la consulta temprana y la prevenció","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":2363}}},"id":"8b4e0b4f-c095-4cb7-8de8-d8823692d8d0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-9337},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":166,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":166,"to":276,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Una vez atendido el evento inmediato, es necesario considerar otras alteraciones de salud que pueden manifestarse de manera progresiva. Entre ellas se encuentran las enfermedades prevalentes, cuyo reconocimiento favorece la consulta temprana y la prevención de complicaciones."}},{"type":"text","name":"Las enfermedades prevalentes son condiciones de salud que se presentan con mayor frecuencia durante los primeros años de vida. Su aparición puede relacionarse con la inmadurez del sistema inmunológico, las condiciones del entorno, el acceso al agua segura,","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":2526}}},"id":"31234b1d-8781-4847-8a31-0b73123ac1cf","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-9174},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":104,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":104,"to":206,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":206,"to":318,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":318,"to":338,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Las enfermedades prevalentes son condiciones de salud que se presentan con mayor frecuencia durante los primeros años de vida. Su aparición puede relacionarse con la inmadurez del sistema inmunológico, las condiciones del entorno, el acceso al agua segura, la alimentación, la higiene, la vacunación y la exposición a agentes infecciosos."}},{"type":"text","name":"En el contexto colombiano, algunas condiciones ambientales, sociales y sanitarias pueden aumentar la aparición de enfermedades durante la primera infancia. Entre ellas se encuentran:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":2817.5}}},"id":"7583ed76-09fb-4b28-a356-cf6ad750a5a4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-8882.5},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":171,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":171,"to":182,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"En el contexto colombiano, algunas condiciones ambientales, sociales y sanitarias pueden aumentar la aparición de enfermedades durante la primera infancia. Entre ellas se encuentran:"}},{"type":"text","name":"El reconocimiento de estas condiciones permite fortalecer las acciones preventivas en el hogar y orientar oportunamente la consulta ante cambios en la salud.\n\nAntes de describir las principales patologías, es importante reconocer que cada una presenta mani","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":3388}}},"id":"7bf9dd4b-055e-42dd-a5e3-0be830782cef","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-8312},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":157,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":41,"from":158,"to":158,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":65,"from":159,"to":330,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":330,"to":505,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":505,"to":537,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"El reconocimiento de estas condiciones permite fortalecer las acciones preventivas en el hogar y orientar oportunamente la consulta ante cambios en la salud.\n\nAntes de describir las principales patologías, es importante reconocer que cada una presenta manifestaciones particulares y puede afectar de manera diferente el bienestar de las niñas y los niños. Su clasificación facilita la comprensión de los síntomas más frecuentes y orienta la identificación oportuna de los cambios que requieren valoración por parte del personal de salud."}},{"type":"text","name":"La observación conjunta de estos aspectos permite detectar oportunamente un posible deterioro de la salud y solicitar la atención necesaria, sin establecer diagnósticos ni administrar tratamientos por iniciativa propia.\n\nAntes de explorar las principales e","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":4203}}},"id":"64fb4f5f-3370-4986-a735-498c083c48c0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-7497},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":172,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":172,"to":219,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":65,"from":220,"to":220,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]},{"lines":[[{"y":89,"from":221,"to":390,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":390,"to":557,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":557,"to":609,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"La observación conjunta de estos aspectos permite detectar oportunamente un posible deterioro de la salud y solicitar la atención necesaria, sin establecer diagnósticos ni administrar tratamientos por iniciativa propia.\n\nAntes de explorar las principales enfermedades prevalentes, es importante reconocer que cada una puede afectar de manera diferente la salud de las niñas y los niños. El siguiente recurso interactivo permite conocer sus características, manifestaciones y principales medidas de prevención, así como identificar los cambios que requieren valoración oportuna por parte del personal de salud."}},{"type":"text","name":"El reconocimiento de las enfermedades prevalentes en la primera infancia favorece la prevención y la detección temprana de cambios en el estado de salud. La observación de signos y síntomas, junto con el acceso oportuno a los servicios de salud, permite or","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":5070}}},"id":"df427d60-f7f3-4bb9-b6e2-522617f64e7f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1522.7109375,"ty":-6630},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916.2890625},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":123,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":123,"to":246,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":246,"to":323,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"El reconocimiento de las enfermedades prevalentes en la primera infancia favorece la prevención y la detección temprana de cambios en el estado de salud. La observación de signos y síntomas, junto con el acceso oportuno a los servicios de salud, permite orientar una atención adecuada y reducir el riesgo de complicaciones."}},{"type":"text","name":"Además de identificar las manifestaciones de estas enfermedades, es fundamental reconocer aquellas señales que pueden indicar un deterioro de la salud. A continuación, se abordan los principales signos de alarma y las acciones iniciales que deben realizars","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":5167}}},"id":"a038f593-d4ec-4701-ab73-a48ca513d319","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1627,"ty":-6533},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":811.7109375},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":111,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":111,"to":227,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":227,"to":276,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Además de identificar las manifestaciones de estas enfermedades, es fundamental reconocer aquellas señales que pueden indicar un deterioro de la salud. A continuación, se abordan los principales signos de alarma y las acciones iniciales que deben realizarse ante su aparición."}},{"type":"text","name":"Durante la primera infancia, algunas enfermedades pueden iniciar con manifestaci