e UI","style":"Regular"}}}]]}],"rawText":"Durante la primera infancia, algunas alteraciones de salud pueden evolucionar rápidamente y comprometer el bienestar de la niña o del niño. Los signos de alarma son manifestaciones que permiten reconocer un posible deterioro y orientan la necesidad de solicitar atención profesional prioritaria o activar inmediatamente el sistema de emergencias."}},{"type":"text","name":"Los principales signos de alarma y las conductas iniciales que deben aplicarse son:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186.10400390625,"ty":6112.474609375}}},"id":"b7615706-153b-4731-a88c-71aded780c82","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1523.10400390625,"ty":-5587.525390625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":83,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Los principales signos de alarma y las conductas iniciales que deben aplicarse son:"}},{"type":"shape","name":"Trazado 1008642","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186.10400390625,"ty":5590.474609375}}},"id":"617421c1-cc41-46c3-94a0-8eab6f108afb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1523.10400390625,"ty":-6109.525390625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 916.2890625 0 L 916.2890625 260 L 0 260 L 0 0 Z"}},{"type":"text","name":"La observación debe centrarse en los cambios relacionados con la respiración, el estado de conciencia, la hidratación, la temperatura corporal, la circulación, la alimentación y el comportamiento. Para reconocer una situación que requiere atención, no es n","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":226.10400390625,"ty":5734.474609375}}},"id":"95e874c9-493c-40cf-88d8-7343daa22e16","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1563.10400390625,"ty":-5965.525390625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":836},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":119,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":41,"from":119,"to":230,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":65,"from":230,"to":346,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":346,"to":367,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"La observación debe centrarse en los cambios relacionados con la respiración, el estado de conciencia, la hidratación, la temperatura corporal, la circulación, la alimentación y el comportamiento. Para reconocer una situación que requiere atención, no es necesario establecer un diagnóstico; se debe identificar cualquier manifestación inusual y valorar su evolución."}},{"type":"group","name":"Grupo 1184250","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0.18505859375,"ty":-462.525390625}}},"id":"cc2e7d86-6745-4fd5-aed9-4096b2d3bda6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1337.18505859375,"ty":-12162.525390625},"group":{"children":[{"type":"shape","name":"Rectángulo 456542","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true}},"id":"eb64f9a8-d030-4bab-a765-123a555b0836","transform":{"a":1,"b":0,"c":0,"d":1,"tx":225.9189453125,"ty":6083},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84,"r":[10,10,10,10]}},{"type":"group","name":"Grupo 1181789","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"2e2ff5e5-671f-4868-9ee8-09bedcc0de8f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":239.900634765625,"ty":6097.015625},"group":{"children":[{"type":"shape","name":"Trazado 1003669","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true}},"id":"a38bf394-0acd-4df8-9a51-5c9ca6782c8f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-198.2324981689453,"ty":-6.680235385894775},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":218,"g":74,"b":84}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},