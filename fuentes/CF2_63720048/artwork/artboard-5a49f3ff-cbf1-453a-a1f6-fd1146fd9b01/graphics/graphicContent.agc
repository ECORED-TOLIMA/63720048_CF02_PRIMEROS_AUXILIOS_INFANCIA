dimiento entre las costillas, el aleteo nasal, los sonidos inusuales o la coloración azulada pueden indicar falta de oxígeno. Se debe mantener despejada la vía aérea, ubicar a la niña o al niño en una p","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":25,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":437,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":225,"ty":6257}}},"id":"5fba1e70-b0d4-47e2-957e-402a6a011c1d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1562,"ty":-5443},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":540},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":23,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":41,"from":24,"to":24,"x":0,"style":{"font":{"postscriptName":"SegoeUI-Bold","family":"Segoe UI","style":"Bold"}}}]]},{"lines":[[{"y":65,"from":25,"to":105,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":89,"from":105,"to":180,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":113,"from":180,"to":255,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":137,"from":255,"to":333,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":161,"from":333,"to":403,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}],[{"y":185,"from":403,"to":462,"x":0,"style":{"font":{"postscriptName":"SegoeUI","family":"Segoe UI","style":"Regular"}}}]]}],"rawText":"Dificultad respiratoria\n\nLa respiración rápida, el hundimiento entre las costillas, el aleteo nasal, los sonidos inusuales o la coloración azulada pueden indicar falta de oxígeno. Se debe mantener despejada la vía aérea, ubicar a la niña o al niño en una posición que facilite la respiración y evitar ofrecer alimentos o bebidas. Es necesario activar inmediatamente el sistema de emergencias y observar cualquier cambio mientras llega el personal especializado. "}},{"type":"group","name":"Grupo 1184433","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0.25390625,"ty":1900}}},"id":"baa34e32-76b3-4df6-9004-e4e483031409","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1337.25390625,"ty":-9800},"group":{"children":[{"type":"group","name":"Grupo 1177703","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true}},"id":"05a468f8-b5be-4812-91e8-d6228c0a7fab","transform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":-612},"group":{"children":[{"type":"group","name":"Grupo 1072724","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true}},"id":"8592742c-d26a-4a9e-8b23-b329bd979d5b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":209,"ty":857.5078125},"group":{"children":[{"type":"shape","name":"Elipse 4701","meta":{"ux":{"nameL10N":"SHAPE_ELLIPSE","aspectLock":{"width":80,"height":80}}},"id":"74d11aed-2409-46e8-a4c2-c6ad956a7894","transform":{"a":1,"b":0,"c":0,"d":1,"tx":530,"ty":4488},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":1