1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":1230}}},"id":"aa9ba1c6-9c2f-41a9-a630-48369f61ca06","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10216,"ty":-10470},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":708},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":88,"x":0}],[{"y":39,"from":88,"to":189,"x":0}],[{"y":63,"from":189,"to":286,"x":0}],[{"y":87,"from":286,"to":343,"x":0}]]}],"rawText":"La comprensión integrada de estos sistemas favorece una valoración inicial adecuada, la identificación de riesgos y la aplicación segura de las técnicas de primeros auxilios. En la primera infancia, una intervención oportuna puede contribuir favorablemente a la evolución de la persona afectada (Ministerio de Salud y Protección Social, 2018)."}},{"type":"shape","name":"Rectángulo 457018","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":1351}}},"id":"b0ecc9ce-53cd-4d17-82f4-12f97096d359","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10216,"ty":-10349},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":230,"b":222}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":708,"height":150}},{"type":"shape","name":"Rectángulo 457026","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497.7109375,"ty":5348}}},"id":"770cd0a4-c238-4cd2-96d6-22ec9ab150df","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10008,"ty":-6352},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":230,"b":222}}},"stroke":{"type"