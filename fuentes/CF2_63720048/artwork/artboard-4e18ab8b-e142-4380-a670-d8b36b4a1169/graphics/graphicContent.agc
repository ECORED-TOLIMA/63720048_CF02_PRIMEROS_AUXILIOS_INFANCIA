B","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Black","family":"Roboto","style":"Black","size":30},"textAttributes":{"lineHeight":35}},"text":{"frame":{"type":"autoHeight","width":18},"paragraphs":[{"lines":[[{"y":29,"from":0,"to":1,"x":0}]]}],"rawText":"1"}},{"type":"shape","name":"Trazado 873459","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":270}}},"id":"9f99d5c4-f3fa-421e-a927-3a90bc13b086","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10319.7109375,"ty":-11430},"style":{"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":218,"b":218}},"width":3}},"shape":{"type":"path","path":"M 0 0 L 1228 1.13671875"}},{"type":"text","name":"El sistema circulatorio transporta la sangre por todo el organismo y permite que las células reciban el oxígeno y los nutrientes necesarios para su funcionamiento. También recoge dióxido de carbono y otras sustancias de desecho para facilitar su eliminació","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497.7109375,"ty":1743}}},"id":"9a7280c3-c6b4-4324-a699-e9755dff4bf0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10008,"ty":-9957},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":129,"x":0}],[{"y":39,"from":129,"to":246,"x":0}],[{"y":63,"from":246,"to":367,"x":0}],[{"y":87,"from":367,"to":439,"x":0}]]}],"rawText":"El sistema circulatorio transporta la sangre por todo el organismo y permite que las células reciban el oxígeno y los nutrientes necesarios para su funcionamiento. También recoge dióxido de carbono y otras sustancias de desecho para facilitar su eliminación. Está conformado por el corazón, los vasos sanguíneos y la sangre, elementos que actúan de manera coordinada para conservar el equilibrio del organismo (Tortora y Derrickson, 2021)."}},{"type":"text","name":"Durante la primera infancia, la valoración de la circulación permite reconocer signos que pueden indicar una alteración y requerir atención prioritaria. La frecuencia y la calidad del pulso, el color y la temperatura de la piel, así como el tiempo de llena","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":2034}}},"id":"5a35fd6e-d1b4-4fc2-917c-1fc3ef3821b5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10319.7109375,"ty":-9666},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1227.7109375},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":172,"x":0}],[{"y":39,"from":172,"to":347,"x":0}],[{"y":63,"from":347,"to":428,"x":0}]]},{"lines":[[{"y":87,"from":429,"to":429,"x":0}]]},{"lines":[[{"y":111,"from":430,"to":598,"x":0}],[{"y":135,"from":598,"to":751,"x":0}]]}],"rawText":"Durante la primera infancia, la valoración de la circulación permite reconocer signos que pueden indicar una alteración y requerir atención prioritaria. La frecuencia y la calidad del pulso, el color y la temperatura de la piel, así como el tiempo de llenado capilar, aportan información sobre el flujo sanguíneo. Estos signos deben interpretarse de manera conjunta y teniendo en cuenta el estado general de la persona afectada.\n\nCada estructura del sistema circulatorio cumple una función específica en el recorrido y la distribución de la sangre. El reconocimiento de estas funciones facilita la comprensión del proceso circulatorio y de las alteraciones que pueden presentarse durante una emergencia. Sus principales componentes son los siguientes:"}},{"type":"group","name":"Grupo 1181592","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":2637}}},"id":"3b36ec4e-d13e-4803-9566-27fa71505a1a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10505.7109375,"ty":-9063},"group":{"children":[{"type":"group","name":"hr-before-h2","id":"2bc96e43-8e32-459e-8eb2-7d3dd5be3830","transform":{"a":1,"b":0,"c":0,"d":1,"tx":390.37109375,"ty":1066},"meta":{"ux":{"hasCustomName":true,"hasNameFromExternalSource":true,"constraintWidth":true,"constraintHeight":true}},"group":{"children":[{"type":"shape","name":"Rectángulo 5131","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"907b9f24-4a1b-45a0-bd78-e7fbf36cdf16","transform":{"a":1,"b":0,"c":0,"d":1,"tx":0.0009765625,"ty":0},"style":{"fill":{"type":"gradient","gradient":{"meta":{"ux":{"gradientResources":{"type":"radial","stops":[{"offset":0,"color":{"mode":"RGB","value":{"r":0,"g":0,"b":0},"alpha":0.10196078431372549}},{"offset":1,"color":{"mode":"RGB","value":{"r":255,"g":255,"b":255},"