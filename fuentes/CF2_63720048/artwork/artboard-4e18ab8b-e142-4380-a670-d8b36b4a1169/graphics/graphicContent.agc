":{"a":1,"b":0,"c":0,"d":1,"tx":-9867,"ty":-7296.4501953125},"meta":{"ux":{"hasCustomName":true,"customConstraints":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":11,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":18,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":638.7109375,"ty":4403.5498046875}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":18},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":8,"x":-40.79812240600586}]]}],"rawText":"Pulmones"}},{"type":"text","name":"Feature One","id":"7d8b076f-a241-465b-988d-d343b78a6196","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9456,"ty":-7296.4501953125},"meta":{"ux":{"hasCustomName":true,"customConstraints":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":11,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":18,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1049.7109375,"ty":4403.5498046875}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":18},"textAttributes":{"letterSpacing":2.5,"lineHeight":24,"paragraphAlign":"center"}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":17,"from":0,"to":22,"x":-93.59700012207031}]]}],"rawText":"Músculos respiratorios"}},{"type":"text","name":"Far far away, behind","id":"26d50610-794e-42f4-8a95-56f5cfe4ba67","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10279,"ty":-7239.8388671875},"meta":{"ux":{"hasCustomName":true,"constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":226.7109375,"ty":4460.1611328125}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":42,"x":0}],[{"y":39,"from":42,"to":89,"x":0}],[{"y":63,"from":89,"to":136,"x":0}],[{"y":87,"from":136,"to":176,"x":0}],[{"y":111,"from":176,"to":220,"x":0}],[{"y":135,"from":220,"to":258,"x":0}]]}],"rawText":"Conducen el aire desde la nariz o la boca hasta los pulmones, a través de la faringe, la laringe y la tráquea. Por ejemplo, un alimento o un objeto pequeño puede bloquear este recorrido y ocasionar una obstrucción de la vía aérea por cuerpo extraño (OVACE). "}},{"type":"text","name":"Far far away, behind","id":"e0df99b6-a263-4b55-8161-f51c29af6e3b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9867,"ty":-7239.8388671875},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":638.7109375,"ty":4460.1611328125}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":45,"x":0}],[{"y":39,"from":45,"to":87,"x":0}],[{"y":63,"from":87,"to":127,"x":0}],[{"y":87,"from":127,"to":171,"x":0}],[{"y":111,"from":171,"to":216,"x":0}],[{"y":135,"from":216,"to":239,"x":0}]]}],"rawText":"Realizan el intercambio de oxígeno y dióxido de carbono entre el aire y la sangre. Por ejemplo, una alteración en este proceso puede manifestarse mediante dificultad para respirar, respiración acelerada o coloración azulada en los labios. "}},{"type":"text","name":"Far far away, behind","id":"68656e8d-43fe-4c4a-82a4-91769a19a5a3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9456,"ty":-7239.8388671875},"meta":{"ux":{"hasCustomName":true,"constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":300,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1049.7109375,"ty":4460.1611328125}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"filters":[{"type":"uxdesign#blur","global":true,"params":{"blurAmount":10,"brightnessAmount":0,"fillOpacity":1,"backgroundEffect":false},"visible":false}],"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":323},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":42,"x":0}],[{"y":39,"from":42,"to":86,"x":0}],[{"y":63,"from":86,"to":132,"x":0}],[{"y":87,"from":132,"to":176,"x":0}],[{"y":111,"from":176,"to":220,"x":0}],[{"y":135,"from":220,"to":247,"x":0}]]}],"rawText":"Permiten los movimientos de inspiración y espiración mediante la acción del diafragma y los músculos intercostales. Por ejemplo, el hundimiento de la piel entre las costillas, denominado tiraje, puede indicar un aumento del esfuerzo respiratorio. "}},{"type":"text","name":"La observación de la respiración permite reconocer signos de alarma, como movimientos anormales del tórax, ruidos respiratorios, cambios en la coloración de la piel o dificultad para hablar, llorar o toser. Estas manifestaciones deben valorarse de manera c","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":4671}}},"id":"c38c40e3-3530-497f-aa8a-ff62bab26675","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10320,"ty":-7029},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":167,"x":0}],[{"y":39,"from":167,"to":340,"x":0}],[{"y":63,"from":340,"to":359,"x":0}]]}],"rawText":"La observación de la respiración permite reconocer signos de alarma, como movimientos anormales del tórax, ruidos respiratorios, cambios en la coloración de la piel o dificultad para hablar, llorar o toser. Estas manifestaciones deben valorarse de manera conjunta, puesto que pueden indicar una disminución de la entrada de aire y requerir atención inmediata."}},{"type":"text","name":"El reconocimiento de estas manifestaciones permite establecer la posible gravedad de la lesión y evitar prácticas que puedan incrementar el daño. En la primera infancia, cualquier cambio significativo debe valorarse teniendo en cuenta su extensión, localiz","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":5932}}},"id":"ba548390-f0c4-4711-9522-4520e94c92d0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10320,"ty":-5768},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":170,"x":0}],[{"y":39,"from":170,"to":281,"x":0}]]},{"lines":[[{"y":63,"from":282,"to":282,"x":0}]]},{"lines":[[{"y":87,"from":283,"to":448,"x":0}]]}],"rawText":"El reconocimiento de estas manifestaciones permite establecer la posible gravedad de la lesión y evitar prácticas que puedan incrementar el daño. En la primera infancia, cualquier cambio significativo debe valorarse teniendo en cuenta su extensión, localización, causa y evolución.\n\nAnte una lesión de la piel, la actuación inicial debe desarrollarse de manera organizada. Para orientar este proceso, se presentan las siguientes acciones generales:"}},{"type":"text","name":"La protección del organismo depende, en gran medida, de la integridad de la piel. Esta estructura actúa como barrera frente a microorganismos, golpes, cambios de temperatura y otros agentes externos. Además, participa en la sensibilidad y en la regulación ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497.7109375,"ty":5251}}},"id":"fa43cabf-e177-4bf2-ba3f-bab2f7465544","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10008,"ty":-6449},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":126,"x":0}],[{"y":39,"from":126,"to":245,"x":0}],[{"y":63,"from":245,"to":283,"x":0}]]}],"rawText":"La protección del organismo depende, en gran medida, de la integridad de la piel. Esta estructura actúa como barrera frente a microorganismos, golpes, cambios de temperatura y otros agentes externos. Además, participa en la sensibilidad y en la regulación de la temperatura corporal."}},{"type":"shape","name":"Rectángulo 457024","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":4889}}},"id":"4b7602bd-5b61-41f0-88af-3b1edf553546","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10320,"ty":-6811},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":230,"b":222}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916,"height":120}},{"type":"text","name":"Además de incorporar el oxígeno necesario para el funcionamiento del organismo, el cuerpo requiere una barrera que lo proteja frente a lesiones, microorganismos y otros agentes externos. Esta función corresponde principalmente a la piel y a sus estructuras","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":223.7109375,"ty":4916}}},"id":"8752a03c-fa22-4db9-8fe4-de45e4b60f15","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10282,"ty":-6784},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":840},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":115,"x":0}],[{"y":39,"from":115,"to":232,"x":0}],[{"y":63,"from":232,"to":313,"x":0}]]}],"rawText":"Además de incorporar el oxígeno necesario para el funcionamiento del organismo, el cuerpo requiere una barrera que lo proteja frente a lesiones, microorganismos y otros agentes externos. Esta función corresponde principalmente a la piel y a sus estructuras asociadas, las cuales conforman el sistema tegumentario."}},{"type":"text","name":"El reconocimiento de las estructuras respiratorias orienta la apertura de la vía aérea, la valoración de la respiración y la aplicación de maniobras de desobstrucción en caso de OVACE. La identificación temprana de los signos de dificultad respiratoria y l","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":4768}}},"id":"fc6a7566-c245-42d8-99c9-4bc415ab4075","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10216,"ty":-6932},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":108,"x":0}],[{"y":39,"from":108,"to":219,"x":0}],[{"y":63,"from":219,"to":328,"x":0}],[{"y":87,"from":328,"to":435,"x":0}]]}],"rawText":"El reconocimiento de las estructuras respiratorias orienta la apertura de la vía aérea, la valoración de la respiración y la aplicación de maniobras de desobstrucción en caso de OVACE. La identificación temprana de los signos de dificultad respiratoria y la actuación oportuna son fundamentales, debido a que estas alteraciones pueden evolucionar rápidamente durante la primera infancia (Ministerio de Salud y Protección Social, 2018)."}},{"type":"group","name":"Enmascarar grupo 1119281","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 457025","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"109ae0a8-fcba-40bb-bde2-6ad9ab9c16c3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1121.7109375,"ty":2949},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":292,"height":241,"r":[10,10,10,10]}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":1819}}},"id":"4a806fc7-8953-40ad-a73e-2755e3d933ba","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10505.7109375,"ty":-9881},"group":{"children":[{"type":"shape","name":"Imagen 83","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":505.9384765625,"height":522}}},"id":"034b93a6-3fa1-4339-9ec6-8d6beafb9a8a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1119.7109375,"ty":2946},"style":{"fill":{"type":"pattern","pattern":{"width":756,"height":780,"meta":{"ux":{"scaleBehavior":"fill","uid":"ba2fb9469db92d74c8b813a04991fbb2","hrefLastModifiedDate":1785324952}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":295.9384765625,"height":305}}]}},{"type":"group","name":"Grupo 1184124","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":-129,"ty":2926}}},"id":"7861179d-4166-47ae-9aba-5368e89ecb1a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10634.7109375,"ty":-8774},"group":{"children