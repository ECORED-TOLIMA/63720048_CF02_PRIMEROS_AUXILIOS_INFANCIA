latorio con signos como palidez, piel fría, sangrado, pulso débil o llenado capilar prolongado. Durante una emergencia, estos hallazgos deben valorarse de forma conjunta para ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290.7109375,"ty":2690.3984375}}},"id":"fca29a84-db1c-4f8f-a197-a99f29d27f07","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10215,"ty":-9009.6015625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1019},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":141,"x":0}],[{"y":39,"from":141,"to":268,"x":0}],[{"y":63,"from":268,"to":362,"x":0}]]}],"rawText":"El reconocimiento de estas estructuras permite relacionar el funcionamiento circulatorio con signos como palidez, piel fría, sangrado, pulso débil o llenado capilar prolongado. Durante una emergencia, estos hallazgos deben valorarse de forma conjunta para identificar oportunamente un posible compromiso de la circulación y solicitar la atención correspondiente."}},{"type":"shape","name":"Rectángulo 457020","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":2787.3984375}}},"id":"ea8a7ccb-929e-4840-aa0c-b1bdca5cc354","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10216,"ty":-8912.6015625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":90,"r":[10,10,10,10]}},{"type":"text","name":"La siguiente figura representa la ubicación del corazón y la distribución general de los principales vasos sanguíneos. Su observación permite comprender cómo estas estructuras conforman una red que mantiene el recorrido de la sangre por el organismo.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":325.7109375,"ty":2807.3984375}}},"id":"e8e8de88-a201-444f-ade3-1c7bb660f858","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10180,"ty":-8892.6015625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":954},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":134,"x":0}],[{"y":39,"from":134,"to":250,"x":0}]]}],"rawText":"La siguiente figura representa la ubicación del corazón y la distribución general de los principales vasos sanguíneos. Su observación permite comprender cómo estas estructuras conforman una red que mantiene el recorrido de la sangre por el organismo."}},{"type":"text","name":"El adecuado funcionamiento del organismo depende de la acción coordinada de sus diferentes sistemas. En este proceso, la respiración cumple una función esencial al permitir la incorporación del oxígeno necesario para la vida y la eliminación del dióxido de","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":183.7109375,"ty":3604}}},"id":"801b0f35-4673-4230-9a45-5f756833d22a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10322,"ty":-8096},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1233},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":164,"x":0}],[{"y":39,"from":164,"to":317,"x":0}]]}],"rawText":"El adecuado funcionamiento del organismo depende de la acción coordinada de sus diferentes sistemas. En este proceso, la respiración cumple una función esencial al permitir la incorporación del oxígeno necesario para la vida y la eliminación del dióxido de carbono, aspectos que se abordan en el sistema respiratorio."}},{"type":"shape","name":"Rectángulo 457016","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":599.7109375,"ty":4034}}},"id":"738ddb95-4382-41e9-8687-2b519dafca2f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9906,"ty":-7666},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":110,"r":[10,10,10,10]}},{"type":"text","name":"Las estructuras respiratorias actúan de manera coordinada durante la entrada y salida del aire. Reconocer su función permite comprender el proceso respiratorio e identificar oportunamente posibles alteraciones. Sus principales componentes son los siguiente","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":635.7109375,"ty":4054}}},"id":"12ecd841-6632-426b-b0bd-a9576be275a0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9870,"ty":-7646},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":741},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":96,"x":0}],[{"y":39,"from":96,"to":197,"x":0}],[{"y":63,"from":197,"to":258,"x":0}]]}],"rawText":"Las estructuras respiratorias actúan de manera coordinada durante la entrada y salida del aire. Reconocer su función permite comprender el proceso respiratorio e identificar oportunamente posibles alteraciones. Sus principales componentes son los siguientes:"}},{"type":"text","name":"La respiración es un proceso esencial para mantener el funcionamiento del organismo, ya que permite incorporar el oxígeno que requieren las células y eliminar el dióxido de carbono que producen. En este proceso intervienen diferentes estructuras encargadas","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.7109375,"ty":3889}}},"id":"b586db7e-dba8-4e8c-b125-d047c7d1b79f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9904,"ty":-7811},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":809},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":111,"x":0}],[{"y":39,"from":111,"to":223,"x":0}],[{"y":63,"from":223,"to":331,"x":0}],[{"y":87,"from":331,"to":447,"x":0}],[{"y":111,"from":447,"to":514,"x":0}]]}],"rawText":"La respiración es un proceso esencial para mantener el funcionamiento del organismo, ya que permite incorporar el oxígeno que requieren las células y eliminar el dióxido de carbono que producen. En este proceso intervienen diferentes estructuras encargadas de conducir el aire y realizar el intercambio gaseoso. Durante la primera infancia, las vías aéreas son más estrechas y la frecuencia respiratoria es mayor; por ello, existe mayor riesgo de obstrucción y dificultad respiratoria (Tortora y Derrickson, 2021)."}},{"type":"group","name":"Enmascarar grupo 1119279","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 457017","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"1abb6000-ea5d-4a4e-bf33-8348b0f91b76","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":316},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"w