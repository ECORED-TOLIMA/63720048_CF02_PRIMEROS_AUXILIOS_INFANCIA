Width":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":9,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":145,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":11,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":173,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":14,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":166,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":11,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":152,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":336,"ty":5603.611328125}}},"id":"e23537da-a418-4faa-aacc-04772f2615dd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10169.7109375,"ty":-6096.388671875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":939},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":9,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":9,"to":131}],[{"y":39,"from":131,"to":152,"x":0}]]},{"lines":[[{"y":63,"from":153,"to":153,"x":0}]]},{"lines":[[{"y":87,"from":154,"to":165,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":87,"from":165,"to":279}],[{"y":111,"from":279,"to":336,"x":0}]]},{"lines":[[{"y":135,"from":337,"to":337,"x":0}]]},{"lines":[[{"y":159,"from":338,"to":352,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":159,"from":352,"to":461}],[{"y":183,"from":461,"to":516,"x":0}]]},{"lines":[[{"y":207,"from":517,"to":517,"x":0}]]},{"lines":[[{"y":231,"from":518,"to":529,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":231,"from":529,"to":644}],[{"y":255,"from":644,"to":681,"x":0}]]}],"rawText":"Heridas: producen una pérdida de continuidad de la piel. Por ejemplo, un raspón durante el juego puede ocasionar dolor, sangrado y riesgo de infección. \n\nQuemaduras: lesionan la piel por acción del calor, la electricidad, sustancias químicas u otros agentes. Por ejemplo, pueden producirse por el contacto accidental con agua caliente. \n\nIrritaciones: generan enrojecimiento, picazón o inflamación por contacto con sustancias o materiales. Por ejemplo, algunos productos de limpieza pueden irritar la piel infantil. \n\nColoración: comprende cambios como palidez, enrojecimiento o cianosis. Por ejemplo, una tonalidad azulada en los labios puede indicar una alteración respiratoria. "}},{"type":"shape","name":"Rectángulo 457040","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.7109375,"ty":6676}}},"id":"95e3315f-b351-47d9-91df-f83a5bd8ebcb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9904,"ty":-5024},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":230,"b":222}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":130}},{"type":"text","name":"Además de proteger al organismo frente a los agentes externos, el cuerpo necesita estructuras que le proporcionen soporte, estabilidad y movimiento. Estas funciones dependen de la acción coordinada de los huesos, los músculos y las articulaciones, componen","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":629.7109375,"ty":6706}}},"id":"a476112c-9644-4008-8121-0f2b53943121","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9876,"ty":-4994},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":757},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":101,"x":0}],[{"y":39,"from":101,"to":201,"x":0}],[{"y":63,"from":201,"to":291,"x":0}]]}],"rawText":"Además de proteger al organismo frente a los agentes externos, el cuerpo necesita estructuras que le proporcionen soporte, estabilidad y movimiento. Estas funciones dependen de la acción coordinada de los huesos, los músculos y las articulaciones, componentes del sistema musculoesquelético."}},{"type":"text","name":"Estas acciones contribuyen a proteger la zona afectada, disminuir el riesgo de infección y prevenir complicaciones. No deben aplicarse sustancias caseras, cremas ni otros productos sobre una quemadura, salvo indicación del personal de salud.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.7109375,"ty":6579}}},"id":"e2424678-9d43-4523-8aad-3458b908beb8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9904,"ty":-5121},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":100,"x":0}],[{"y":39,"from":100,"to":208,"x":0}],[{"y":63,"from":208,"to":241,"x":0}]]}],"rawText":"Estas acciones contribuyen a proteger la zona afectada, disminuir el riesgo de infección y prevenir complicaciones. No deben aplicarse sustancias caseras, cremas ni otros productos sobre una quemadura, salvo indicación del personal de salud."}},{"type":"group","name":"Enmascarar grupo 1119283","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 457041","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"189e7cc6-fbf5-472f-a943-2a43d5779e84","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185.6298828125,"ty":4035},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":396,"height":227,"r":[10,10,10,10]}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0.0810546875,"ty":2544}}},"id":"1d87d2dc-0c48-4a29-90c3-222ca1c85003","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10505.6298828125,"ty":-9156},"group":{"children":[{"type":"shape","name":"Imagen 112","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":948,"height":624}}},"id":"b897a32d-4bef-408e-adba-97e2064e6c1e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":185.6298828125,"ty":4025},"style":{"fill":{"type":"pattern","pattern":{"width":948,"height":624,"meta":{"ux":{"scaleBehavior":"fill","uid":"97d127e9bac8414669259b6816846878","hrefLastModifiedDate":0}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":396,"height":261}}]}},{"type":"text","name":"El movimiento corporal requiere la participación coordinada de diferentes estructuras que proporcionan soporte, estabilidad y protección. Durante la primera infancia, estas estructuras se encuentran en crecimiento y favorecen el desarrollo de habilidades c","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":7048}}},"id":"f6e3cbbd-d649-4034-830b-5d3dfe64745f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10320,"ty":-4652},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":126,"x":0}],[{"y":39,"from":126,"to":255,"x":0}],[{"y":63,"from":255,"to":304,"x":0}]]}],"rawText":"El movimiento corporal requiere la participación coordinada de diferentes estructuras que proporcionan soporte, estabilidad y protección. Durante la primera infancia, estas estructuras se encuentran en crecimiento y favorecen el desarrollo de habilidades como caminar, correr, saltar y manipular objetos."}},{"type":"text","name":"La valoración inicial permite reconocer alteraciones relacionadas con el dolor, la inflamación, la deformidad o la limitación del movimiento. Las lesiones musculoesqueléticas más frecuentes se describen a continuación:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":7315}}},"id":"7ee54a5f-8b3c-41f8-9549-606ca9efcbda","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10320,"ty":-4385},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":155,"x":0}],[{"y":39,"from":155,"to":218,"x":0}]]}],"rawText":"La valoración inicial permite reconocer alteraciones relacionadas con el dolor, la inflamación, la deformidad o la limitación del movimiento. Las lesiones musculoesqueléticas más frecuentes se describen a continuación:"}},{"type":"text","name":"La presencia de dolor intenso, deformidad, inflamación progresiva o incapacidad para mover una extremidad puede indicar una lesión que requiere atención especializada. La zona afectada debe mantenerse en reposo y en la posición encontrada, evitando movimie","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":7776}}},"id":"e557cf43-58dd-4855-b123-7972af460923","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10320,"ty":-3924},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":168,"x":0}],[{"y":39,"from":168,"to":288,"x":0}]]},{"lines":[[{"y":63,"from":289,"to":289,"x":0}]]},{"lines":[[{"y":87,"from":290,"to":406,"x":0}]]}],"rawText":"La presencia de dolor intenso, deformidad, inflamación progresiva o incapacidad para mover una extremidad puede indicar una lesión que requiere atención especializada. La zona afectada debe mantenerse en reposo y en la posición encontrada, evitando movimientos que puedan agravar el daño.\n\nCuando se sospecha una lesión musculoesquelética, la atención inicial debe seguir una secuencia organizada y segura:"}},{"type":"shape","name":"Trazado 1008627","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":7145}}},"id":"335b5530-00c3-401a-b701-b2a7b26da125","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10320,"ty":-4555},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 916.2890625 0 L 916.2890625 140 L 0 140 L 0 0 Z"}},{"type":"shape","name":"Rectángulo 457042","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":7145}}},"id":"71f767ec-aa77-4c45-bf1c-4e0457ad8bc8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10319.7109375,"ty":-4555},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":25,"height":8}},{"type":"text","name":"El sistema musculoesquelético está constituido por huesos, músculos, articulaciones, ligamentos y tendones. Los huesos brindan soporte y protegen los órganos internos, mientras que los músculos y las articulaciones permiten el movimiento (Tortora y Derrick","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":217.7109375,"ty":7170}}},"id":"124d4fa9-1b93-4134-b31f-c637eb932d95","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10288,"ty":-4530},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":853},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":112,"x":0}],[{"y":39,"from":112,"to":227,"x":0}],[{"y":63,"from":227,"to":344,"x":0}],[{"y":87,"from":344,"to":377,"x":0}]]}],"rawText":"El sistema musculoesquelético está constituido por huesos, músculos, articulaciones, ligamentos y tendones. Los huesos brindan soporte y protegen los órganos internos, mientras que los músculos y las articulaciones permiten el movimiento (Tortora y Derrickson, 2021). Aunque los huesos infantiles presentan mayor flexibilidad, las caídas y los golpes pueden ocasionar lesiones."}},{"type":"group","name":"Grupo 1184173","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":-454}}},"id":"c6c4a70c-af8f-4e68-908a-906df5aa12ee","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10505.7109375,"ty":-12154},"group":{"children":[{"type":"shape","name":"Rectángulo 456450","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"1c5f763f-6f4b-4f42-abce-7718f89849dd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1121.7109375,"ty":7526},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,