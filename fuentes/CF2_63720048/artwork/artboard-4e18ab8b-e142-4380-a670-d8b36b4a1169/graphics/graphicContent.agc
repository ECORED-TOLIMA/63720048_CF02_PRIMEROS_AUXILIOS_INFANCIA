":0}]]},{"lines":[[{"y":135,"from":296,"to":296,"x":0}]]},{"lines":[[{"y":159,"from":297,"to":329,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":159,"from":329,"to":411}],[{"y":183,"from":411,"to":433,"x":0}]]},{"lines":[[{"y":207,"from":434,"to":434,"x":0}]]},{"lines":[[{"y":231,"from":435,"to":468,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":231,"from":468,"to":564}],[{"y":255,"from":564,"to":579,"x":0}]]},{"lines":[[{"y":279,"from":580,"to":580,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}}]]},{"lines":[[{"y":303,"from":581,"to":615,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":303,"from":615,"to":703}],[{"y":327,"from":703,"to":775,"x":0}]]}],"rawText":"Comprobar la seguridad del lugar: verificar que no persistan riesgos asociados con la caída, el golpe o el objeto que produjo la lesión. \n\nObservar la zona afectada: identificar dolor, inflamación, heridas, deformidad, cambio de coloración o limitación del movimiento, sin forzar la extremidad. \n\nEvitar movimientos innecesarios: mantener la zona en la posición encontrada y solicitar a la persona afectada que permanezca en reposo. \n\nInmovilizar cuando sea necesario: estabilizar la extremidad sin intentar enderezarla ni devolver los huesos o las articulaciones a su posición. \n\nSolicitar atención especializada: activar el servicio de emergencias ante deformidad, dolor intenso, sangrado, pérdida de sensibilidad o sospecha de lesión en la cabeza, el cuello o la columna. "}},{"type":"text","name":"Proteger: verificar la seguridad del lugar y evitar que la persona afectada, el primer respondiente u otras personas se expongan a nuevos riesgos.\n\nValorar: comprobar la respuesta, la respiración, la presencia de hemorragias graves y otros signos visibles ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintH