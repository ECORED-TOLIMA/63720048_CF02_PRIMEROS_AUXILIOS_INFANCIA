,"textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":528.7109375,"ty":5380}}},"id":"3eb88e9e-284d-4472-bd7c-d86405c7a92f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9977,"ty":-6320},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":849},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":113,"x":0}],[{"y":39,"from":113,"to":232,"x":0}],[{"y":63,"from":232,"to":348,"x":0}]]}],"rawText":"El sistema tegumentario está conformado por la piel y sus estructuras asociadas, como el cabello, las uñas y las glándulas. La piel se organiza en tres capas principales: epidermis, dermis e hipodermis (Tortora y Derrickson, 2021). Durante la primera infancia, es más delgada, sensible y vulnerable, por lo que puede lesionarse con mayor facilidad."}},{"type":"shape","name":"Rectángulo 457027","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":5575.611328125}}},"id":"06e19970-5ac4-4e59-bcea-5d3354a45ee6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10215.7109375,"ty":-6124.388671875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":317}},{"type":"shape","name":"heart-solid-full","id":"fcd1ed04-3b4f-41bf-a287-f7a3b28a09aa","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10259.421875,"ty":-6190.388671875},"meta":{"ux":{"hasCustomName":true,"hasNameFromExternalSource":true,"aspectLock":{"width":125.2734375,"height":109.6142578125},"constraintWidth":true,"constraintHeight":true