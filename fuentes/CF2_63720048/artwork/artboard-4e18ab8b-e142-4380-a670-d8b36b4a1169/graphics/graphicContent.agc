:39,"from":114,"to":230,"x":0}],[{"y":63,"from":230,"to":352,"x":0}],[{"y":87,"from":352,"to":407,"x":0}]]}],"rawText":"La circulación sanguínea comprende dos recorridos relacionados. En la circulación pulmonar, la sangre se desplaza desde el corazón hacia los pulmones, donde libera dióxido de carbono y recibe oxígeno antes de regresar al corazón. En la circulación sistémica, la sangre oxigenada sale del corazón, llega a los diferentes órganos y tejidos y retorna con menor cantidad de oxígeno (Tortora y Derrickson, 2021)."}},{"type":"group","name":"Grupo 1181593","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":2500}}},"id":"266112a1-b07a-43cf-83f3-d17f5e12d0d4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10505.7109375,"ty":-9200},"group":{"children":[{"type":"shape","name":"Rectángulo 409074","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true}},"id":"239562f3-9ef3-48c8-a12f-489df5c08b59","transform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":416},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":5,"height":28}},{"type":"text","name":"Figura 1. Sistema circulatorio en la primera infancia","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":10,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":43,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing