,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":11,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":136,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":354.7109375,"ty":9845}}},"id":"ea85b569-08fb-4217-8588-aa293362527c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10151,"ty":-1855},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":593},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":10,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":10,"to":87}],[{"y":39,"from":87,"to":146,"x":0}]]},{"lines":[[{"y":63,"from":147,"to":147,"x":0}]]},{"lines":[[{"y":87,"from":148,"to":157,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":87,"from":157,"to":225}],[{"y":111,"from":225,"to":297,"x":0}]]},{"lines":[[{"y":135,"from":298,"to":298,"x":0}]]},{"lines":[[{"y":159,"from":299,"to":308,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":159,"from":308,"to":378}],[{"y":183,"from":378,"to":448,"x":0}]]},{"lines":[[{"y":207,"from":449,"to":449,"x":0}]]},{"lines":[[{"y":231,"from":450,"to":459,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":231,"from":459,"to":527}],[{"y":255,"from":527,"to":603,"x":0}]]},{"lines":[[{"y":279,"from":604,"to":604,"x":0}]]},{"lines":[[{"y":303,"from":605,"to":616,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":303,"from":616,"to":686}],[{"y":327,"from":686,"to":752,"x":0}]]}],"rawText":"Proteger: verificar la seguridad del lugar y evitar que la persona afectada, el primer respondiente u otras personas se expongan a nuevos riesgos.\n\nValorar: comprobar la respuesta, la respiración, la presencia de hemorragias graves y otros signos visibles que puedan indicar una situación crítica.\n\nAlertar: comunicarse con el servicio de emergencias y proporcionar información clara sobre el lugar, la situación y el estado de la persona afectada.\n\nAtender: aplicar únicamente las técnicas de primeros auxilios conocidas, sin realizar procedimientos que superen la preparación del primer respondiente. \n\nAcompañar: observar los cambios en el estado de la persona, conservar la calma y permanecer a su lado hasta la llegada del personal especializado. "}},{"type":"shape","name":"Rectángulo 457048","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319.7109375,"ty":7923}}},"id":"b773b837-6ca9-4dc8-bee2-3032ca025919","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10186,"ty":-3777},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 457057","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319.7109375,"ty":9845}}},"id":"19348ca8-b480-49ee-855a-6d707928770c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10186,"ty":-1855},"st