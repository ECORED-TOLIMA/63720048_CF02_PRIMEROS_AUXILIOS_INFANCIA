r":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":253},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":33,"x":0}],[{"y":39,"from":33,"to":67,"x":0}],[{"y":63,"from":67,"to":99,"x":0}],[{"y":87,"from":99,"to":132,"x":0}],[{"y":111,"from":132,"to":156,"x":0}],[{"y":135,"from":156,"to":190,"x":0}],[{"y":159,"from":190,"to":223,"x":0}],[{"y":183,"from":223,"to":247,"x":0}]]}],"rawText":"Vasos sanguíneos que retornan la sangre desde los tejidos hacia el corazón. Este recorrido permite que la sangre con menor cantidad de oxígeno sea dirigida posteriormente hacia los pulmones para participar nuevamente en el proceso de oxigenación. "}},{"type":"text","name":"Corresponde a la ruptura parcial o total de un hueso. Por ejemplo, puede presentarse después de una caída y causar dolor, inflamación o deformidad. ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":368,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":829.7109375,"ty":7600.943359375}}},"id":"b72c2d60-3c40-4c9d-ac10-3c3448dd9d69","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9676,"ty":-4099.056640625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":253},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":35,"x":0}],[{"y":39,"from":35,"to":67,"x":0}],[{"y":63,"from":67,"to":100,"x":0}],[{"y":87,"from":100,"to":136,"x":0}],[{"y":111,"from":136,"to":148,"x":0}]]}],"rawText":"Corresponde a la ruptura parcial o total de un hueso. Por ejemplo, puede presentarse después de una caída y causar dolor, inflamación o deformidad. "}},{"type":"text","name":"Vasos sanguíneos microscópicos que conectan las ramificaciones más pequeñas de las arterias y las venas. En ellos se produce el intercambio de oxígeno, nutrientes y sustancias de desecho entre la sangre y los diferentes tejidos. ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":368,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1141.7109375,"ty":2416.341796875}}},"id":"1567cb6f-7ac9-4fd6-b97a-633c92e6e67d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9364,"ty":-9283.658203125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":253},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":31,"x":0}],[{"y":39,"from":31,"to":63,"x":0}],[{"y":63,"from":63,"to":98,"x":0}],[{"y":87,"from":98,"to":128,"x":0}],[{"y":111,"from":128,"to":163,"x":0}],[{"y":135,"from":163,"to":196,"x":0}],[{"y":159,"from":196,"to":229,"x":0}]]}],"rawText":"Vasos sanguíneos microscópicos que conectan las ramificaciones más pequeñas de las arterias y las venas. En ellos se produce el intercambio de oxígeno, nutrientes y sustancias de desecho entre la sangre y los diferentes tejidos. "}},{"type":"text","name":"Se produce por un golpe que lesiona los tejidos sin romper la piel. Por ejemplo, puede ocasionar dolor, inflamación y cambio de coloración. ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":368,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1141.7109375,"ty":7600.943359375}}},"id":"fe248872-c988-41c6-b218-77fd7e08a3ad","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-9364,"ty":-4099.056640625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":253},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":28,"x":0}],[{"y":39,"from":28,"to":62,"x":0}],[{"y":63,"from":62,"to":97,"x":0}],[{"y":87,"from":97,"to":128,"x":0}],[{"y":111,"from":128,"to":140,"x":0}]]}],"rawText":"Se produce por un golpe que lesiona los tejidos sin romper la piel. Por ejemplo, puede ocasionar dolor, inflamación y cambio de coloración. "}},{"type":"text","name":"Corazón","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":16,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":18,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":203.7109375,"ty":2379.310546875}}},"id":"764e9556-fba6-4ef7-a52f-433fc7d54c36","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-10302,"ty":-9320.