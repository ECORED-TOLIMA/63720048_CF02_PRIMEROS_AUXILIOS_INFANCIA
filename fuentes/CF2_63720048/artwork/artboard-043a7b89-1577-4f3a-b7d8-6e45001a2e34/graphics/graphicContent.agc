scriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":34}},"text":{"frame":{"type":"autoHeight","width":608},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":69,"x":0}]]},{"lines":[[{"y":49,"from":70,"to":126,"x":0}]]},{"lines":[[{"y":83,"from":127,"to":214,"x":0}]]},{"lines":[[{"y":117,"from":215,"to":294,"x":0}]]},{"lines":[[{"y":151,"from":295,"to":362,"x":0}]]}],"rawText":"No colocar los parches sobre ropa, piel mojada ni objetos metálicos. \nNo permitir que los parches se toquen o se superpongan. \nNo tocar al lactante, la niña o el niño durante el análisis ni al aplicar la descarga. \nNo retirar los parches ni apagar el dispositivo mientras continúa la atención. \nReducir al mínimo las interrupciones de las compresiones torácicas."}},{"type":"shape","name":"Rectángulo 457115","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319.7109375,"ty":7001}}},"id":"a409b696-081c-4551-8159-682a1938117c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4178,"ty":-4699},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 457116","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319.7109375,"ty":7034}}},"id":"0fed01e7-4390-4e4d-a2ad-59fd4dfb9881","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4178,"ty":-4666},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}}