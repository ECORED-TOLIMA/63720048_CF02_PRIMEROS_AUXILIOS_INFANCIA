2423095703125 49.43857574462891 C 34.52423095703125 49.817138671875 34.21823120117188 50.12313842773438 33.83966445922852 50.12313842773438 L 32.63345718383789 50.12313842773438 L 30.64753341674805 53.80609893798828 C 30.52568054199219 54.03132629394531 30.29224395751953 54.16549682617188 30.04511642456055 54.16549682617188 Z"}}]}}]}},{"type":"text","name":"La reanimación cardiopulmonar (RCP) en lactantes es una técnica de soporte vital básico que se aplica cuando el lactante no responde y no respira normalmente o solo jadea. Su finalidad es mantener temporalmente la circulación sanguínea y el aporte de oxíge","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":1213}}},"id":"3034b354-6a0b-40a2-b4c8-49ced716873d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-10487},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":124,"x":0}],[{"y":39,"from":124,"to":248,"x":0}],[{"y":63,"from":248,"to":362,"x":0}],[{"y":87,"from":362,"to":491,"x":0}],[{"y":111,"from":491,"to":537,"x":0}]]}],"rawText":"La reanimación cardiopulmonar (RCP) en lactantes es una técnica de soporte vital básico que se aplica cuando el lactante no responde y no respira normalmente o solo jadea. Su finalidad es mantener temporalmente la circulación sanguínea y el aporte de oxígeno a los órganos vitales mientras llega la atención especializada. Durante el primer año de vida, el paro cardiorrespiratorio suele estar relacionado con alteraciones respiratorias; por ello, se requiere una actuación rápida, segura y organizada (American Heart Association, 2020)."}},{"type":"text","name":"Para realizar el procedimiento, se deben seguir estas acciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":1503}}},"id":"ac10a66b-b867-4d16-a5e3-499eed460f86","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-10197},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":63,"x":0}]]}],"rawText":"Para realizar el procedimiento, se deben seguir estas acciones:"}},{"type":"text","name":"Antes de iniciar la RCP, se debe verificar la seguridad del entorno y valorar la respuesta y la respiración del lactante. Si no responde y no respira normalmente, se debe solicitar ayuda, activar el sistema de emergencias mediante la línea 123 e iniciar la","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":223.7109375,"ty":1385}}},"id":"26f4a8f4-ba64-4f2d-b139-8a91019c6bd2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4274,"ty":-10315},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":840},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":125,"x":0}],[{"y":39,"from":125,"to":240,"x":0}],[{"y":63,"from":240,"to":324,"x":0}]]}],"rawText":"Antes de iniciar la RCP, se debe verificar la seguridad del entorno y valorar la respuesta y la respiración del lactante. Si no responde y no respira normalmente, se debe solicitar ayuda, activar el sistema de emergencias mediante la línea 123 e iniciar las maniobras de reanimación, de acuerdo con la capacitación recibida."}},{"type":"shape","name":"Trazado 1008634","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":3598.9130859375}}},"id":"0714ab69-7c8d-4918-8060-aea785437d87","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4207.7109375,"ty":-8101.0869140625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 1020.000061035156 0 L 1020.000061035156 120 L 0 120 L 0 0 Z"}},{"type":"shape","name":"Trazado 1008636","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":5814}}},"id":"4bffed07-ede3-48a1-856c-307666c682af","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4207.7109375,"ty":-5886},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 1020.000061035156 0 L 1020.000061035156 120 L 0 120 L 0 0 Z"}},{"type":"shape","name":"Trazado 1008635","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":4283}}},"id":"62464ca7-c686-49da-9475-5d74b1f0b80c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4207.7109375,"ty":-7417},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 1019.999938964844 0 L 1019.999938964844 170.73828125 L 0 170.73828125 L 0 0 Z"}},{"type":"shape","name":"Rectángulo 457090","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290.2890625,"ty":3598.9130859375}}},"id":"047c26ea-7d37-4a15-871a-6324058f0ea5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4207.421875,"ty":-8101.0869140625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":25,"height":8}},{"type":"shape","name":"Rectángulo 457111","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290.2890625,"ty":5814}}},"id":"dc5c1009-bc86-4fa7-b48e-7b23f96c9f42","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4207.421875,"ty":-5886},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":25,"height":8}},{"type":"text","name":"La aplicación ordenada de estas acciones contribuye a mantener la circulación sanguínea y el aporte de oxígeno durante la emergencia. Las maniobras deben adaptarse al tamaño y a las condiciones físicas de la niña o del niño, sin aplicar una fuerza excesiva","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":316,"ty":3625.9130859375}}},"id":"45c4849a-9419-4172-9bc3-1092e197e0be","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4181.7109375,"ty":-8074.0869140625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":956.7109375},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":122,"x":0}],[{"y":39,"from":122,"to":248,"x":0}],[{"y":63,"from":248,"to":299,"x":0}]]}],"rawText":"La aplicación ordenada de estas acciones contribuye a mantener la circulación sanguínea y el aporte de oxígeno durante la emergencia. Las maniobras deben adaptarse al tamaño y a las condiciones físicas de la niña o del niño, sin aplicar una fuerza excesiva y de acuerdo con la capacitación recibida."}},{"type":"text","name":"Después de reconocer las acciones para atender una obstrucción de la vía aérea, es importante abordar el uso del desfibrilador externo automático como apoyo durante la reanimación cardiopulmonar. En el siguiente apartado, se explica su función y las princi","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":316,"ty":5841}}},"id":"f10d1146-c344-44e6-b272-a43904a9281c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4181.7109375,"ty":-5859},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":956.7109375},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":127,"x":0}],[{"y":39,"from":127,"to":250,"x":0}],[{"y":63,"from":250,"to":339,"x":0}]]}],"rawText":"Después de reconocer las acciones para atender una obstrucción de la vía aérea, es importante abordar el uso del desfibrilador externo automático como apoyo durante la reanimación cardiopulmonar. En el siguiente apartado, se explica su función y las principales recomendaciones para utilizarlo de manera segura en lactantes, niñas y niños."}},{"type":"text","name":"Obstrucción parcial: la niña o el niño puede toser con fuerza, emitir sonidos, respirar y responder. En este caso, se debe permitir que continúe tosiendo, observar su evolución y evitar maniobras innecesarias. \n\nObstrucción total: la niña o el niño no pued","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":21,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":191,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":19,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":197,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":337,"ty":4311}}},"id":"4dfcc3f5-e897-4b06-b07d-d2a5327953d5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4160.7109375,"ty":-7389},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":941},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":21,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":21,"to":136}],[{"y":39,"from":136,"to":210,"x":0}]]},{"lines":[[{"y":63,"from":211,"to":211,"x":0}]]},{"lines":[[{"y":87,"from":212,"to":231,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":87,"from":231,"to":349}],[{"y":111,"from":349,"to":428,"x":0}]]}],"rawText":"Obstrucción parcial: la niña o el niño puede toser con fuerza, emitir sonidos, respirar y responder. En este caso, se debe permitir que continúe tosiendo, observar su evolución y evitar maniobras innecesarias. \n\nObstrucción total: la niña o el niño no puede hablar, llorar, toser eficazmente ni respirar. También puede llevarse las manos al cuello, presentar coloración azulada alrededor de los labios o perder el conocimiento. "}},{"type":"shape","name":"Rectángulo 455047","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":4164}}},"id":"f01af52d-1be4-410f-8dd2-b4338f779050","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-7536},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":396,"height":50,"r":[25,25,25,25]}},{"type":"shape","name":"Rectángulo 457092","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":4579}}},"id":"158b3cf8-e613-4257-8814-9a21fbd9fd0e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-7121},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":489,"height":50,"r":[25,25,25,25]}},{"type":"shape","name":"Rectángulo 457099","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":5267}}},"id":"6fc76302-d509-4f4c-9259-81946a9e0fea","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-6433},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width