cing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":811},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":113,"x":0}],[{"y":39,"from":113,"to":221,"x":0}],[{"y":63,"from":221,"to":325,"x":0}],[{"y":87,"from":325,"to":350,"x":0}]]}],"rawText":"El soporte vital básico corresponde al conjunto de acciones inmediatas orientadas a mantener la oxigenación y la circulación en una persona que presenta una alteración grave de sus funciones vitales. Estas intervenciones buscan preservar la vida hasta la llegada de atención especializada, mediante la aplicación de técnicas estandarizadas y seguras."}},{"type":"shape","name":"Rectángulo 456415","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.7109375,"ty":437}}},"id":"582eb54d-17c3-40e6-98a9-fe8fb973fa39","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3896,"ty":-11263},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":160,"r":[10,10,10,10]}},{"type":"text","name":"En la primera infancia, el soporte vital básico adquiere especial relevancia debido a la mayor vulnerabilidad de niñas y niños frente a eventos como la obstrucción de la vía aérea, la insuficiencia respiratoria y el paro cardiorrespiratorio. Estas situacio","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":741.7109375,"ty":460}}},"id":"ed23499c-ccee-42a2-b4f6-e1c7ec36cb95","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3756,"ty":-11240},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":657},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":95,"x":0}],[{"y":39,"from":95,"to":184,"x":0}],[{"y":63,"from":184,"to":279,"x":0}],[{"y":87,"from":279,"to":364,"x":0}],[{"y":111,"from":364,"to":384,"x":0}]]}],"rawText":"En la primera infancia, el soporte vital básico adquiere especial relevancia debido a la mayor vulnerabilidad de niñas y niños frente a eventos como la obstrucción de la vía aérea, la insuficiencia respiratoria y el paro cardiorrespiratorio. Estas situaciones pueden evolucionar rápidamente, por lo que requieren una intervención oportuna y adecuada por parte del primer respondiente."}},{"type":"shape","name":"Rectángulo 456431","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":1548}}},"id":"6732d944-1a7f-4f9b-b51e-1f18f7bc01a9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4208,"ty":-10152},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":629}},{"type":"shape","name":"Rectángulo 457079","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":2954}}},"id":"618086bb-18f5-42ff-bba5-a7f8e1b74b17","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4208,"ty":-8746},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":610}},{"type":"text","name":"Verificar la seguridad: comprobar que el lugar no represente peligro para el lactante ni para quien brinda la atención. \n\nValorar la respuesta: estimular suavemente al lactante y observar si responde mediante movimientos, sonidos o gestos. \n\nObservar la re","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":24,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":1449,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":354.7109375,"ty":1575}}},"id":"68b03a6e-73af-4a9a-b32a-d9d596d1c511","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4143,"ty":-10125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":913},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":24,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":24,"to":120}]]},{"lines":[[{"y":39,"from":121,"to":121,"x":0}]]},{"lines":[[{"y":63,"from":122,"to":240,"x":0}]]},{"lines":[[{"y":87,"from":241,"to":241,"x":0}]]},{"lines":[[{"y":111,"from":242,"to":360,"x":0}]]},{"lines":[[{"y":135,"from":361,"to":361,"x":0}]]},{"lines":[[{"y":159,"from":362,"to":474,"x":0}]]},{"lines":[[{"y":183,"from":475,"to":475,"x":0}]]},{"lines":[[{"y":207,"from":476,"to":583,"x":0}]]},{"lines":[[{"y":231,"from":584,"to":584,"x":0}]]},{"lines":[[{"y":255,"from":585,"to":711,"x":0}],[{"y":279,"from":711,"to":761,"x":0}]]},{"lines":[[{"y":303,"from":762,"to":762,"x":0}]]},{"lines":[[{"y":327,"from":763,"to":886,"x":0}],[{"y":351,"from":886,"to":897,"x":0}]]},{"lines":[[{"y":375,"from":898,"to":898,"x":0}]]},{"lines":[[{"y":399,"from":899,"to":1022,"x":0}],[{"y":423,"from":1022,"to":1049,"x":0}]]},{"lines":[[{"y":447,"from":1050,"to":1050,"x":0}]]},{"lines":[[{"y":471,"from":1051,"to":1168,"x":0}],[{"y":495,"from":1168,"to":1268,"x":0}]]},{"lines":[[{"y":519,"from":1269,"to":1269,"x":0}]]},{"lines":[[{"y":543,"from":1270,"to":1396,"x":0}],[{"y":567,"from":1396,"to":1473,"x":0}]]}],"rawText":"Verificar la seguridad: comprobar que el lugar no represente peligro para el lactante ni para quien brinda la atención. \n\nValorar la respuesta: estimular suavemente al lactante y observar si responde mediante movimientos, sonidos o gestos. \n\nObservar la respiración: verificar si respira normalmente o solo jadea, sin prolongar innecesariamente la valoración. \n\nSolicitar ayuda: pedir apoyo a las personas cercanas y activar el sistema de emergencias mediante la línea 123. \n\nUbicar al lactante: colocarlo boca arriba sobre una superficie firme y plana para facilitar las maniobras. \n\nIniciar las compresiones: comprimir el centro del pecho, sobre el esternón, con el talón de una mano o mediante la técnica de los dos pulgares con las manos rodeando el tórax. \n\nAplicar la profundidad adecuada: comprimir aproximadamente un tercio del diámetro anteroposterior del tórax, equivalente a unos 4 cm. \n\nMantener el ritmo: realizar entre 100 y 120 compresiones por minuto, permitir la expansión completa del tórax y reducir al mínimo las interrupciones. \n\nCombinar compresiones y ventilaciones: realizar ciclos de 30 compresiones y 2 ventilaciones cuando participa un solo reanimador, o de 15 compresiones y 2 ventilaciones cuando intervienen dos reanimadores capacitados. \n\nContinuar las maniobras: mantener la RCP hasta que el lactante muestre signos de respuesta, llegue el personal especializado, el entorno deje de ser seguro o quien brinda la atención no pueda continuar. "}},{"type":"text","name":"Verificar la seguridad: comprobar que el lugar no represente peligro para la niña, el niño ni para quien brinda la atención. \n\nValorar la respuesta: estimular suavemente a la niña o al niño y observar si responde mediante movimientos, sonidos o gestos. \n\nO","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":23,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":1469,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":354.7109375,"ty":2981}}},"id":"7eb5a090-5238-4fcb-a4f0-ca307c3c8754","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4143,"ty":-8719},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":913},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":23,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":23,"to":125}]]},{"lines":[[{"y":39,"from":126,"to":126,"x":0}]]},{"lines":[[{"y":63,"from":127,"to":253,"x":0}]]},{"lines":[[{"y":87,"from":254,"to":254,"x":0}]]},{"lines":[[{"y":111,"from":255,"to":373,"x":0}]]},{"lines":[[{"y":135,"from":374,"to":374,"x":0}]]},{"lines":[[{"y":159,"from":375,"to":487,"x":0}]]},{"lines":[[{"y":183,"from":488,"to":488,"x":0}]]},{"lines":[[{"y":207,"from":489,"to":604,"x":0}]]},{"lines":[[{"y":231,"from":605,"to":605,"x":0}]]},{"lines":[[{"y":255,"from":606,"to":734,"x":0}],[{"y":279,"from":734,"to":794,"x":0}]]},{"lines":[[{"y":303,"from":795,"to":795,"x":0}]]},{"lines":[[{"y":327,"from":796,"to":911,"x":0}]]},{"lines":[[{"y":351,"from":912,"to":912,"x":0}]]},{"lines":[[{"y":375,"from":913,"to":1037,"x":0}],[{"y":399,"from":1037,"to":1053,"x":0}]]},{"lines":[[{"y":423,"from":1054,"to":1054,"x":0}]]},{"lines":[[{"y":447,"from":1055,"to":1172,"x":0}],[{"y":471,"from":1172,"to":1272,"x":0}]]},{"lines":[[{"y":495,"from":1273,"to":1273,"x":0}]]},{"lines":[[{"y":519,"from":1274,"to":1391,"x":0}],[{"y":543,"from":1391,"to":1482,"x":0}]]}],"rawText":"Verificar la seguridad: comprobar que el lugar no represente peligro para la niña, el niño ni para quien brinda la atención. \n\nValorar la respuesta: estimular suavemente a la niña o al niño y observar si responde mediante movimientos, sonidos o gestos. \n\nObservar la respiración: verificar si respira normalmente o solo jadea, sin prolongar innecesariamente la valoración. \n\nSolicitar ayuda: pedir apoyo a las personas cercanas y activar el sistema de emergencias mediante la línea 123. \n\nUbicar a la niña o al niño: colocarlo boca arriba sobre una superficie firme y plana para facilitar las maniobras. \n\nPosicionar las manos: ubicar el talón de una mano en el centro del pecho, sobre la mitad inferior del esternón. Según el tamaño de la niña o del niño, se puede utilizar una o ambas manos. \n\nAplicar las compresiones: comprimir el tórax aproximadamente un tercio de su profundidad, equivalente a unos 5 cm. \n\nMantener el ritmo: realizar entre 100 y 120 compresiones por minuto, permitir la expansión completa del tórax y reducir las interrupciones. \n\nCombinar compresiones y ventilaciones: realizar ciclos de 30 compresiones y 2 ventilaciones cuando participa un solo reanimador, o de 15 compresiones y 2 ventilaciones cuando intervienen dos reanimadores capacitados. \n\nContinuar las maniobras: mantener la RCP hasta que la niña o el niño muestre signos de respuesta, llegue el personal especializado, el entorno deje de ser seguro o quien brinda la atención no pueda continuar."}},{"type":"shape","name":"Rectángulo 454410","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319.7109375,"ty":1575}}},"id":"22b83e76-a5ba-4acf-8105-7812c28d00e4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4178,"ty":-10125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 457080","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319.7109375,"ty":2981}}},"id":"d0510cb5-6bfc-4931-bbe6-f4294a1a9004","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4178,"ty":-8719},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 456451","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319.7109375,"ty":1620}}},"id":"5a2a91fe-d465-4011-ad43-2a96bcd9c5c3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4