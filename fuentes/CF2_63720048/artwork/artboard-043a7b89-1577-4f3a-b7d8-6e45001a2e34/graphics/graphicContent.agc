ionar las manos: formar un puño y ubicarlo por encima del ombligo y por debajo de","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":17,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":522,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":333.7109375,"ty":5400}}},"id":"93688144-b5e8-4043-b09b-1db5e04fd34c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4164,"ty":-6300},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":611},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":17,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":17,"to":74}]]},{"lines":[[{"y":39,"from":75,"to":75,"x":0}]]},{"lines":[[{"y":63,"from":76,"to":160,"x":0}],[{"y":87,"from":160,"to":168,"x":0}]]},{"lines":[[{"y":111,"from":169,"to":169,"x":0}]]},{"lines":[[{"y":135,"from":170,"to":254,"x":0}],[{"y":159,"from":254,"to":303,"x":0}]]},{"lines":[[{"y":183,"from":304,"to":304,"x":0}]]},{"lines":[[{"y":207,"from":305,"to":387,"x":0}],[{"y":231,"from":387,"to":395,"x":0}]]},{"lines":[[{"y":255,"from":396,"to":396,"x":0}]]},{"lines":[[{"y":279,"from":397,"to":483,"x":0}],[{"y":303,"from":483,"to":539,"x":0}]]}],"rawText":"Solicitar ayuda: activar el sistema de emergencias mediante la línea 123. \n\nUbicarse detrás: colocarse detrás de la niña o del niño y rodear su cintura con los brazos. \n\nPosicionar las manos: formar un puño y ubicarlo por encima del ombligo y por debajo del esternón; luego, sujetarlo con la otra mano. \n\nAplicar compresiones abdominales: realizar impulsos rápidos hacia adentro y hacia arriba. \n\nContinuar la atención: repetir las compresiones hasta que el objeto sea expulsado, la niña o el niño vuelva a respirar o pierda la respuesta. "}},{"type":"group","name":"Enmascarar grupo 1119289","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintWidth":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 457110","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"6c861491-961f-4829-9372-7068a2382d34","transform":{"a":1,"b":0,"c":0,"d":1,"tx":997.7109375,"ty":4217},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":282,"height":303,"r":[10,10,10,10]}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":1187}}},"id":"c7fb74a6-8b70-493b-8772-a9b112ed2c04","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4497.7109375,"ty":-10513},"group":{"children":[{"type":"shape","name":"Imagen 125","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":500,"height":333}}},"id":"a7aa9893-3bc6-4337-b549-052a3b842ab4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":933.7109375,"ty":4217},"style":{"fill":{"type":"pattern","pattern":{"width":500,"height":333,"meta":{"ux":{"scaleBehavior":"fill","uid":"7fe112d12d69f9df12e5d52f9898352e","hrefLastModifiedDate":0}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":455,"height":303}}]}},{"type":"shape","name":"heart-solid-full","id":"4a1c4ddb-acc5-4a1c-b470-f202f07