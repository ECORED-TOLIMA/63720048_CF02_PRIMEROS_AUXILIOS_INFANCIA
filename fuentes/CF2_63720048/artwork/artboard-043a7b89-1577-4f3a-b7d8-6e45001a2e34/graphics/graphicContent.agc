e,"hasNameFromExternalSource":true,"aspectLock":{"width":125.2734375,"height":109.6142578125},"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":244,"ty":5570}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 71.53125762939453 97.72189331054688 L 72.00000762939453 98.36875915527344 L 72.46875762939453 97.72189331054688 C 73.25000762939453 96.640625 74.50624084472656 96 75.84062194824219 96 C 78.13749694824219 96 80.00000762939453 97.86251831054688 80.00000762939453 100.1593933105469 L 80.00000762939453 100.2406311035156 C 80.00000762939453 103.7468795776367 75.62813568115234 107.8187561035156 73.34687042236328 109.5593872070312 C 72.95936584472656 109.8531188964844 72.48438262939453 110 72.00000762939453 110 C 71.51563262939453 110 71.03750610351562 109.8562622070312 70.65312194824219 109.5593872070312 C 68.37187194824219 107.8187561035156 64 103.7468795776367 64 100.2406311035156 L 64 100.1593933105469 C 64 97.86251831054688 65.86251068115234 96 68.15937042236328 96 C 69.49375152587891 96 70.75000762939453 96.640625 71.53125762939453 97.72189331054688 Z"}},{"type":"text","name":"El desfibrilador externo automático (DEA) es un dispositivo portátil que analiza el ritmo cardíaco y determina si es necesario aplicar una descarga eléctrica. Su uso durante un paro cardiorrespiratorio complementa la reanimación cardiopulmonar (RCP), pero ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":6176}}},"id":"8ead8edf-2e40-4e0e-aaaa-9e3feede4453","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-5524},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":127,"x":0}],[{"y":39,"from":127,"to":251,"x":0}],[{"y":63,"from":251,"to":307,"x":0}]]}],"rawText":"El desfibrilador externo automático (DEA) es un dispositivo portátil que analiza el ritmo cardíaco y determina si es necesario aplicar una descarga eléctrica. Su uso durante un paro cardiorrespiratorio complementa la reanimación cardiopulmonar (RCP), pero no reemplaza las compresiones ni las ventilaciones."}},{"type":"text","name":"El uso oportuno del DEA, combinado con una RCP de calidad, fortalece la respuesta ante un paro cardiorrespiratorio. Mantener la calma, seguir las instrucciones del dispositivo y continuar las maniobras contribuye a brindar una atención inicial segura mient","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":7213}}},"id":"afdc804e-df4b-4568-b044-07f1407e7251","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4208,"ty":-4487},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":146,"x":0}],[{"y":39,"from":146,"to":292,"x":0}]]},{"lines":[[{"y":63,"from":293,"to":293,"x":0}]]},{"lines":[[{"y":87,"from":294,"to":447,"x":0}],[{"y":111,"from":447,"to":604,"x":0}],[{"y":135,"from":604,"to":624,"x":0}]]}],"rawText":"El uso oportuno del DEA, combinado con una RCP de calidad, fortalece la respuesta ante un paro cardiorrespiratorio. Mantener la calma, seguir las instrucciones del dispositivo y continuar las maniobras contribuye a brindar una atención inicial segura mientras llega el personal especializado.\n\nDespués de reconocer las acciones de soporte vital básico, es necesario abordar otras situaciones que también pueden afectar la salud y la integridad de lactantes, niñas y niños. En el siguiente apartado, se presentan las medidas de atención inicial ante lesiones, traumatismos y situaciones que requieren una movilización segura."}},{"type":"text","name":"Mientras una persona realiza la RCP, otra debe activar el sistema de emergencias mediante la línea 123 y buscar el DEA. Para utilizarlo de manera organizada y segura, se deben seguir estas acciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":6423}}},"id":"12e30724-cf94-448d-b9ea-eb0aa11a7924","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-5277},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":170,"x":0}],[{"y":39,"from":170,"to":198,"x":0}]]}],"rawText":"Mientras una persona realiza la RCP, otra debe activar el sistema de emergencias mediante la línea 123 y buscar el DEA. Para utilizarlo de manera organizada y segura, se deben seguir estas acciones:"}},{"type":"text","name":"Durante el uso del DEA, se deben tener en cuenta las siguientes precauciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":6926}}},"id":"34269954-2c6b-4552-b04f-8ebbb6262d7d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-4774},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":77,"x":0}]]}],"rawText":"Durante el uso del DEA, se deben tener en cuenta las siguientes precauciones:"}},{"type":"shape","name":"Trazado 1008637","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":6273}}},"id":"882e70d5-3448-4a92-a4f8-7f9a79f36f4b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-5427},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","col