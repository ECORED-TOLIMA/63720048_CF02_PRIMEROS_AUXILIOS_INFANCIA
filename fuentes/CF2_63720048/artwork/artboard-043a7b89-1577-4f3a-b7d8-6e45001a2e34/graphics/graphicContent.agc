,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":331.7109375,"ty":3501}}},"id":"8c3cf75a-80e7-4784-b770-428f3a5eca23","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4166,"ty":-8199},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold","size":16},"textAttributes":{"lineHeight":34,"paragraphAlign":"center"}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":2,"x":-9.1796875}]]}],"rawText":"10"}},{"type":"text","name":"La reanimación cardiopulmonar (RCP) en la población infantil se aplica cuando la niña o el niño no responde y no respira normalmente o solo jadea. Su finalidad es mantener temporalmente la circulación sanguínea y el aporte de oxígeno a los órganos vitales ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":498,"ty":2608}}},"id":"4ea78f11-f2f8-4315-840e-e864e7c7edcd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3999.7109375,"ty":-9092},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":121,"x":0}],[{"y":39,"from":121,"to":240,"x":0}],[{"y":63,"from":240,"to":297,"x":0}]]}],"rawText":"La reanimación cardiopulmonar (RCP) en la población infantil se aplica cuando la niña o el niño no responde y no respira normalmente o solo jadea. Su finalidad es mantener temporalmente la circulación sanguínea y el aporte de oxígeno a los órganos vitales mientras llega la atención especializada."}},{"type":"text","name":"La obstrucción de la vía aérea por cuerpo extraño (OVACE) es una emergencia que ocurre cuando un alimento u objeto bloquea de manera parcial o total el paso del aire hacia los pulmones. En lactantes, niñas y niños, esta situación puede evolucionar rápidame","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":498,"ty":3960.9130859375}}},"id":"254f1a32-c3c6-4f80-aedd-a64c65eeca29","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3999.7109375,"ty":-7739.0869140625},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":123,"x":0}],[{"y":39,"from":123,"to":248,"x":0}],[{"y":63,"from":248,"to":355,"x":0}]]},{"lines":[[{"y":87,"from":356,"to":356,"x":0}]]},{"lines":[[{"y":111,"from":357,"to":476,"x":0}],[{"y":135,"from":476,"to":598,"x":0}],[{"y":159,"from":598,"to":668,"x":0}]]}],"rawText":"La obstrucción de la vía aérea por cuerpo extraño (OVACE) es una emergencia que ocurre cuando un alimento u objeto bloquea de manera parcial o total el paso del aire hacia los pulmones. En lactantes, niñas y niños, esta situación puede evolucionar rápidamente; por ello, es fundamental reconocer las señales de alerta y actuar de manera oportuna y segura.\n\nLa obstrucción puede presentarse mientras se consumen alimentos o cuando se introducen objetos pequeños en la boca. El riesgo aumenta con alimentos duros, redondos o difíciles de masticar, así como con monedas, botones, piezas de juguetes y otros elementos que se encuentran al alcance de la población infantil."}},{"type":"text","name":"Reconocer el tipo de obstrucción permite seleccionar la actuación adecuada. No se deben introducir los dedos en la boca ni intentar retirar el objeto cuando no sea visible, ya que podría desplazarse hacia una zona más profunda.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":4484}}},"id":"ab882ffe-e0bd-4bd9-a29b-2e90cf1504bf","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4311.7109375,"ty":-7216},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":173,"x":0}],[{"y":39,"from":173,"to":227,"x":0}]]}],"rawText":"Reconocer el tipo de obstrucción permite seleccionar la actuación adecuada. No se deben introducir los dedos en la boca ni intentar retirar el objeto cuando no sea visible, ya que podría desplazarse hacia una zona más profunda."}},{"type":"text","name":"Si el lactante está consciente y presenta una obstrucción total, se deben aplicar las siguientes acciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":4649}}},"id":"9f5d6329-928b-45c1-abb2-a5fbeac3ebb5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4311.7109375,"ty":-7051},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":106,"x":0}]]}],"rawText":"Si el lactante está consciente y presenta una obstrucción total, se deben aplicar las siguientes acciones:"}},{"type":"text","name":"Si la niña o el niño está consciente y no puede respirar, hablar, llorar o toser eficazmente, se deben aplicar estas acciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":5337}}},"id":"19c5d9d3-9f38-4e55-826c-3834a890a493","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4311.7109375,"ty":-6363},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":126,"x":0}]]}],"rawText":"Si la niña o el niño está consciente y no puede respirar, hablar, llorar o toser eficazmente, se deben aplicar estas acciones:"}},{"type":"text","name":"Las maniobras deben ajustarse al tamaño y a las condiciones físicas de la niña o del niño, evitando aplicar una fuerza desproporcionada.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":5765}}},"id":"0789f392-e96b-459f-b4da-edf19a1f698b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4311.7109375,"ty":-5935},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":136,"x":0}]]}],"rawText":"Las maniobras deben ajustarse al tamaño y a las condiciones físicas de la niña o del niño, evitando aplicar una fuerza desproporcionada."}},{"type":"text","name":"No se deben realizar compresiones abdominales en lactantes, debido al riesgo de causar lesiones en los órganos internos.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":5188}}},"id":"21ca23d0-8bd6-42d3-bf5b-6bdaf3c77484","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4311.7109375,"ty":-6512},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":120,"x":0}]]}],"rawText":"No se deben realizar compresiones abdominales en lactantes, debido al riesgo de causar lesiones en los órganos internos."}},{"type":"text","name":"Las manifestaciones dependen de si el paso del aire está bloqueado de forma parcial o total:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":4234}}},"id":"ee5fe894-3d05-40ff-9ffb-3ed61bc26f84","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4311.7109375,"ty":-7466},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":92,"x":0}]]}],"rawText":"Las manifestaciones dependen de si el paso del aire está bloqueado de forma parcial o total:"}},{"type":"text","name":"Para realizar el procedimiento de manera organizada, se deben aplicar las siguientes acciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":2905}}},"id":"01286a05-8f05-4b7e-97a4-09815af04ce3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4311.7109375,"ty":-8795},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":94,"x":0}]]}],"rawText":"Para realizar el procedimiento de manera organizada, se deben aplicar las siguientes acciones:"}},{"type":"shape","name":"Trazado 1003446","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":498,"ty":2705}}},"id":"21e7c5a5-f173-4d78-8603-985a8d62043c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3999.7109375,"ty":-8995},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 916.2890625 0 L 916.2890625 170 L 0 170 L 0 0 Z"}},{"type":"shape","name":"Rectángulo 456434","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":498.2890625,"ty":2705}}},"id":"3ec7f232-7b96-4a38-b87f-d181d8ae16b9","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3999.421875,"ty":-8995},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":25,"height":8}},{"type":"text","name":"Este procedimiento se realiza en niñas y niños desde un año hasta la aparición de signos de pubertad. Cuando estos signos están presentes, se aplican las técnicas de RCP correspondientes a las personas adultas.\nAntes de iniciar las maniobras, se debe verif","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":524,"ty":2730}}},"id":"7d15388f-7804-4453-a55f-2a5d8f6b5c1b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-3973.7109375,"ty":-8970},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":842},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":115,"x":0}],[{"y":39,"from":115,"to":210,"x":0}]]},{"lines":[[{"y":63,"from":211,"to":333,"x":0}],[{"y":87,"from":333,"to":445,"x":0}],[{"y":111,"from":445,"to":516,"x":0}]]}],"rawText":"Este procedimiento se realiza en niñas y niños desde un año hasta la aparición de signos de pubertad. Cuando estos signos están presentes, se aplican las técnicas de RCP correspondientes a las personas adultas.\nAntes de iniciar las maniobras, se debe verificar la seguridad del entorno y valorar la respuesta y la respiración. Si la niña o el niño no responde y no respira normalmente, se debe solicitar ayuda, activar el sistema de emergencias mediante la línea 123 e iniciar la RCP, según la capacitación recibida."}},{"type":"group","name":"Grupo 1181772","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":7,"ty":39}}},"id":"e78575f8-6d20-4114-9992-2dc952e8ded5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4490.7109375,"ty":-11661},"group":{"children":[{"type":"shape","name":"Rectángulo 456463","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true}},"id":"fbcfd814-91d3-412f-a6cb-8615baefbb66","transform":{"a":1,"b":0,"c":0,"d":1,"tx":621.7109375,"ty":436},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":84,"height":84,"r":[10,10,10,10]}},{"type":"group","name":"Grupo 1181771","meta":{"ux":{"nameL10N":"SHAPE_GROUP"}},"id":"74e46bf8-5e3f-406f-a5fd-aede22053ebf","transform":{"a":1,"b":0,"c":0,"d":1,"tx":619.27001953125,"ty":442.25},"group":{"children":[{"type":"group","name":"Grupo 1181769","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"0cdaf006-5747-4c50-b277-289581504c0f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":23.36868667602539,"ty":9.611543655395508},"group":{"children":[{"type":"shape","name":"Trazado 1003621","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true}},"id":"d67ca085-ba58-449e-b22a-d4cdb3b85a41","transform":{"a":1,"b":0,"c":0,"