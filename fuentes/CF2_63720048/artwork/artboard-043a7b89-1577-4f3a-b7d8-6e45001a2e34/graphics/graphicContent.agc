:221,"x":0}],[{"y":63,"from":221,"to":337,"x":0}]]}],"rawText":"En lactantes, niñas y niños, el DEA debe utilizarse tan pronto como esté disponible. Para menores de ocho años, se emplean preferiblemente parches pediátricos o un sistema reductor de energía. Si estos elementos no están disponibles, puede utilizarse un DEA con parches para personas adultas, siguiendo las instrucciones del dispositivo."}},{"type":"group","name":"Enmascarar grupo 1119290","meta":{"ux":{"nameL10N":"SHAPE_MASK","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"clipPathResources":{"children":[{"type":"shape","name":"Rectángulo 457113","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE"}},"id":"a9358273-ceb0-43b9-ad62-4b1e400d24b1","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1120.6298828125,"ty":5487},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":142,"g":197,"b":252}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":292,"height":217,"r":[10,10,10,10]}}],"type":"clipPath"},"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1.0810546875,"ty":689}}},"id":"f2fc692f-808a-4945-a24a-e73aec9312cf","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4496.6298828125,"ty":-11011},"group":{"children":[{"type":"shape","name":"Imagen 126","meta":{"ux":{"nameL10N":"SHAPE_IMAGE","aspectLock":{"width":500,"height":346}}},"id":"5bcc8958-429d-49ff-a8ff-7c9166cdd335","transform":{"a":1,"b":0,"c":0,"d":1,"tx":1049.6298828125,"ty":5455},"style":{"fill":{"type":"pattern","pattern":{"width":500,"height":346,"meta":{"ux":{"scaleBehavior":"fill","uid":"d2b7b0873fd54f08a0422758c3b06996","hrefLastModifiedDate":0}},"href":""}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":366,"height":254}}]}},{"type":"group","name":"Grupo 1178700","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"