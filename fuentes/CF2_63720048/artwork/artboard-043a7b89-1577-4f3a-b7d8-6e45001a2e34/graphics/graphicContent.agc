":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Black","family":"Roboto","style":"Black","size":30},"textAttributes":{"lineHeight":35}},"text":{"frame":{"type":"autoHeight","width":18},"paragraphs":[{"lines":[[{"y":29,"from":0,"to":1,"x":0}]]}],"rawText":"3"}},{"type":"shape","name":"Trazado 873459","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":270}}},"id":"81ef86ca-03e1-4140-ae00-f03a9a0062e2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4311.7109375,"ty":-11430},"style":{"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":218,"b":218}},"width":3}},"shape":{"type":"path","path":"M 0 0 L 1228 1.13671875"}},{"type":"text","name":"La aplicación correcta y oportuna de estas técnicas contribuye a mantener o recuperar la respiración y la circulación, mientras llega la atención especializada. Por esta razón, deben realizarse de manera segura y de acuerdo con la edad y las condiciones de","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":856}}},"id":"ec188314-6bfd-4221-9256-038741d18710","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-10844},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":170,"x":0}],[{"y":39,"from":170,"to":276,"x":0}]]},{"lines":[[{"y":63,"from":277,"to":277,"x":0}]]},{"lines":[[{"y":87,"from":278,"to":440,"x":0}],[{"y":111,"from":440,"to":523,"x":0}]]}],"rawText":"La aplicación correcta y oportuna de estas técnicas contribuye a mantener o recuperar la respiración y la circulación, mientras llega la atención especializada. Por esta razón, deben realizarse de manera segura y de acuerdo con la edad y las condiciones de la niña o del niño.\n\nA continuación, se explica la reanimación cardiopulmonar y su aplicación según la edad de la niña o del niño, teniendo en cuenta sus características anatómicas y fisiológicas, así como las condiciones de seguridad necesarias durante la atención."}},{"type":"text","name":"La aplicación ordenada de estas acciones contribuye a mantener la circulación y el aporte de oxígeno durante una emergencia. Las maniobras deben realizarse con precaución, sin ejercer una fuerza excesiva y conforme a los protocolos vigentes y la capacitaci","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":2227}}},"id":"e3f778db-ce99-483a-b124-116b4242ea86","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4208,"ty":-9473},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1124},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":145,"x":0}],[{"y":39,"from":145,"to":268,"x":0}]]},{"lines":[[{"y":63,"from":269,"to":269,"x":0}]]},{"lines":[[{"y":87,"from":270,"to":424,"x":0}],[{"y":111,"from":424,"to":571,"x":0}],[{"y":135,"from":571,"to":584,"x":0}]]}],"rawText":"La aplicación ordenada de estas acciones contribuye a mantener la circulación y el aporte de oxígeno durante una emergencia. Las maniobras deben realizarse con precaución, sin ejercer una fuerza excesiva y conforme a los protocolos vigentes y la capacitación recibida.\n\nDespués de reconocer la técnica de RCP en lactantes, es necesario comprender cómo se adapta este procedimiento a la población infantil. En niñas y niños, la valoración, la profundidad de las compresiones y la técnica empleada deben ajustarse a su edad, tamaño y condiciones físicas, como se explica a continuación."}},{"type":"text","name":"La atención inicial se basa en la valoración de la niña o del niño y en la aplicación de técnicas específicas, de acuerdo con la emergencia identificada:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":627}}},"id":"4be3c2ae-c93a-4742-8889-c5d14f89fc76","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4312,"ty":-11073},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":153,"x":0}]]}],"rawText":"La atención inicial se basa en la valoración de la niña o del niño y en la aplicación de técnicas específicas, de acuerdo con la emergencia identificada:"}},{"type":"group","name":"Grupo 1177788","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":-39}}},"id":"a406095a-cd01-429d-82a1-230bd67ce5eb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-4497.7109375,"ty":-11739},"group":{"children":[{"type":"group","name":"hr-before-h2","id":"a3963a82-57c1-488d-9d68-a9638f3136a3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":390.37109375,"ty":1066},"meta":{"ux":{"hasCustomName":true,"hasNameFromExternalSource":true,"constraintWidth":true,"constraintHeight":true}},"group":{"children":[{"type":"shape","name":"Rectángulo 5131","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintBottom":true}},"id":"51b19720-1c3d-4b50-bf1a-23f413c7a624","transform":{"a":1,"b":0,"c":0,"d":1,"tx":0.0009765625,"ty":0},"style":{"fill":{"type":"gradient","gradient":{"meta":{"ux":{"gradientResources":{"type":"radial","stops":[{"offset":0,"color":{"mode":"RGB","value":{"r":0,"g":0,"b":0},"alpha":0.10196078431372549}},{"offset":1,"color":{"mode":"RGB","value":{"r":255,"g":255,"b":255},"alpha":0}}]}}},"cx":0.49362418055534363,"cy":-0.04402780905365944,"fx":0.49362418055534363,"fy":-0.04402780905365944,"r":18.318904876708984,"units":"objectBoundingBox","transform":{"a":0.02616666629910469,"b":0,"c":0,"d":0.05914570763707161,"tx":0.3155771791934967,"ty":-0.0414215587079525}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"rect","x":0,"y":0,"width":819.9990234375,"height":15.699999809265137}}]}},{"type":"shape","name":"Rectángulo 454975","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintTop":true,"constraintHeight":true}},"id":"942eb8c2-19e6-4ed7-b168-fe057b548c62","transform":{"a":1,"