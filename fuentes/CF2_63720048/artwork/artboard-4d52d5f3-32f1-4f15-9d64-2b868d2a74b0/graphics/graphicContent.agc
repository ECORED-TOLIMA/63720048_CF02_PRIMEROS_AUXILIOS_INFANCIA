from":0,"to":113,"x":0}],[{"y":39,"from":113,"to":218,"x":0}],[{"y":63,"from":218,"to":327,"x":0}]]}],"rawText":"La respuesta de una niña o un niño ante la voz, el contacto y otros estímulos permite reconocer posibles cambios en su estado general. Esta observación debe compararse con su comportamiento habitual, debido a que cada persona puede reaccionar de manera diferente según su edad, condición de salud y circunstancias de la lesión."}},{"type":"text","name":"Para dar continuidad a la evaluación inicial, se deben observar los movimientos del tórax y el abdomen, así como la frecuencia y el ritmo respiratorios. También es importante identificar sonidos anormales o señales de esfuerzo al respirar. Estos aspectos p","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186.7109375,"ty":1439}}},"id":"711cf33a-bf86-4d00-bcc1-b9c195d3209b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7574,"ty":-10261},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1227},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":164,"x":0}],[{"y":39,"from":164,"to":324,"x":0}],[{"y":63,"from":324,"to":353,"x":0}]]}],"rawText":"Para dar continuidad a la evaluación inicial, se deben observar los movimientos del tórax y el abdomen, así como la frecuencia y el ritmo respiratorios. También es importante identificar sonidos anormales o señales de esfuerzo al respirar. Estos aspectos permiten reconocer posibles alteraciones y orientar adecuadamente la valoración de la respiración."}},{"type":"shape","name":"Rectángulo 456415","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":534}}},"id":"de24a085-bf2f-459e-bbc2-30b80f8be215","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-11166},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":812,"height":120,"r":[10,10,10,10]}},{"type":"text","name":"Para llevar a cabo esta valoración de forma rápida y organizada, se utiliza la escala AVPU. Esta herramienta clasifica el nivel de conciencia de acuerdo con cuatro tipos de respuesta: alerta, respuesta verbal, respuesta al dolor y ausencia de respuesta.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":221.7109375,"ty":561}}},"id":"05cb2b8c-0900-4baa-a42a-8c2044f406d5","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7539,"ty":-11139},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":741},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":97,"x":0}],[{"y":39,"from":97,"to":202,"x":0}],[{"y":63,"from":202,"to":253,"x":0}]]}],"rawText":"Para llevar a cabo esta valoración de forma rápida y organizada, se utiliza la escala AVPU. Esta herramienta clasifica el nivel de conciencia de acuerdo con cuatro tipos de respuesta: alerta, respuesta verbal, respuesta al dolor y ausencia de respuesta."}},{"type":"text","name":"Una vez valorado el nivel de conciencia, es necesario comprobar cómo respira la niña o el niño. Esta observación permite reconocer si el aire ingresa y sale adecuadamente, así como detectar cambios que puedan afectar la oxigenación. Debido a las caracterís","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.7109375,"ty":1748}}},"id":"875c23ff-a330-4ce9-94da-2a230114c6dd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7159,"ty":-9952},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":113,"x":0}],[{"y":39,"from":113,"to":220,"x":0}],[{"y":63,"from":220,"to":337,"x":0}],[{"y":87,"from":337,"to":373,"x":0}]]}],"rawText":"Una vez valorado el nivel de conciencia, es necesario comprobar cómo respira la niña o el niño. Esta observación permite reconocer si el aire ingresa y sale adecuadamente, así como detectar cambios que puedan afectar la oxigenación. Debido a las características propias de la primera infancia, cualquier alteración respiratoria requiere una valoración cuidadosa y oportuna."}},{"type":"text","name":"Las características respiratorias pueden modificarse en poco tiempo; por ello, la observación debe mantenerse durante toda la atención inicial. Si la respiración es ausente, irregular o se realiza con un esfuerzo evidente, se debe solicitar ayuda especiali","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":3609}}},"id":"bd44fd43-4a02-42b8-b023-815313f39aae","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-8091},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":174,"x":0}],[{"y":39,"from":174,"to":320,"x":0}]]}],"rawText":"Las características respiratorias pueden modificarse en poco tiempo; por ello, la observación debe mantenerse durante toda la atención inicial. Si la respiración es ausente, irregular o se realiza con un esfuerzo evidente, se debe solicitar ayuda especializada y actuar únicamente de acuerdo con la preparación recibida."}},{"type":"text","name":"Durante una emergencia, la observación del pulso ayuda a reconocer cómo se encuentra la actividad cardíaca y la circulación sanguínea. En la primera infancia, esta valoración debe realizarse con precisión, porque la frecuencia cardíaca suele ser mayor y cu","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":4026}}},"id":"72d34785-e67f-452e-bd35-ff5b8c52493d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-7674},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":164,"x":0}],[{"y":39,"from":164,"to":305,"x":0}]]},{"lines":[[{"y":63,"from":306,"to":306,"x":0}]]},{"lines":[[{"y":87,"from":307,"to":403,"x":0}]]}],"rawText":"Durante una emergencia, la observación del pulso ayuda a reconocer cómo se encuentra la actividad cardíaca y la circulación sanguínea. En la primera infancia, esta valoración debe realizarse con precisión, porque la frecuencia cardíaca suele ser mayor y cualquier alteración puede evolucionar rápidamente.\n\nPara realizar esta valoración de manera organizada, se recomienda seguir la siguiente secuencia:"}},{"type":"text","name":"De acuerdo con la información presentada, las características del pulso deben interpretarse junto con la respiración, el nivel de conciencia, la coloración y la temperatura de la piel. Esta valoración integral permite reconocer oportunamente un posible com","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":5317}}},"id":"5fb72798-40c0-45c2-bf58-ac182d565fcf","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-6383},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":176,"x":0}],[{"y":39,"from":176,"to":325,"x":0}]]}],"rawText":"De acuerdo con la información presentada, las características del pulso deben interpretarse junto con la respiración, el nivel de conciencia, la coloración y la temperatura de la piel. Esta valoración integral permite reconocer oportunamente un posible compromiso circulatorio y determinar la necesidad de atención inmediata."}},{"type":"text","name":"El estado de una niña o un niño puede cambiar rápidamente ante una lesión o alteración de la salud. Por esta razón, es necesario observar su respiración, nivel de conciencia, coloración de la piel, comportamiento y respuesta a los estímulos. Estos elemento","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":5742}}},"id":"fdff99f4-7108-47c4-929c-96d4d703f938","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-5958},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":163,"x":0}],[{"y":39,"from":163,"to":330,"x":0}],[{"y":63,"from":330,"to":358,"x":0}]]},{"lines":[[{"y":87,"from":359,"to":359,"x":0}]]},{"lines":[[{"y":111,"from":360,"to":469,"x":0}]]}],"rawText":"El estado de una niña o un niño puede cambiar rápidamente ante una lesión o alteración de la salud. Por esta razón, es necesario observar su respiración, nivel de conciencia, coloración de la piel, comportamiento y respuesta a los estímulos. Estos elementos permiten reconocer la gravedad de la situación y establecer prioridades durante la atención inicial.\n\nSegún las manifestaciones observadas y la respuesta requerida, los signos pueden organizarse en tres niveles:"}},{"type":"text","name":"Esta secuencia facilita la identificación de posibles alteraciones circulatorias y orienta la necesidad de solicitar atención especializada. Un pulso débil, irregular o ausente puede estar acompañado de otros signos de deterioro que requieren una actuación","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":497.7109375,"ty":4559}}},"id":"fb00a67d-cd53-4cd4-8432-edd2c5c4e976","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7263,"ty":-7141},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":126,"x":0}],[{"y":39,"from":126,"to":247,"x":0}],[{"y":63,"from":247,"to":267,"x":0}]]}],"rawText":"Esta secuencia facilita la identificación de posibles alteraciones circulatorias y orienta la necesidad de solicitar atención especializada. Un pulso débil, irregular o ausente puede estar acompañado de otros signos de deterioro que requieren una actuación inmediata."}},{"type":"text","name":"Una vez comprobada la presencia del pulso, se deben observar sus características y relacionarlas con el estado general de la niña o el niño. La siguiente tabla sintetiza los principales hallazgos, su posible interpretación y la atención inicial correspondi","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.7109375,"ty":4656}}},"id":"b2134d85-030c-4dc7-822d-da6bf9a51171","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7159,"ty":-7044},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":111,"x":0}],[{"y":39,"from":111,"to":228,"x":0}],[{"y":63,"from":228,"to":261,"x":0}]]}],"rawText":"Una vez comprobada la presencia del pulso, se deben observar sus características y relacionarlas con el estado general de la niña o el niño. La siguiente tabla sintetiza los principales hallazgos, su posible interpretación y la atención inicial correspondiente."}},{"type":"text","name":"Esta clasificación orienta la observación y ayuda a reconocer cuándo se requiere seguimiento, valoración o atención inmediata. Los signos deben interpretarse de manera conjunta, ya que el estado general puede cambiar rápidamente y exigir la activación del ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":6521}}},"id":"b59ce9d9-fb2b-4269-970e-481971c9b993","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-5179},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":127,"x":0}],[{"y":39,"from":127,"to":252,"x":0}],[{"y":63,"from":252,"to":280,"x":0}]]}],"rawText":"Esta clasificación orienta la observación y ayuda a reconocer cuándo se requiere seguimiento, valoración o atención inmediata. Los signos deben interpretarse de manera conjunta, ya que el estado general puede cambiar rápidamente y exigir la activación del servicio de emergencias."}},{"type":"text","name":"La comparación de los patrones observados facilita la toma de decisiones durante la atención inicial. La siguiente tabla presenta los principales tipos de respiración, sus características y las acciones generales que deben considerarse.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":2987}}},"id":"9decd4ff-c0cc-4d56-8578-68f6a53ff7d6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-8713},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":121,"x":0}],[{"y":39,"from":121,"to":236,"x":0}]]}],"rawText":"La comparación de los patrones observados facilita la toma de decisiones durante la atención inicial. La siguiente tabla presenta los principales tipos de respiración, sus características y las acciones generales que deben considerarse."}},{"type":"text","name":"La valoración conjunta de estos aspectos permite reconocer cómo se realiza la respiración y facilita la identificación de cambios relevantes. No debe interpretarse una característica de manera aislada, pues la edad, el llanto, la fiebre, la actividad físic","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":2740}}},"id":"c1421cf1-cfc0-43b7-9741-4b61cf27e586","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-8960},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":130,"x":0}],[{"y":39,"from":130,"to":263,"x":0}],[{"y":63,"from":263,"to":334,"x":0}]]}],"rawText":"La valoración conjunta de estos aspectos permite reconocer cómo se realiza la respiración y facilita la identificación de cambios relevantes. No debe interpretarse una característica de manera aislada, pues la edad, el llanto, la fiebre, la actividad física y el estado emocional pueden modificar temporalmente el patrón respiratorio."}},{"type":"text","name":"La somnolencia inusual, la desorientación o la ausencia de respuesta pueden indicar un deterioro que requiere atención inmediata. Por ello, también es necesario observar la respiración, la coloración de la piel y la capacidad para interactuar, seguir indic","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":413}}},"id":"360bdd52-569c-4e55-8e41-e2d0489f26c6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7471,"ty":-11287},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":708},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":97,"x":0}],[{"y":39,"from":97,"to":189,"x":0}],[{"y":63,"from":189,"to":287,"x":0}],[{"y":87,"from":287,"to":298,"x":0}]]}],"rawText":"La somnolencia inusual, la desorientación o la ausencia de respuesta pueden indicar un deterioro que requiere atención inmediata. Por ello, también es necesario observar la respiración, la coloración de la piel y la capacidad para interactuar, seguir indicaciones o realizar movimientos habituales."}},{"type":"text","name":"A continuación, la siguiente figura presenta los cuatro niveles que conforman la escala AVPU y las respuestas asociadas a cada uno.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":684}}},"id":"071aa9e0-e92e-4154-b483-bdc089e5cbcf","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-11016},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":131,"x":0}]]}],"rawText":"A continuación, la siguiente figura presenta los cuatro niveles que conforman la escala AVPU y las respuestas asociadas a cada uno."}},{"type":"shape","name":"Rectángulo 456445","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":2837}}},"id":"e00c1611-e83f-412b-aa02-39ee2d12c465","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-8863},"style":{