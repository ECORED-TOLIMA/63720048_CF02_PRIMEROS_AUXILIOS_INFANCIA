:"Bold"}}}]]},{"lines":[[{"y":159,"from":231,"to":254,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":159,"from":254,"to":312}],[{"y":183,"from":312,"to":342,"x":0}]]},{"lines":[[{"y":207,"from":343,"to":343,"x":0}]]},{"lines":[[{"y":231,"from":344,"to":373,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":231,"from":373,"to":430}],[{"y":255,"from":430,"to":496,"x":0}]]},{"lines":[[{"y":279,"from":497,"to":497,"x":0}]]},{"lines":[[{"y":303,"from":498,"to":524,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":303,"from":524,"to":587}],[{"y":327,"from":587,"to":643,"x":0}]]}],"rawText":"Localizar la arteria: ubicar la arteria braquial en lactantes o la arteria carótida en niñas y niños mayores. \n\nPalpar suavemente: colocar las yemas de los dedos índice y medio sobre la arteria, sin ejercer una presión excesiva. \n\nComprobar la presencia: verificar si el pulso se percibe con claridad durante un tiempo máximo de 10 segundos. \n\nObservar sus características: identificar la frecuencia, el ritmo y la intensidad del pulso, teniendo en cuenta el estado general de la niña o el niño. \n\nRelacionar los hallazgos: valorar el pulso junto con la respiración, la coloración de la piel, el nivel de conciencia y otros signos observados. "}},{"type":"shape","name":"Rectángulo 457070","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":319.7109375,"ty":4173}}},"id":"18d8e88d-ca08-46f9-ad27-7a1071e6bfa6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7441,"ty":-7527},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 457071","met