"to":230,"x":0}],[{"y":63,"from":230,"to":315,"x":0}]]}],"rawText":"En la primera infancia, las alteraciones respiratorias pueden presentarse de distintas formas según su causa y evolución. Por ello, no basta con comprobar que existe respiración; también se deben analizar sus características para determinar si la ventilación parece adecuada o si requiere una intervención oportuna."}},{"type":"shape","name":"Trazado 1003451","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":3684}}},"id":"19a31491-5cfa-4e8b-8a3e-1b0b6981c3a6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7471,"ty":-8016},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 1020 0 L 1020 100 L 0 100 L 0 0 Z"}},{"type":"shape","name":"Trazado 1003453","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":6618}}},"id":"3164c715-2e17-4819-9d55-bb23d8735c8c","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7575,"ty":-5082},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 916.2890625 0 L 916.2890625 120 L 0 120 L 0 0 Z"}},{"type":"shape","name":"Rectángulo 456447","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":290,"ty":3684}}},"id":"cf00b936-909e-46f9-9f8f-f353a5a45085","transform":{"a":1,"b":0,"c":0,"d":1,"tx":-7470.7109375,"ty":-8016},"style":{"fill":{"type":"solid","color":{"mo