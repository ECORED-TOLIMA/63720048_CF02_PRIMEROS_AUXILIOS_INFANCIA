.3701171875,"ty":-3480.578125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1227.9189453125},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":174,"x":0}],[{"y":39,"from":174,"to":303,"x":0}]]}],"rawText":"La protección de la vida y la salud de la niña o del niño siempre es prioritaria. Si para brindar los primeros auxilios es indispensable ingresar al lugar, mover un objeto o modificar alguna condición del entorno, se debe realizar únicamente la acción necesaria e informar posteriormente a la autoridad."}},{"type":"text","name":"Para proteger el lugar y apoyar la intervención de las autoridades, se deben aplicar las siguientes acciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186.0810546875,"ty":8391.578125}}},"id":"880ce7c8-16c8-4916-9674-622ff8fabe65","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.3701171875,"ty":-3308.421875},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1227.9189453125},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":109,"x":0}]]}],"rawText":"Para proteger el lugar y apoyar la intervención de las autoridades, se deben aplicar las siguientes acciones:"}},{"type":"shape","name":"T