,"singleTextObject":true,"rangedStyles":[{"length":42,"linkId":"","fontFamily":"Roboto","fontStyle":"Black","postscriptName":"Roboto-Black","fontSize":24,"charSpacing":0,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}]}},"id":"c891fe2a-32b1-4263-98b0-c9180d8907bc","transform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":1164.5},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Black","family":"Roboto","style":"Black","size":24},"textAttributes":{"lineHeight":30}},"text":{"frame":{"type":"positioned"},"paragraphs":[{"lines":[[{"y":0,"from":0,"to":22,"x":0}]]}],"rawText":"6.3 Cadena de custodia"}},{"type":"group","name":"Grupo 1177787","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true}},"id":"269ce04f-432b-4e67-854e-30d5aa60d032","transform":{"a":1,"b":0,"c":0,"d":1,"tx":9,"ty":498.5},"group":{"children":[{"type":"shape","name":"Línea 107","meta":{"ux":{"nameL10N":"SHAPE_LINE"}},"id":"263020c7-aa0d-48b4-aabb-828c9efedfea","transform":{"a":1,"b":0,"c":0,"d":1,"tx":177,"ty":697},"style":{"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":218,"b":218}},"width":3}},"shape":{"type":"line","x1":0,"y1":0,"x2":137,"y2":0}},{"type":"shape","name":"Línea 108","meta":{"ux":{"nameL10N":"SHAPE_LINE"}},"id":"8296f4d1-6bba-43e9-a471-3071a83748c3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":177,"ty":697},"style":{"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}},"width":3}},"shape":{"type":"line","x1":0,"y1":0,"x2":46,"y2":0}}]}}]}},{"type":"text","name":"La articulación con el sistema de emergencias integra la solicitud de ayuda, la comunicación precisa, la vigilancia y la entrega responsable de la información. Cuando el evento también puede tener implicaciones legales, se deben proteger el lugar, los elem","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":628.9189453125,"ty":7479.921875}}},"id":"eebd6628-9cd7-45eb-be4d-1e7d76b51e90","transform":{"a":1,"b":0,"c":0,"d":1,"tx":5196.2080078125,"ty":-4220.078125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":758.416015625},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":105,"x":0}],[{"y":39,"from":105,"to":197,"x":0}],[{"y":63,"from":197,"to":303,"x":0}],[{"y":87,"from":303,"to":361,"x":0}]]}],"rawText":"La articulación con el sistema de emergencias integra la solicitud de ayuda, la comunicación precisa, la vigilancia y la entrega responsable de la información. Cuando el evento también puede tener implicaciones legales, se deben proteger el lugar, los elementos relacionados y la intimidad de la niña o del niño, aspectos que se abordan en el siguiente numeral."}},{"type":"text","name":"La articulación con el sistema de emergencias permite solicitar ayuda especializada y garantizar la continuidad de la atención cuando una situación supera la capacidad de actuación del primer respondiente. Este proceso requiere identificar la necesidad de ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":4666}}},"id":"5e01318c-b520-41ec-8ca4-57644c8538dd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-7034},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812.0810546875},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":112,"x":0}],[{"y":39,"from":112,"to":219,"x":0}],[{"y":63,"from":219,"to":319,"x":0}],[{"y":87,"from":319,"to":388,"x":0}]]},{"lines":[[{"y":111,"from":389,"to":389,"x":0}]]},{"lines":[[{"y":135,"from":390,"to":494,"x":0}],[{"y":159,"from":494,"to":602,"x":0}],[{"y":183,"from":602,"to":664,"x":0}]]}],"rawText":"La articulación con el sistema de emergencias permite solicitar ayuda especializada y garantizar la continuidad de la atención cuando una situación supera la capacidad de actuación del primer respondiente. Este proceso requiere identificar la necesidad de apoyo, comunicarse oportunamente con la línea de emergencias y proporcionar información clara sobre el estado de la niña o del niño.\n\nEn Colombia, la activación debe realizarse mediante la línea de emergencias 123. Durante la llamada, es importante mantener la calma, responder las preguntas del operador y seguir las indicaciones recibidas, sin interrumpir la comunicación hasta que se autorice finalizarla."}},{"type":"text","name":"El cumplimiento ordenado de estas acciones facilita la comprensión del evento y permite que los organismos de respuesta determinen los recursos necesarios. La información suministrada debe ser concreta, verificable y limitada a los hechos observados.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":5473}}},"id":"43fd0b0a-99e3-4adc-8398-77f102e8f479","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-6227},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":159,"x":0}],[{"y":39,"from":159,"to":250,"x":0}]]}],"rawText":"El cumplimiento ordenado de estas acciones facilita la comprensión del evento y permite que los organismos de respuesta determinen los recursos necesarios. La información suministrada debe ser concreta, verificable y limitada a los hechos observados."}},{"type":"text","name":"Durante la llamada, se deben proporcionar los datos esenciales para orientar la respuesta:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":5646}}},"id":"3b41827f-c234-40a9-97a0-ba3a498b3142","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-6054},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":90,"x":0}]]}],"rawText":"Durante la llamada, se deben proporcionar los datos esenciales para orientar la respuesta:"}},{"type":"text","name":"Para realizar una activación organizada y facilitar la respuesta del personal especializado, se deben considerar las siguientes acciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":4973}}},"id":"749231bd-4bdf-4e42-8a1d-5311a1ae9c6f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-6727},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":137,"x":0}]]}],"rawText":"Para realizar una activación organizada y facilitar la respuesta del personal especializado, se deben considerar las siguientes acciones:"}},{"type":"text","name":"Estos datos permiten que el operador comprenda la situación y proporcione instrucciones apropiadas. Si alguna información se desconoce, debe indicarse con claridad, sin realizar suposiciones ni emitir diagnósticos.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":6072}}},"id":"02ba78ea-cb79-4882-b1f5-66189e1c56f7","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-5628},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":169,"x":0}],[{"y":39,"from":169,"to":214,"x":0}]]}],"rawText":"Estos datos permiten que el operador comprenda la situación y proporcione instrucciones apropiadas. Si alguna información se desconoce, debe indicarse con claridad, sin realizar suposiciones ni emitir diagnósticos."}},{"type":"text","name":"La vigilancia continua permite reconocer cambios que puedan requerir nuevas acciones. En todo momento, se debe conservar la calma, proteger a la niña o al niño y evitar procedimientos que no hayan sido indicados por personal capacitado.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":6786}}},"id":"0f00cca7-d5b4-4f8f-8c8c-653044ea3cad","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-4914},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":169,"x":0}],[{"y":39,"from":169,"to":236,"x":0}]]}],"rawText":"La vigilancia continua permite reconocer cambios que puedan requerir nuevas acciones. En todo momento, se debe conservar la calma, proteger a la niña o al niño y evitar procedimientos que no hayan sido indicados por personal capacitado."}},{"type":"text","name":"Cuando llegue el equipo de emergencias, se debe realizar una entrega clara y ordenada de la información. Para ello, se debe comunicar:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":6969}}},"id":"41fddabd-2bdf-4d5f-bf60-38e215b817e0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-4731},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":134,"x":0}]]}],"rawText":"Cuando llegue el equipo de emergencias, se debe realizar una entrega clara y ordenada de la información. Para ello, se debe comunicar:"}},{"type":"text","name":"La atención no termina después de realizar la llamada. Mientras llega el personal especializado, el primer respondiente debe continuar con las siguientes acciones:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":6460}}},"id":"a9eb8c1d-d087-4f23-a7ba-66a9512b8fe0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-5240},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":163,"x":0}]]}],"rawText":"La atención no termina después de realizar la llamada. Mientras llega el personal especializado, el primer respondiente debe continuar con las siguientes acciones:"}},{"type":"shape","name":"Trazado 1003447","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.7109375,"ty":3749}}},"id":"e1a170a9-88e9-461e-a52f-45354b575745","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4857,"ty":-7951},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 0 0 L 1020.2890625 0 L 1020.2890625 160 L 0 160 L 0 0 Z"}},{"type":"text","name":"Para fortalecer la comprensión de estos contenidos, se presenta un recurso de audio sobre el acompañamiento emocional del niño o la niña durante una emergencia. En este se explica en qué consisten los primeros auxilios psicológicos, la importancia de la ca","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":444.9189453125,"ty":3784}}},"id":"e49e6464-5bdb-4ce4-b2da-5bcbe11cb956","transform":{"a":1,"b":0,"c":0,"d":1,"tx":5012.2080078125,"ty":-7916},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":836},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":108,"x":0}],[{"y":39,"from":108,"to":219,"x":0}],[{"y":63,"from":219,"to":329,"x":0}],[{"y":87,"from":329,"to":411,"x":0}]]}],"rawText":"Para fortalecer la comprensión de estos contenidos, se presenta un recurso de audio sobre el acompañamiento emocional del niño o la niña durante una emergencia. En este se explica en qué consisten los primeros auxilios psicológicos, la importancia de la calma y la palabra como herramienta del primer respondiente, y la forma de acompañar al menor sin generar más angustia mientras llega la ayuda especializada."}},{"type":"shape","name":"Rectángulo 456543","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":289.9189453125,"ty":6509}}},"id":"ced1cc41-2a1c-4afa-873c-7f30a7ae1187","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4857.2080078125,"ty":-5191},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":221,"g":238,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":1020,"height":247}},{"type":"text","name":"Mantener la vigilancia sobre la respiración, el estado de conciencia y la condición general. \nAplicar las indicaciones proporcionadas por el operador de emergencias. \nEvitar movilizar a la niña o al niño, salvo que permanezca expuesto a un peligro inmediat","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":334.9189453125,"ty":6537}}},"id":"7da0d0cd-3114-4ca2-b639-313653348242","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4902.2080078125,"ty":-5163},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":34.5}},"text":{"frame":{"type":"autoHeight","width":663},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":93,"x":0}]]},{"lines":[[{"y":49.5,"from":94,"to":166,"x":0}]]},{"lines":[[{"y":84,"from":167,"to":259,"x":0}]]},{"lines":[[{"y":118.5,"from":260,"to":310,"x":0}]]},{"lines":[[{"y":153,"from":311,"to":385,"x":0}]]},{"lines":[[{"y":187.5,"from":386,"to":463,"x":0}]]}],"rawText":"Mantener la vigilancia sobre la respiración, el estado de conciencia y la condición general. \nAplicar las indicaciones proporcionadas por el operador de emergencias. \nEvitar movilizar a la niña o al niño, salvo que permanezca expuesto a un peligro inmediato. \nMantener despejado y seguro el lugar de atención. \nInformar cualquier cambio significativo mediante la línea de emergencias. \nPreparar la información necesaria para entregarla al personal especializado. "}},{"type":"shape","name":"heart-solid-full","id":"39250524-d24f-4f63-91e9-da8ea67145c2","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4810.4970703125,"ty":-5258},"meta":{"ux":{"hasCustomName":true,"hasNameFromExternalSource":true,"aspectLock":{"width":125.2734375,"height":109.6142578125},"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":243.2080078125,"ty":6442}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1}},"shape":{"type":"path","path":"M 71.53125762939453 97.72189331054688 L 72.00000762939453 98.36875915527344 L 72.46875762939453 97.72189331054688 C 73.25000762939453 96.640625 74.50624084472656 96 75.84062194824219 96 C 78.13749694824219 96 80.00000762939453 97.86251831054688 80.00000762939453 100.1593933105469 L 80.00000762939453 100.2406311035156 C 80.00000762939453 103.7468795776367 75.62813568115234 107.8187561035156 73.34687042236328 109.5593872070312 C 72.95936584472656 109.8531188964844 72.48438262939453 110 72.00000762939453 110 C 71.51563262939453 110 71.03750610351562 109.8562622070312 70.65312194824219 109.5593872070312 C 68.37187194824219 107.8187561035156 64 103.7468795776367 64 100.2406311035156 L 64 100.1593933105469 C 64 97.86251831054688 65.86251068115234 96 68.15937042236328 96 C 69.49375152587891 96 70.75000762939453 96.640625 71.53125762939453 97.72189331054688 Z"}},{"type":"shape","name":"heart-solid-full","id":"1b48db84-cde5-4a02-8535-1c4a15b5ac69","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4810.4970703125,"ty":-5224},"meta":{"ux":{"hasCustomName":true,"hasNameFromExternalSource":true,"aspectLock":{"width":125.2734375,"height":109.6142578125},"constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":243.2080078125,"ty":6476}}},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r"