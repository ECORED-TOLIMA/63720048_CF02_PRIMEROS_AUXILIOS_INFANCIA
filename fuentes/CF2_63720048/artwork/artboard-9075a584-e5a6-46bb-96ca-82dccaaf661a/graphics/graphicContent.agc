8c5aff6887","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4785.2080078125,"ty":-3741},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":852},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":111,"x":0}],[{"y":39,"from":111,"to":225,"x":0}],[{"y":63,"from":225,"to":345,"x":0}],[{"y":87,"from":345,"to":409,"x":0}]]}],"rawText":"La cadena de custodia es un procedimiento técnico que permite identificar, conservar, trasladar y entregar los elementos materiales probatorios y la evidencia física. Su aplicación corresponde a las autoridades y al personal legalmente facultado. Por tanto, el primer respondiente debe brindar la atención inicial, proteger el lugar y comunicar objetivamente lo observado, sin asumir funciones investigativas."}},{"type":"text","name":"Estas acciones permiten apoyar la protección de la escena sin asumir procedimientos propios de las autoridades. El primer respondiente no debe recolectar, embalar, rotular ni trasladar posibles evidencias, salvo que reciba una instrucción expresa de la aut","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":8962}}},"id":"fa51cfa1-7d8a-4ead-b8aa-eba39b7bc27a","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-2738},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":164,"x":0}],[{"y":39,"from":164,"to":274,"x":0}]]}],"rawText":"Estas acciones permiten apoyar la protección de la escena sin asumir procedimientos propios de las autoridades. El primer respondiente no debe recolectar, embalar, rotular ni trasladar posibles evidencias, salvo que reciba una instrucción expresa de la autoridad competente."}},{"type":"shape","name":"Trazado 2377","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":291.095703125,"ty":9532}}},"id":"4888d90f-3b60-4799-81f1-37ec713f3ade","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4858.384765625,"ty":-2168},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":184,"g":244,"b":206}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"path","path":"M 10.06822490692139 0 L 1008.835998535156 0 C 1014.396545410156 0 1018.904296875 5.59644079208374 1018.904296875 12.5 L 1018.904296875 137.5 C 1018.904296875 144.4035491943359 1014.396545410156 150 1008.835998535156 150 L 10.06822490692139 150 C 4.507697105407715 150 -9.229105479846567e-09 144.4035491943359 -9.229105479846567e-09 137.5 L -9.229105479846567e-09 12.5 C -9.229105479846567e-09 5.59644079208374 4.507697105407715 0 10.06822490692139 0 Z"}},{"type":"group","name":"Grupo 1016970","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"constraintBottom":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":1145.4580078125,"ty":9585}}},"id":"8397be86-9f49-48e0-aea2-c168ee2eab86","transform":{"a":1,"b":0,"c":0,"d":1,"tx":5712.7470703125,"ty":-2115},"group":{"children":[{"type":"shape","name":"Trazado 243","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"cons