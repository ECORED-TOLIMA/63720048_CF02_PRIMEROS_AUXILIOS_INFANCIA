Height":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":9438}}},"id":"44c25ab6-5455-4949-8840-0563f0fc6729","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-2262},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":161,"x":0}],[{"y":39,"from":161,"to":327,"x":0}],[{"y":63,"from":327,"to":371,"x":0}]]}],"rawText":"La información debe compartirse únicamente con el personal de salud, los familiares o cuidadores responsables y las autoridades facultadas. No se deben divulgar nombres, imágenes ni detalles del evento mediante redes sociales u otros medios. Cuando existan indicios de violencia, maltrato o abuso, la situación debe informarse inmediatamente a las autoridades competentes"}},{"type":"text","name":"La protección de la escena, el registro objetivo y el manejo reservado de la información contribuyen a preservar los elementos relacionados con el evento y a garantizar los derechos de la niña o del niño. La actuación del primer respondiente debe centrarse","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.9189453125,"ty":9718}}},"id":"b6f1a10b-afc9-4ab1-80ed-586e0308f037","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2080078125,"ty":-1982},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":173,"x":0}],[{"y":39,"from":173,"to":347,"x":0}],[{"y":63,"from":347,"to":370,"x":0}]]},{"lines":[[{"y":87,"from":371,"to":371,"x":0}]]},{"lines":[[{"y":111,"from":372,"to":541,"x":0}],[{"y":135,"from":541,"to":690,"x":0}]]}],"rawText":"La protección de la escena, el registro objetivo y el manejo reservado de la información contribuyen a preservar los elementos relacionados con el evento y a garantizar los derechos de la niña o del niño. La actuación del primer respondiente debe centrarse en priorizar la vida, evitar alteraciones innecesarias y facilitar la intervención de las entidades responsables.\n\nAl finalizar este componente formativo, se reconoce que actuar ante una emergencia en la primera infancia requiere conocimientos, calma, responsabilidad y sensibilidad. Cada acción oportuna contribuye a proteger la vida, brindar un acompañamiento respetuoso y facilitar la atención especializada de la niña o del niño."}},{"type":"text","name":"El registro debe limitarse a hechos observables, sin incluir acusaciones, interpretaciones ni conclusiones personales. Si la niña o el niño expresa espontáneamente información sobre lo ocurrido, sus palabras deben registrarse con fidelidad, sin completar e","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"constraintBottom":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":637.9189453125,"ty":9293}}},"id":"90393367-fbd4-4e86-b2bf-56a337e2dc84","transform":{"a":1,"b":0,"c":0,"d":1,"tx":5205.2080078125,"ty":-2407},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":741},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":94,"x":0}],[{"y":39,"from":94,"to":195,"x":0}],[{"y":63,"from":195,"to":300,"x":0}],[{"y":87,"from":300,"to":311,"x":0}]]}],"rawText":"El registro debe limitarse a hechos observables, sin incluir acusaciones, interpretaciones ni conclusiones personales. Si la niña o el niño expresa espontáneamente información sobre lo ocurrido, sus palabras deben registrarse con fidelidad, sin completar el relato ni formular preguntas que sugieran respuestas."}},{"type":"group","name":"Grupo 1181774","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":0,"ty":0}}},"id":"dcb2b85a-b112-4079-b500-d3dba838abdb","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4567.2890625,"ty":-11700},"group":{"children":[{"type":"shape","name":"Rectángulo 456463","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true}},"id":"cd71412c-463c-490b-bd2a-843be63c6db8","transform":{"a":1,"b":0,"c":0,"d":1,"tx":215,"ty":470},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112