yle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":355.9189453125,"ty":5051}}},"id":"78a1aa43-8494-480f-8ec0-2034490c7cb3","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4923.2080078125,"ty":-6649},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":913},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":24,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":24,"to":114}]]},{"lines":[[{"y":39,"from":115,"to":115,"x":0}]]},{"lines":[[{"y":63,"from":116,"to":226,"x":0}]]},{"lines":[[{"y":87,"from":227,"to":227,"x":0}]]},{"lines":[[{"y":111,"from":228,"to":359,"x":0}]]},{"lines":[[{"y":135,"from":360,"to":360,"x":0}]]},{"lines":[[{"y":159,"from":361,"to":481,"x":0}]]},{"lines":[[{"y":183,"from":482,"to":482,"x":0}]]},{"lines":[[{"y":207,"from":483,"to":608,"x":0}]]},{"lines":[[{"y":231,"from":609,"to":609,"x":0}]]},{"lines":[[{"y":255,"from":610,"to":739,"x":0}]]},{"lines":[[{"y":279,"from":740,"to":740,"x":0}]]},{"lines":[[{"y":303,"from":741,"to":869,"x":0}]]},{"lines":[[{"y":327,"from":870,"to":870,"x":0}]]},{"lines":[[{"y":351,"from":871,"to":994,"x":0}]]}],"rawText":"Reconocer la emergencia: identificar los signos de alarma o las condiciones que requieren atención especializada. \n\nComunicarse con la línea 123: reportar con claridad la condición de la niña o del niño y su ubicación exacta. \n\nInformar la ubicación: indicar el municipio, el barrio, la dirección, un punto de referencia y las condiciones de acceso al lugar. \n\nDescribir lo ocurrido: explicar brevemente el evento, el número de personas afectadas y las manifestaciones observadas. \n\nComunicar las acciones realizadas: informar los primeros auxilios brindados y los cambios identificados durante la atención. \n\nSeguir las indicaciones: escuchar al operador y aplicar las orientaciones recibidas de acuerdo con las condiciones de seguridad. \n\nFacilitar el acceso: despejar el recorrido y, cuando sea posible, asignar a una persona para orientar al equipo de emergencias. \n\nEntregar la información: comunicar al personal especializado la evolución de la niña o del niño y las acciones realizadas. "}},{"type":"text","name":"Verificar la seguridad: identificar los riesgos para la niña, el niño y las demás personas presentes. \n\nActivar el sistema de emergencias: comunicarse con la línea de emergencias 123 para reportar con claridad la condición de la niña o del niño y su ubicac","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":23,"linkId":"","fontFamily":"Roboto","fontStyle":"Bold","postscriptName":"Roboto-Bold","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""},{"length":989,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":355.9189453125,"ty":8469}}},"id":"05280203-ba4b-40b5-a783-f835670414e4","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4923.2080078125,"ty":-3231},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":913},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":23,"x":0,"style":{"font":{"postscriptName":"Roboto-Bold","family":"Roboto","style":"Bold"}}},{"y":15,"from":23,"to":102}]]},{"lines":[[{"y":39,"from":103,"to":103,"x":0}]]},{"lines":[[{"y":63,"from":104,"to":229,"x":0}],[{"y":87,"from":229,"to":268,"x":0}]]},{"lines":[[{"y":111,"from":269,"to":269,"x":0}]]},{"lines":[[{"y":135,"from":270,"to":360,"x":0}]]},{"lines":[[{"y":159,"from":361,"to":361,"x":0}]]},{"lines":[[{"y":183,"from":362,"to":473,"x":0}]]},{"lines":[[{"y":207,"from":474,"to":474,"x":0}]]},{"lines":[[{"y":231,"from":475,"to":591,"x":0}]]},{"lines":[[{"y":255,"from":592,"to":592,"x":0}]]},{"lines":[[{"y":279,"from":593,"to":724,"x":0}],[{"y":303,"from":724,"to":755,"x":0}]]},{"lines":[[{"y":327,"from":756,"to":756,"x":0}]]},{"lines":[[{"y":351,"from":757,"to":861,"x":0}]]},{"lines":[[{"y":375,"from":862,"to":862,"x":0}]]},{"lines":[[{"y":399,"from":863,"to":980,"x":0}],[{"y":423,"from":980,"to":1012,"x":0}]]}],"rawText":"Verificar la seguridad: identificar los riesgos para la niña, el niño y las demás personas presentes. \n\nActivar el sistema de emergencias: comunicarse con la línea de emergencias 123 para reportar con claridad la condición de la niña o del niño y su ubicación exacta. \n\nRestringir el acceso: evitar, cuando sea seguro, el ingreso de personas ajenas al evento. \n\nConservar el lugar: procurar que los objetos permanezcan en la posición y el estado en que fueron encontrados. \n\nEvitar manipulaciones: no mover, limpiar, recoger, lavar, desechar ni trasladar objetos relacionados con el evento. \n\nRegistrar los hechos: anotar la fecha, la hora aproximada, el lugar, las condiciones observadas, los primeros auxilios brindados y las modificaciones realizadas. \n\nProteger la intimidad: impedir la toma o divulgación de fotografías, videos, audios y datos personales. \n\nEntregar la información: comunicar al personal especializado las actuaciones realizadas y los cambios indispensables efectuados durante la atención. "}},{"type":"shape","name":"Rectángulo 457080","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":320.9189453125,"ty":5046}}},"id":"9eb730ae-3447-44ac-bbae-29c38da0e503","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4888.2080078125,"ty":-6654},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 457276","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":320.9189453125,"ty":8464}}},"id":"14cd8565-1052-40e7-8719-cc4b7a390e55","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4888.2080078125,"ty":-3236},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 457081","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":320.9189453125,"ty":5093}}},"id":"2a43a69c-b87c-4449-9952-ee2d75d4d70f","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4888.2080078125,"ty":-6607},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":255,"g":192,"b":172}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":24,"height":24}},{"type":"shape","name":"Rectángulo 457277","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":320.9189453125,"ty":8514}}},"id":"9fb2df0b-5e3c-44de-a019-e9b4a1351c