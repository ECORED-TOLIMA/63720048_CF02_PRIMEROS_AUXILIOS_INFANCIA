:{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Black","family":"Roboto","style":"Black","size":30},"textAttributes":{"lineHeight":35}},"text":{"frame":{"type":"autoHeight","width":18},"paragraphs":[{"lines":[[{"y":29,"from":0,"to":1,"x":0}]]}],"rawText":"6"}},{"type":"shape","name":"Trazado 873459","meta":{"ux":{"nameL10N":"SHAPE_PATH","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":270}}},"id":"2b7b1bf2-be1e-4a86-a1c9-39ab9f213ffd","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-11430},"style":{"stroke":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":218,"b":218}},"width":3}},"shape":{"type":"path","path":"M 0 0 L 1228 1.13671875"}},{"type":"text","name":"La atención inicial de una emergencia en la primera infancia también requiere acompañar emocionalmente a la niña o al niño, comunicar la situación con claridad y coordinar oportunamente la intervención de los servicios especializados. Estas acciones favore","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186.7109375,"ty":316}}},"id":"a390f1d6-5cea-4d1f-bcf2-ef1a4260f4f0","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4754,"ty":-11384},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":915.2890625},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":124,"x":0}],[{"y":39,"from":124,"to":250,"x":0}],[{"y":63,"from":250,"to":365,"x":0}],[{"y":87,"from":365,"to":391,"x":0}]]}],"rawText":"La atención inicial de una emergencia en la primera infancia también requiere acompañar emocionalmente a la niña o al niño, comunicar la situación con claridad y coordinar oportunamente la intervención de los servicios especializados. Estas acciones favorecen una respuesta organizada y permiten mantener informados a los familiares, cuidadores y profesionales que participan en la atención."}},{"type":"shape","name":"Rectángulo 456415","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":185.7109375,"ty":437}}},"id":"3ffdffd5-ac06-4e11-b7b2-936c90be2026","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753,"ty":-11263},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":244,"g":237,"b":254}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},"shape":{"type":"rect","x":0,"y":0,"width":916.2890625,"height":150,"r":[10,10,10,10]}},{"type":"text","name":"Cuando el evento puede tener implicaciones legales, también es necesario proteger la escena, evitar la manipulación de objetos y registrar únicamente la información observada. Estas actuaciones deben realizarse sin retrasar los primeros auxilios, debido a ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":324,"ty":467}}},"id":"a4f889b3-6649-4287-8b34-b5a15d36763d","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4891.2890625,"ty":-11233},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":756},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":103,"x":0}],[{"y":39,"from":103,"to":200,"x":0}],[{"y":63,"from":200,"to":310,"x":0}],[{"y":87,"from":310,"to":343,"x":0}]]}],"rawText":"Cuando el evento puede tener implicaciones legales, también es necesario proteger la escena, evitar la manipulación de objetos y registrar únicamente la información observada. Estas actuaciones deben realizarse sin retrasar los primeros auxilios, debido a que la protección de la vida y la salud de la persona afectada constituye la prioridad."}},{"type":"text","name":"Para comprender la relación entre estas acciones, se deben considerar los siguientes aspectos:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":617}}},"id":"8b7aeca9-c62e-4a9c-8b4f-1a6a8f9a4751","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-11083},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":94,"x":0}]]}],"rawText":"Para comprender la relación entre estas acciones, se deben considerar los siguientes aspectos:"}},{"type":"text","name":"La entrega de esta información favorece la continuidad del cuidado y evita la pérdida de datos importantes. Una vez que el personal especializado asuma la atención, se deben seguir sus indicaciones y evitar interferir en los procedimientos.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.7109375,"ty":7362.5}}},"id":"caef5eba-3d05-47a8-b96e-38bd14453ed6","transform":{"a":1,"b":0,"c":0,"d":1,"tx":5169,"ty":-4337.5},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":112,"x":0}],[{"y":39,"from":112,"to":225,"x":0}],[{"y":63,"from":225,"to":240,"x":0}]]}],"rawText":"La entrega de esta información favorece la continuidad del cuidado y evita la pérdida de datos importantes. Una vez que el personal especializado asuma la atención, se deben seguir sus indicaciones y evitar interferir en los procedimientos."}},{"type":"text","name":"El acompañamiento emocional oportuno contribuye a reducir el impacto de la emergencia en la niña o el niño y facilita la atención física necesaria. Sin embargo, esta contención no reemplaza la atención especializada; por ello, a continuación, se presenta l","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":4357}}},"id":"316ff9d5-fbd3-4b96-b40b-f1fc1ec9b92b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-7343},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":166,"x":0}],[{"y":39,"from":166,"to":337,"x":0}],[{"y":63,"from":337,"to":361,"x":0}]]}],"rawText":"El acompañamiento emocional oportuno contribuye a reducir el impacto de la emergencia en la niña o el niño y facilita la atención física necesaria. Sin embargo, esta contención no reemplaza la atención especializada; por ello, a continuación, se presenta la articulación con el sistema de emergencias y su importancia para garantizar la continuidad del cuidado."}},{"type":"text","name":"El desarrollo articulado de estos aspectos fortalece la actuación del primer respondiente. No obstante, cada acción debe aplicarse de acuerdo con las características del evento, el estado de la niña o del niño y las indicaciones de las autoridades competen","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintWidth":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":498,"ty":1230}}},"id":"9d83a6a2-980d-4f06-b585-9ed042b0d6da","transform":{"a":1,"b":0,"c":0,"d":1,"tx":5065.2890625,"ty":-10470},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":121,"x":0}],[{"y":39,"from":121,"to":248,"x":0}],[{"y":63,"from":248,"to":260,"x":0}]]}],"rawText":"El desarrollo articulado de estos aspectos fortalece la actuación del primer respondiente. No obstante, cada acción debe aplicarse de acuerdo con las características del evento, el estado de la niña o del niño y las indicaciones de las autoridades competentes."}},{"type":"text","name":"Una emergencia puede generar miedo, llanto, confusión, silencio o dificultad para seguir indicaciones. Los primeros auxilios psicológicos comprenden acciones inmediatas de apoyo que buscan brindar seguridad, disminuir la angustia y favorecer una respuesta ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":1793}}},"id":"6e13d18c-3dad-4cbb-a0f6-85525d100aac","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-9907},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":812},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":107,"x":0}],[{"y":39,"from":107,"to":208,"x":0}],[{"y":63,"from":208,"to":313,"x":0}]]},{"lines":[[{"y":87,"from":314,"to":314,"x":0}]]},{"lines":[[{"y":111,"from":315,"to":433,"x":0}],[{"y":135,"from":433,"to":535,"x":0}],[{"y":159,"from":535,"to":598,"x":0}]]},{"lines":[[{"y":183,"from":599,"to":599,"x":0}]]},{"lines":[[{"y":207,"from":600,"to":675,"x":0}]]}],"rawText":"Una emergencia puede generar miedo, llanto, confusión, silencio o dificultad para seguir indicaciones. Los primeros auxilios psicológicos comprenden acciones inmediatas de apoyo que buscan brindar seguridad, disminuir la angustia y favorecer una respuesta emocional más estable mientras se desarrolla la atención.\n\nLa reacción puede variar según la edad, el desarrollo, las experiencias previas y las características del evento. Por esta razón, se debe observar el comportamiento, respetar las manifestaciones emocionales y adaptar la comunicación a la capacidad de comprensión de cada niña o niño.\n\nEl acompañamiento inicial debe orientarse mediante las siguientes acciones:"}},{"type":"text","name":"Estas acciones permiten establecer un entorno de confianza durante la atención. No se deben hacer promesas que no puedan cumplirse, exigir que la persona relate el evento ni utilizar expresiones que aumenten su preocupación.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":2544}}},"id":"0d9cba41-f058-43d2-b1fd-52794577fb95","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-9156},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":164,"x":0}],[{"y":39,"from":164,"to":224,"x":0}]]}],"rawText":"Estas acciones permiten establecer un entorno de confianza durante la atención. No se deben hacer promesas que no puedan cumplirse, exigir que la persona relate el evento ni utilizar expresiones que aumenten su preocupación."}},{"type":"text","name":"La comunicación debe adaptarse a la edad, el estado emocional y la capacidad de respuesta. Para facilitar la comprensión, se recomienda:","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":2727}}},"id":"3dade59c-2905-48de-b260-06aa7855f474","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-8973},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":136,"x":0}]]}],"rawText":"La comunicación debe adaptarse a la edad, el estado emocional y la capacidad de respuesta. Para facilitar la comprensión, se recomienda:"}},{"type":"text","name":"La comunicación no verbal también transmite seguridad. La postura corporal, la expresión facial, el contacto visual respetuoso y la distancia adecuada deben ser coherentes con el mensaje expresado.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintWidth":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":3121}}},"id":"9b986c95-55fa-4e7d-a6ea-ea93a95ff46b","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-8579},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":916},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":129,"x":0}],[{"y":39,"from":129,"to":197,"x":0}]]}],"rawText":"La comunicación no verbal también transmite seguridad. La postura corporal, la expresión facial, el contacto visual respetuoso y la distancia adecuada deben ser coherentes con el mensaje expresado."}},{"type":"text","name":"Los familiares o cuidadores deben recibir información objetiva sobre el estado observado, las acciones realizadas y la ayuda solicitada. La comunicación debe evitar diagnósticos, afirmaciones sin confirmar o señalamientos sobre posibles responsabilidades. ","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":3294}}},"id":"e4218cf0-be65-4abd-856c-500e90fd7492","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-8406},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":165,"x":0}],[{"y":39,"from":165,"to":321,"x":0}]]}],"rawText":"Los familiares o cuidadores deben recibir información objetiva sobre el estado observado, las acciones realizadas y la ayuda solicitada. La comunicación debe evitar diagnósticos, afirmaciones sin confirmar o señalamientos sobre posibles responsabilidades. Para mantener una comunicación clara y respetuosa, es importante:"}},{"type":"text","name":"Una comunicación respetuosa ayuda a disminuir la incertidumbre y facilita la participación de la familia o del cuidador en la continuidad de la atención.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":3706}}},"id":"74cae539-bf5b-41e9-8162-9e3379e680b1","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-7994},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":153,"x":0}]]}],"rawText":"Una comunicación respetuosa ayuda a disminuir la incertidumbre y facilita la participación de la familia o del cuidador en la continuidad de la atención."}},{"type":"text","name":"A continuación, se aborda el acompañamiento emocional durante una emergencia y la comunicación con la persona afectada, sus familiares y cuidadores.","meta":{"ux":{"nameL10N":"SHAPE_GROUP","constraintLeft":true,"constraintRight":true,"constraintTop":true,"constraintHeight":true,"singleTextObject":true,"rangedStyles":[{"length":1094,"linkId":"","fontFamily":"Roboto","fontStyle":"Regular","postscriptName":"Roboto-Regular","fontSize":16,"charSpacing":2.5,"underline":false,"textTransform":"none","textScript":"none","fill":{"value":4279379519},"strikethrough":false,"hyperlinkUrl":""}],"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":186,"ty":1532}}},"id":"c1daae54-e1ad-4b0f-bc6c-e8137496907e","transform":{"a":1,"b":0,"c":0,"d":1,"tx":4753.2890625,"ty":-10168},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":18,"g":38,"b":63}}},"font":{"postscriptName":"Roboto-Regular","family":"Roboto","style":"Regular","size":16},"textAttributes":{"letterSpacing":2.5,"lineHeight":24}},"text":{"frame":{"type":"autoHeight","width":1228},"paragraphs":[{"lines":[[{"y":15,"from":0,"to":148,"x":0}]]}],"rawText":"A continuación, se aborda el acompañamiento emocional durante una emergencia y la comunicación con la persona afectada, sus familiares y cuidadores."}},{"type":"shape","name":"Rectángulo 456551","meta":{"ux":{"nameL10N":"SHAPE_RECTANGLE","constraintWidth":true,"constraintRight":true,"constraintHeight":true,"localTransform":{"a":1,"b":0,"c":0,"d":1,"tx":601.9189453125,"ty":7459.921875}}},"id":"84064f6e-92a5-4933-a8ee-e8503014fc32","transform":{"a":1,"b":0,"c":0,"d":1,"tx":5169.2080078125,"ty":-4240.078125},"style":{"fill":{"type":"solid","color":{"mode":"RGB","value":{"r":219,"g":194,"b":250}}},"stroke":{"type":"none","color":{"mode":"RGB","value":{"r":112,"g":112,"b":112}},"width":1,"align":"inside"}},